<%# Passkey sign-in, generated by `soli generate auth --passkeys`. Render it
    on the sign-in page with partial("passkeys/sign_in"), and give the email
    field autocomplete="username webauthn" so the browser also offers
    passkeys in its autofill (conditional UI). %>
<div data-passkey-login data-csrf-token="<%= csrf_token() %>" class="mt-4">
  <button type="button" data-passkey-login-button
          class="w-full rounded-md border border-slate-700 hover:border-indigo-500 px-4 py-2 font-medium text-white transition-colors">
    Sign in with a passkey
  </button>
  <p data-passkey-error class="hidden mt-2 text-sm text-red-300"></p>
</div>
<script src="/js/passkeys.js" defer></script>
