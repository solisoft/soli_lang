# PasskeyCredential — one passkey (WebAuthn credential) a user registered.
# Generated by `soli generate auth --passkeys`. Collection: passkey_credentials
#
# The verification itself is the native `WebAuthn` class; this file holds what
# it deliberately leaves to the app: where the relying party lives, and the
# single-use challenge that ties a browser response to the options this server
# issued for it.

# --- Passkey tuning ----------------------------------------------------------
# How long a ceremony may take between the options call and the response.
const WEBAUTHN_CHALLENGE_TTL = 300
# The one session slot that holds the pending challenge. A second ceremony
# started in another tab replaces it, so the first one fails closed.
const WEBAUTHN_CHALLENGE_KEY = "webauthn_challenge"

# The relying-party id: the registrable domain passkeys are scoped to. Set
# WEBAUTHN_RP_ID to share passkeys across subdomains (`example.com` covers
# `app.example.com`); by default it is the host of APP_BASE_URL.
def webauthn_rp_id
  configured = getenv("WEBAUTHN_RP_ID").to_s.trim
  return configured if configured.present?

  auth_base_url().split("://").last.split("/").first.split(":").first
end

# The exact origins a ceremony may come from — scheme, host and port, no
# wildcards. WEBAUTHN_ORIGINS takes a comma-separated list; by default it is
# APP_BASE_URL alone.
def webauthn_origins
  configured = getenv("WEBAUTHN_ORIGINS").to_s
  if configured.present?
    return configured.split(",").map { |origin| origin.trim }.filter { |origin| origin.present? }
  end

  # Scheme + host + port: an origin never has a path or a trailing slash.
  [auth_base_url().split("/").take(3).join("/")]
end

# Keep `challenge` for the next ceremony of this session. `purpose` is
# "register" or "login", so a challenge issued for one cannot answer the other.
def webauthn_store_challenge(purpose, challenge)
  session_set(WEBAUTHN_CHALLENGE_KEY, {
    "challenge": challenge,
    "purpose": purpose,
    "expires_at": DateTime.utc.to_unix + WEBAUTHN_CHALLENGE_TTL
  })
end

# The pending challenge for `purpose`, or nil when there is none, it was
# issued for the other ceremony, or it expired. It is deleted before anything
# is checked: a challenge answers exactly one response, so a replayed response
# or a second attempt needs fresh options.
def webauthn_take_challenge(purpose)
  stored = session_get(WEBAUTHN_CHALLENGE_KEY)
  session_delete(WEBAUTHN_CHALLENGE_KEY)
  return nil if stored.nil?
  return nil unless stored["purpose"] == purpose
  return nil if stored["expires_at"].to_i < DateTime.utc.to_unix

  stored["challenge"]
end

class PasskeyCredential < Model
  # Fields: user_id, credential_id, public_key (COSE, base64url), algorithm,
  # sign_count, transports, aaguid, backed_up, name, last_used_at.
  validates("user_id", {"presence": true})
  validates("credential_id", {"presence": true, "uniqueness": true})
  validates("public_key", {"presence": true})

  # Every passkey `user` registered, oldest first.
  static def for_user(user)
    PasskeyCredential.where({"user_id": user._key}).order("created_at", "asc").all
  end

  # What `WebAuthn.verify_authentication` needs to know about this passkey.
  def expected(challenge)
    {
      "challenge": challenge,
      "origins": webauthn_origins(),
      "rp_id": webauthn_rp_id(),
      "public_key": @public_key,
      "sign_count": @sign_count.to_i,
      "credential_id": @credential_id
    }
  end

  # Record a successful sign-in.
  def touch_used(sign_count)
    @sign_count = sign_count
    @last_used_at = DateTime.utc.to_iso
    @save
  end
end
