# Passkey sessions controller — sign in with a passkey.
# Generated by `soli generate auth --passkeys`.
#
# Discoverable credentials: the options name no credential, so the browser
# offers every passkey it holds for this site (and fills the conditional-UI
# email field). The response says which credential answered; its stored public
# key verifies the signature, and the user handle must name the same account.
#
# It opens the session exactly as the password login does: the same per-IP
# throttle, the same locked and confirmed gates, a new session id, and the
# session version a password reset bumps. Every failure gets the same answer,
# so the endpoint tells an attacker nothing about which credentials exist.

class PasskeySessionsController < Controller
  # POST /passkeys/login/options — request options for navigator.credentials.get()
  def request_options
    result = WebAuthn.authentication_options({"rp_id": webauthn_rp_id()})
    webauthn_store_challenge("login", result["challenge"])
    render_json(result["options"])
  end

  # POST /passkeys/login
  def create
    limiter = rate_limiter_from_ip(req, AUTH_ATTEMPTS_PER_IP, AUTH_IP_WINDOW_SECONDS)
    return render_json({"error": "Too many sign-in attempts. Try again in a few minutes."}, 429) unless limiter.allowed

    challenge = webauthn_take_challenge("login")
    return @_reject if challenge.nil?

    credential = req["json"] || {}
    passkey = PasskeyCredential.find_by("credential_id", credential["id"].to_s)
    return @_reject if passkey.nil?

    result = WebAuthn.verify_authentication(credential, passkey.expected(challenge)) rescue nil
    return @_reject if result.nil?
    # A counter that did not move forward can mean a cloned authenticator.
    # Synced passkeys keep it at 0, which is not flagged.
    return @_reject if result["counter_regressed"]

    user = User.find_by("_key", passkey.user_id)
    return @_reject if user.nil? || user.locked?
    # Nothing named the user before this ceremony, so the user handle is
    # mandatory (WebAuthn L3 §7.2 step 6) and must name the passkey's owner.
    return @_reject unless result["user_handle"] == user._key

    if auth_require_confirmed_email() && !user.confirmed?
      return render_json({"error": "Please confirm your email address first — check your inbox."}, 403)
    end

    passkey.touch_used(result["sign_count"])
    user.clear_failed_attempts
    # New session id after a successful login defeats session fixation. The
    # challenge was consumed above, before this regenerates the session.
    session_regenerate()
    session_set("user_id", user._key)
    # Stamped so a later password reset can invalidate this session.
    session_set("session_version", user.current_session_version)
    render_json({"redirect": "/"})
  end

  private

  # The one failure answer: unknown credential, bad signature, expired
  # challenge and locked account all look the same.
  def _reject
    render_json({"error": "Passkey sign-in failed."}, 401)
  end
end
