# Passkeys controller — the signed-in user's passkeys: list, add, remove.
# Generated by `soli generate auth --passkeys`.
#
# Adding a passkey is two requests from public/js/passkeys.js: `options`
# issues a challenge (kept in the session, single use), the browser asks the
# authenticator to create a credential, and `create` verifies the response
# with `WebAuthn.verify_registration` before storing it.

class PasskeysController < Controller
  static {
    this.layout = "application"
  }

  # GET /passkeys
  def index
    user = current_user()
    return redirect("/login") if user.nil?

    render("passkeys/index", {"title": "Passkeys", "passkeys": PasskeyCredential.for_user(user)})
  end

  # POST /passkeys/options — creation options for navigator.credentials.create()
  def creation_options
    user = current_user()
    return render_json({"error": "Sign in first"}, 401) if user.nil?

    result = WebAuthn.registration_options({
      "rp_id": webauthn_rp_id(),
      "rp_name": getenv("WEBAUTHN_RP_NAME").to_s.present? ? getenv("WEBAUTHN_RP_NAME") : webauthn_rp_id(),
      "user_id": user._key,
      "user_name": user.email,
      "display_name": user.email,
      "exclude_credentials": PasskeyCredential.for_user(user).map { |passkey| {"id": passkey.credential_id, "transports": passkey.transports} }
    })
    webauthn_store_challenge("register", result["challenge"])
    render_json(result["options"])
  end

  # POST /passkeys — verify the new credential and store it
  def create
    user = current_user()
    return render_json({"error": "Sign in first"}, 401) if user.nil?

    challenge = webauthn_take_challenge("register")
    return render_json({"error": "The passkey request expired. Try again."}, 422) if challenge.nil?

    body = req["json"] || {}
    expected = {"challenge": challenge, "origins": webauthn_origins(), "rp_id": webauthn_rp_id()}
    record = WebAuthn.verify_registration(body["credential"] || {}, expected) rescue nil
    return render_json({"error": "The passkey could not be verified."}, 422) if record.nil?

    passkey = PasskeyCredential.create({
      "user_id": user._key,
      "credential_id": record["credential_id"],
      "public_key": record["public_key"],
      "algorithm": record["algorithm"],
      "sign_count": record["sign_count"],
      "transports": record["transports"],
      "aaguid": record["aaguid"],
      "backed_up": record["backed_up"],
      "name": body["name"].to_s.trim.present? ? body["name"].to_s.trim : "Passkey"
    })
    return render_json({"error": "This passkey is already registered."}, 422) if passkey._errors

    render_json({"id": passkey._key, "name": passkey.name}, 201)
  end

  # DELETE /passkeys/:id
  def destroy
    user = current_user()
    return redirect("/login") if user.nil?

    passkey = PasskeyCredential.find_by("_key", params["id"])
    # Someone else's passkey answers exactly like a missing one.
    passkey.delete if !passkey.nil? && passkey.user_id == user._key
    redirect("/passkeys")
  end
end
