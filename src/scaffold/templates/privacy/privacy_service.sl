# Personal data — export and erasure of what the app holds about a user.
# Generated by `soli generate privacy`.
#
# This file is the app's register of personal data: every model that holds
# some is listed here with how it relates to a user and what an erasure does
# to it. A model that is not listed is neither exported nor erased, so add
# yours when you add the model.
#
#   "Comment": {"owner": "author_id", "erase": "delete"}
#   "Order":   {"owner": "user_id", "erase": "anonymize", "fields": ["address", "phone"]}
#   "Invoice": {"owner": "user_id", "erase": "keep"}
#
#   owner    the field holding the user's key
#   erase    "delete" the records; "anonymize" them (set `fields` to nil);
#            "keep" them as they are — what the law makes you retain
#   fields   what "anonymize" blanks
#   omit     fields left out of an export (secrets, internals)
#   export   false to leave the model out of exports
#
# Erasing works in bulk (`update_all`, `delete_all`): callbacks do not run, on
# purpose — an audited model would otherwise copy the values being erased
# into its audit log. So attachments of erased records are not purged, and
# `dependent:` cascades do not fire: list the dependent models here too.

const PRIVACY_MODELS = {}

# What the generators of `soli generate auth`, `oauth`, `saml`… store about a
# user. Each applies only when the app has the model.
const PRIVACY_SCAFFOLD_MODELS = {
  "OauthIdentity": {
    "owner": "user_id",
    "erase": "delete",
    "omit": ["raw"]
  },
  "SamlIdentity": {"owner": "user_id", "erase": "delete"},
  "PasskeyCredential": {
    "owner": "user_id",
    "erase": "delete",
    "omit": ["public_key"]
  },
  "TwoFactor": {
    "owner": "user_id",
    "erase": "delete",
    "omit": ["secret", "backup_code_digests"]
  },
  "ApiToken": {
    "owner": "user_id",
    "erase": "delete",
    "omit": ["token_digest"]
  },
  "MagicLink": {
    "owner": "user_id",
    "erase": "delete",
    "export": false
  },
  "ScimMembership": {
    "owner": "user_id",
    "erase": "delete"
  },
  # Push tokens (`soli generate devices`): left behind, they kept delivering
  # an erased user's notifications to their phone.
  "Device": {
    "owner": "user_id",
    "erase": "delete",
    "omit": ["token", "subscription"]
  },
  # The offline outbox (`soli generate offline`): what the user's devices sent.
  "SyncEvent": {"owner": "user_id", "erase": "delete"},
  # The OpenID Connect provider (`soli generate oidc_provider`) names the
  # user by `user_key`: the applications they authorised, and the codes and
  # tokens issued in their name.
  "OauthConsent": {"owner": "user_key", "erase": "delete"},
  "OauthRefreshToken": {
    "owner": "user_key",
    "erase": "delete",
    "export": false
  },
  "OauthAuthorizationCode": {
    "owner": "user_key",
    "erase": "delete",
    "export": false
  },
  "OauthDeviceCode": {
    "owner": "user_key",
    "erase": "delete",
    "export": false
  },
  # The audit log (`soli generate audit`) names who did what: the entries a
  # user is the actor of are part of an export. They are *kept* by an
  # erasure — a log that forgets is not one, and keeping it is usually a
  # legal obligation or a legitimate interest you state in your privacy
  # notice. To blank the address and the IP instead, make this
  # `"erase": "anonymize", "fields": ["actor_label", "ip"]` — in a chained
  # log (`--chain`) that breaks `Audit.verify` at those entries, since both
  # are covered by the hashes.
  "Audit": {
    "owner": "actor_key",
    "erase": "keep",
    "omit": ["prev_hash", "entry_hash"]
  }
}

# What an erasure does to the account itself: "anonymize" keeps the record,
# stripped and unusable, so whatever references it still resolves; "delete"
# removes it.
const PRIVACY_USER_ERASE = "anonymize"

# Fields of the account that are credentials or bookkeeping, not the user's
# data: left out of an export, cleared by an erasure.
const PRIVACY_USER_SECRETS = [
  "password_digest",
  "reset_token_digest",
  "reset_sent_at",
  "confirmation_token_digest",
  "confirmation_sent_at",
  "remember_token_digest",
  "remember_previous_digest",
  "remember_created_at",
  "remember_rotated_at",
  "session_version",
  "failed_attempts",
  "locked_at"
]

# Fields of the account an erasure blanks, besides its secrets.
const PRIVACY_USER_FIELDS = [
  "name",
  "scim_external_id",
  "scim_given_name",
  "scim_family_name"
]

class Privacy
  # The models that hold personal data, with their rules. A model of
  # PRIVACY_MODELS that does not exist is an error: a typo here would
  # otherwise leave data behind in silence.
  static def models
    found = {}
    PRIVACY_SCAFFOLD_MODELS.keys.each do |name|
      model = const_get(name) rescue nil
      next if model.nil?

      found[name] = PRIVACY_SCAFFOLD_MODELS[name]
    end
    PRIVACY_MODELS.keys.each do |name|
      const_get(name)
      found[name] = PRIVACY_MODELS[name]
    end
    found
  end

  # The records of `name` that belong to `user`, as a query.
  static def records(name, rules, user)
    filter = {}
    filter[rules["owner"]] = user._key
    const_get(name).where(filter)
  end

  # `fields` without the keys in `omitted`.
  static def without(fields, omitted)
    kept = {}
    fields.keys.each do |name|
      next if omitted.includes?(name)

      kept[name] = fields[name]
    end
    kept
  end

  # Everything the app holds about `user`, as one hash: the account, then
  # each model's records under its name. Secrets are left out.
  static def export_data(user)
    data = {"exported_at": DateTime.utc.to_iso, "user": Privacy.without(user.to_h, PRIVACY_USER_SECRETS)}
    models = Privacy.models
    models.keys.each do |name|
      rules = models[name]
      next if rules["export"] == false

      omitted = rules["omit"] ?? []
      rows = Privacy.records(name, rules, user).all
      data[name] = rows.map do |row|
        Privacy.without(row.to_h, omitted)
      end
    end
    data
  end

  # Erase what the app holds about `user`, by each model's rule, then the
  # account. Returns the report: how many records were deleted, anonymized
  # and kept, per model.
  static def erase(user)
    report = {
      "deleted": {},
      "anonymized": {},
      "kept": {}
    }
    # The account's sessions end first, as in a password reset: a session
    # of the account that is adding a token or a passkey while this runs
    # checks the version after writing (`auth_credential_kept?`) and takes
    # its row back — or wrote it before the sweep below, which removes it.
    user.end_sessions
    models = Privacy.models
    models.keys.each do |name|
      Privacy.erase_model(name, models[name], user, report)
    end

    Privacy.erase_account(user)
    # And what could sign in to it, once more, now that the account is
    # closed: nothing added since the first sweep is left on the shell.
    user._sweep_credentials
    Logger.info("privacy: erased user #{user._key}: #{report}")
    report
  end

  # Apply one model's rule to the user's records, and note it in `report`.
  static def erase_model(name, rules, user, report)
    scope = Privacy.records(name, rules, user)
    count = scope.count
    action = rules["erase"]
    if action == "keep"
      report["kept"][name] = count
    elsif action == "anonymize"
      blank = {}
      fields = rules["fields"] ?? []
      fields.each do |field|
        blank[field] = nil
      end
      scope.update_all(blank) if count > 0
      report["anonymized"][name] = count
    elsif action == "delete"
      scope.delete_all if count > 0
      report["deleted"][name] = count
    else
      throw "privacy: #{name} has no erase rule (delete, anonymize or keep)"
    end
  end

  # The account: gone, or kept as an empty shell nobody can sign in to.
  static def erase_account(user)
    return user.delete if PRIVACY_USER_ERASE == "delete"

    blank = {
      "email": "erased-#{user._key}@erased.invalid",
      "erased_at": DateTime.utc.to_unix,
      "deactivated_at": DateTime.utc.to_unix,
      "session_version": user.current_session_version + 1
    }
    # Also what `soli generate scim` reads to keep an account out.

    # Every session opened before this moment is refused.
    (PRIVACY_USER_SECRETS + PRIVACY_USER_FIELDS).each do |field|
      blank[field] = nil unless field == "session_version"
    end
    # In bulk, so an audited User does not log the values being erased.
    User.where({"_key": user._key}).update_all(blank)
  end
end
