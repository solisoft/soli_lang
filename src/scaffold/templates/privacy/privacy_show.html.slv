<div class="max-w-2xl mx-auto px-4 py-10">
  <h1 class="text-2xl font-bold mb-2">Your data</h1>
  <p class="mb-6 text-sm text-slate-400">
    Download everything this site holds about you, or erase your account.
  </p>

  <% if error.present? %>
    <div class="mb-4 rounded-md bg-red-500/10 border border-red-500/30 px-4 py-3 text-sm text-red-300">
      <%= error %>
    </div>
  <% end %>

  <form action="/privacy/export" method="POST" class="mb-6 space-y-4 bg-slate-900 border border-slate-800 rounded-xl p-6">
    <%- csrf_field() %>
    <h2 class="font-semibold text-white">Download your data</h2>
    <p class="text-sm text-slate-400">A JSON file with your account and everything attached to it.</p>
    <button type="submit"
            class="rounded-md bg-indigo-600 hover:bg-indigo-700 px-4 py-2 font-medium text-white transition-colors">
      Download
    </button>
  </form>

  <form action="/privacy/erase" method="POST" class="space-y-4 bg-slate-900 border border-slate-800 rounded-xl p-6">
    <%- csrf_field() %>
    <h2 class="font-semibold text-white">Erase your account</h2>
    <p class="text-sm text-slate-400">
      This cannot be undone. Type <strong class="text-white"><%= email %></strong> to confirm.
    </p>
    <input name="email" type="email" required autocomplete="off" placeholder="Your email address"
           class="w-full rounded-md bg-slate-950 border border-slate-700 px-3 py-2 text-white focus:border-indigo-500 focus:outline-none">
    <% if has_password %>
      <input name="password" type="password" required placeholder="Password" autocomplete="current-password"
             class="w-full rounded-md bg-slate-950 border border-slate-700 px-3 py-2 text-white focus:border-indigo-500 focus:outline-none">
    <% end %>
    <button type="submit"
            class="rounded-md bg-red-600 hover:bg-red-700 px-4 py-2 font-medium text-white transition-colors">
      Erase my account
    </button>
  </form>
</div>
