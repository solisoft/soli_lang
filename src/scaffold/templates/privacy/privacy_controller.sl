# Privacy controller — a user downloads their data, or erases their account.
# Generated by `soli generate privacy`.
#
# What is exported and what an erasure does to each model is the register in
# app/services/privacy.sl. Both actions take the signed-in user's own
# session: not a token, and not an administrator acting as them. To answer a
# request made by mail, call `Privacy.export_data(user)` / `Privacy.erase(user)`
# from a script.

class PrivacyController < Controller
  static {
    this.layout = "application"
  }

  # GET /privacy
  def show
    user = @_person
    return redirect("/login") if user.nil?

    @_page(user, "", 200)
  end

  # POST /privacy/export — everything held about the user, as a JSON file
  def download
    user = @_person
    return redirect("/login") if user.nil?

    {
      "status": 200,
      "headers": {
        "Content-Type": "application/json",
        "Content-Disposition": "attachment; filename=\"my-data.json\""
      },
      "body": json_stringify(Privacy.export_data(user))
    }
  end

  # POST /privacy/erase — erase the account; asks for its email and password
  def erase
    user = @_person
    return redirect("/login") if user.nil?

    typed = params["email"].to_s.trim.downcase
    return @_page(user, "Type your email address to confirm.", 422) unless typed == user.email
    if user.password_digest.present? && !user.authenticate(params["password"].to_s)
      return @_page(user, "Wrong password.", 401)
    end

    Privacy.erase(user)
    session_destroy()
    redirect("/")
  end

  private

  # The signed-in user, when the request comes from their own session.
  def _person
    return nil unless (req["api_token"] rescue nil).nil?
    return nil if session_get("impersonator_id").to_s.present?

    current_user()
  end

  def _page(user, error, status)
    render(
      "privacy/show",
      {
        "title": "Your data",
        "email": user.email,
        "has_password": user.password_digest.present?,
        "error": error
      },
      {"status": status}
    )
  end
end
