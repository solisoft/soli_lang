# Database Configuration
# These variables are used by soli db:migrate commands

SOLIDB_HOST=http://localhost:6745
SOLIDB_DATABASE=default
SOLIDB_USERNAME=admin
SOLIDB_PASSWORD=admin

# SoliKV Cache Configuration
# SOLIKV_RESP_HOST=localhost
# SOLIKV_RESP_PORT=6380
# SOLIKV_TOKEN=

# Application Settings
# APP_ENV=development
# APP_SECRET=your-secret-key-here

# Public hostnames this app is served under, comma-separated. Behind a reverse
# proxy the app sees 127.0.0.1:<port>, not the browser's Origin, so its CSRF
# check refuses every form until it knows them ("Origin myapp.example.com does
# not match request authority 127.0.0.1:20111"). soli-proxy sets it for apps
# it starts; behind nginx or Caddy, uncomment and fill in.
# SOLI_APP_HOSTS=myapp.example.com

# Require a valid per-form CSRF token on browser form posts (urlencoded /
# multipart). form_with / csrf_field already embed one. JSON APIs are not
# token-gated; use skip_csrf("/path") for webhooks.
SOLI_CSRF_TOKENS=require
