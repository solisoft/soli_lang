# Two-factor authentication (TOTP) — generated by `soli generate auth --two-factor`.
# Collection: two_factors — one record per user who started or finished
# enrolling an authenticator app.
#
# The secret is encrypted at rest (`encrypts`, keyed by SOLI_ENCRYPTION_KEY).
# Backup codes are random, so only their SHA-256 digest is stored. A code is
# accepted once: `last_step` remembers the time step of the last accepted code
# and refuses that step and every earlier one, which is the replay protection
# `Crypto.totp_verify` alone does not give.
#
# Wrong codes are counted here, not on the user: the password step clears the
# user's own counter, so a counter kept there would be reset by anyone who
# knows the password. AUTH_MAX_FAILED_ATTEMPTS wrong codes in a row lock the
# second factor for AUTH_LOCKOUT_SECONDS (both from app/models/user.sl).

const TWO_FACTOR_BACKUP_CODES = 10  # backup codes issued at a time

# The name an authenticator app shows next to the account.
def two_factor_issuer
  return getenv("TWO_FACTOR_ISSUER").to_s if getenv("TWO_FACTOR_ISSUER").present?

  "Soli app"
end

class TwoFactor < Model
  # A save is refused when the record changed since it was read: two requests
  # carrying the same code cannot both record it as used (see `_accept_totp`
  # and `_use_backup_code`).
  optimistic_lock
  encrypts(:secret)
  validates(
    "user_id",
    {"presence": true, "uniqueness": true}
  )

  static def for_user(user)
    TwoFactor.find_by("user_id", user._key)
  end

  # True once `user` confirmed an authenticator app.
  static def enabled?(user)
    record = TwoFactor.for_user(user)
    !record.nil? && record.confirmed?
  end

  # Start enrolling: a record with a fresh secret, not confirmed yet. An
  # earlier unconfirmed attempt is replaced; a confirmed one is returned as it
  # is, so this can never swap the secret of an account that has two-factor on.
  #
  # `setup_digest` is the digest of a value only the session that starts the
  # enrolment holds (`started_by?`): the secret is that session's to see and
  # to confirm, not any session's of the account.
  static def start(user, setup_digest = nil)
    record = TwoFactor.for_user(user)
    return record if !record.nil? && record.confirmed?

    record.delete unless record.nil?
    TwoFactor.create({
      "user_id": user._key,
      "secret": Crypto.totp_secret,
      "backup_code_digests": [],
      "setup_digest": setup_digest
    })
  end

  # Was this enrolment started by the session that holds `nonce`?
  def started_by?(nonce)
    return false if @setup_digest.blank? || nonce.to_s.blank?

    Crypto.secure_compare(Crypto.sha256(nonce.to_s), @setup_digest)
  end

  # A backup code as it was issued: lowercase, no dash, no spaces.
  static def normalize_backup_code(code)
    code.to_s.downcase.replace("-", "").replace(" ", "")
  end

  def confirmed?
    !@confirmed_at.nil?
  end

  # The otpauth:// URI an authenticator app enrolls from (shown as a QR code).
  def uri(user)
    Crypto.totp_uri(@secret, user.email, two_factor_issuer())
  end

  # Would `code` be accepted now? Asked before enrolling, and spends nothing.
  def accepts?(code)
    step = Crypto.totp_step(@secret, code.to_s.replace(" ", ""))
    !step.nil? && step > (@last_step ?? 0)
  end

  # Finish enrolling with a first code from the app. Returns the backup codes
  # in plaintext — the only time they exist that way — or nil on a wrong code.
  def confirm(code)
    return nil if @confirmed?
    return nil unless @_accept_totp(code)

    @confirmed_at = DateTime.utc.to_unix
    @new_backup_codes
  end

  # Replace the backup codes. Returns the new ones in plaintext, to show once.
  def new_backup_codes
    codes = (0 .. TWO_FACTOR_BACKUP_CODES).map do |_|
      Crypto.random_hex(10)
    end
    @backup_code_digests = codes.map do |code|
      Crypto.sha256(code)
    end
    # nil when the record changed since it was read: codes that were not
    # stored must not be shown as if they were.
    return nil unless @update == true

    codes.map do |code|
      [code.substring(0, 5), code.substring(5, 10), code.substring(10, 15), code.substring(15, 20)].join("-")
    end
  end

  def backup_codes_left
    digests = @backup_code_digests ?? []
    digests.length
  end

  # True when `code` is a current authenticator code or an unused backup code.
  # A backup code is consumed. While the second factor is locked nothing is
  # checked, so a locked account answers exactly like a wrong code.
  def verify(code)
    return false unless @confirmed?
    return false if @locked?

    if @_accept_totp(code) || @_use_backup_code(code)
      @_clear_failures
      return true
    end
    @_register_failure
    false
  end

  def locked?
    return false if @locked_at.nil?

    DateTime.utc.to_unix - @locked_at <= AUTH_LOCKOUT_SECONDS
  end

  private

  def _accept_totp(code)
    step = Crypto.totp_step(@secret, code.to_s.replace(" ", ""))
    return false if step.nil?
    return false if step <= (@last_step ?? 0)

    @last_step = step
    # False when another request used a code in the meantime: this one loses.
    @update == true
  end

  def _use_backup_code(code)
    digest = Crypto.sha256(TwoFactor.normalize_backup_code(code))
    stored = @backup_code_digests ?? []
    remaining = stored.filter do |candidate|
      !Crypto.secure_compare(candidate, digest)
    end
    return false if remaining.length == stored.length

    @backup_code_digests = remaining
    # False when another request spent a code in the meantime.
    @update == true
  end

  def _register_failure
    # Counted in the database (`increment` is one atomic write): a read, +1
    # and save let parallel guesses overwrite each other's count.
    @increment("failed_codes")
    return if (@failed_codes ?? 0) < AUTH_MAX_FAILED_ATTEMPTS

    @locked_at = DateTime.utc.to_unix
    @failed_codes = 0
    auth_written(TwoFactor.where({"_key": @_key}).update_all({"locked_at": @locked_at, "failed_codes": 0}))
  end

  def _clear_failures
    return if (@failed_codes ?? 0) == 0 && @locked_at.nil?

    @failed_codes = 0
    @locked_at = nil
    @update
  end
end
