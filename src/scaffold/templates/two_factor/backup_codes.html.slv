<div class="max-w-2xl mx-auto px-4 py-10">
  <h1 class="text-2xl font-bold mb-2">Backup codes</h1>
  <p class="mb-6 text-sm text-slate-400">
    Each code signs you in once if you lose your device. Keep them somewhere safe:
    they are shown this one time.
  </p>

  <ul class="mb-6 grid grid-cols-2 gap-2 rounded-xl border border-slate-800 bg-slate-900 p-6 font-mono text-white">
    <% codes.each do |code| %>
      <li data-backup-code><%= code %></li>
    <% end %>
  </ul>

  <a href="/two_factor" class="text-indigo-400 hover:text-indigo-300">Done</a>
</div>
