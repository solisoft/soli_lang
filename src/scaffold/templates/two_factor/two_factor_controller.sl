# Two-factor controller — enrolling an authenticator app, backup codes,
# turning it off, and the challenge after sign-in.
# Generated by `soli generate auth --two-factor`.
#
# The challenge reads `req["two_factor_user"]`, set by
# app/middleware/two_factor.sl for a session that passed the first factor
# only. Every code endpoint sits behind the per-IP throttle of the sign-in
# form; wrong codes are also counted on the TwoFactor record, which locks.

class TwoFactorController < Controller
  static {
    this.layout = "application"
  }

  # GET /two_factor
  def index
    user = current_user()
    return redirect("/login") if user.nil?

    @_render_index(user, "", 200)
  end

  # POST /two_factor/setup — a fresh secret, shown as a QR code
  def setup
    user = current_user()
    return redirect("/login") if user.nil?
    return @_not_the_owner unless auth_own_session?(req)
    return redirect("/two_factor") if TwoFactor.enabled?(user)
    # Turning a second factor on locks everyone else out of the account:
    # from a sign-in of the last few minutes, not a session left open.
    unless auth_fresh_sign_in?()
      return @_render_index(user, "Sign in again to set up two-factor authentication.", 403)
    end

    if getenv("SOLI_ENCRYPTION_KEY").blank?
      return @_render_index(user, "Set SOLI_ENCRYPTION_KEY first: the secret is stored encrypted.", 500)
    end

    @_render_setup(TwoFactor.start(user), user, "", 200)
  end

  # POST /two_factor/confirm — a first code from the app turns it on
  def confirm
    user = current_user()
    return redirect("/login") if user.nil?
    return @_not_the_owner unless auth_own_session?(req)

    record = TwoFactor.for_user(user)
    return redirect("/two_factor") if record.nil? || record.confirmed?
    # As for `setup`: an enrolment left half-way must not be finished — and
    # its secret must not be shown again — from a session left open.
    unless auth_fresh_sign_in?()
      return @_render_index(user, "Sign in again to set up two-factor authentication.", 403)
    end
    return @_render_setup(record, user, "Too many attempts. Try again in a few minutes.", 429) unless @_allowed

    invalid = "That code is not valid. Check the clock of your device and try again."
    return @_render_setup(record, user, invalid, 422) unless record.accepts?(params["code"])
    # An authenticator enrolled from a session that ended meanwhile (a
    # password reset) is not kept.
    return redirect("/login") unless auth_credential_kept?(user, record)

    # Every other session of this account is signed out; this one stays.
    # Before the account is enrolled, not after: were this to fail, nothing
    # is enrolled and it can be tried again. The other order could leave an
    # account with a second factor and, signed in to it, a session that
    # holds "no second factor".
    user.end_sessions
    session_set("session_version", user.current_session_version)
    codes = record.confirm(params["code"])
    return @_render_setup(record, user, invalid, 422) if codes.nil?

    session_set("two_factor", "ok:#{user._key}")
    render(
      "two_factor/backup_codes",
      {"title": "Backup codes", "codes": codes}
    )
  end

  # POST /two_factor/backup_codes — replace the backup codes
  def backup_codes
    user = current_user()
    return redirect("/login") if user.nil?
    return @_not_the_owner unless auth_own_session?(req)

    record = TwoFactor.for_user(user)
    return redirect("/two_factor") if record.nil? || !record.confirmed?
    return @_render_index(user, "Too many attempts. Try again in a few minutes.", 429) unless @_allowed
    return @_render_index(user, @_password_locked, 423) if @_password_locked?(user)
    return @_render_index(user, "Wrong password.", 401) unless @_password_ok(user)
    # New codes are a way past the second factor. An account without a
    # password has none to ask for: a recent sign-in is asked of everyone.
    unless auth_fresh_sign_in?()
      return @_render_index(user, "Sign in again to get new backup codes.", 403)
    end

    codes = record.new_backup_codes
    return @_render_index(user, "The codes could not be replaced. Try again.", 409) if codes.nil?

    render(
      "two_factor/backup_codes",
      {"title": "Backup codes", "codes": codes}
    )
  end

  # DELETE /two_factor — turn it off: the password and a current code
  def destroy
    user = current_user()
    return redirect("/login") if user.nil?
    return @_not_the_owner unless auth_own_session?(req)

    record = TwoFactor.for_user(user)
    return redirect("/two_factor") if record.nil?
    return @_render_index(user, "Too many attempts. Try again in a few minutes.", 429) unless @_allowed

    return @_render_index(user, @_password_locked, 423) if @_password_locked?(user)

    unless @_password_ok(user) && record.verify(params["code"])
      return @_render_index(user, "Wrong password or code.", 401)
    end

    record.delete
    session_set("two_factor", "off:#{user._key}")
    redirect("/two_factor")
  end

  # GET /two_factor/challenge
  def challenge
    return redirect(current_user().nil? ? "/login" : "/") if req["two_factor_user"].nil?

    render(
      "two_factor/challenge",
      {"title": "Two-factor authentication", "error": ""}
    )
  end

  # POST /two_factor/challenge — an authenticator code or a backup code
  def verify
    user = req["two_factor_user"]
    return redirect("/login") if user.nil?
    return @_reject_challenge("Too many attempts. Try again in a few minutes.", 429) unless @_allowed

    record = TwoFactor.for_user(user)
    return @_reject_challenge("That code is not valid.", 401) if record.nil? || !record.verify(params["code"])

    # A new session id once both factors passed, as after a password sign-in.
    # A new session, the user's alone (see `auth_open_session`) — within the
    # sign-in the password step began: an end it came with (SAML) stays.
    auth_open_session(user, true)
    session_set("two_factor", "ok:#{user._key}")
    redirect("/")
  end

  private

  # An API token, or an administrator acting as the user: the second factor
  # is the owner's to set, show and remove.
  def _not_the_owner
    {"status": 403, "body": "Forbidden"}
  end

  # The per-IP throttle of the sign-in form (app/models/user.sl).
  def _allowed
    rate_limiter_from_ip(req, AUTH_ATTEMPTS_PER_IP, AUTH_IP_WINDOW_SECONDS).allowed
  end

  # Wrong passwords at the sign-in form lock the password — here too, and
  # anyone who knows the address can cause it. The owner is told what it is,
  # not that their password is wrong.
  def _password_locked?(user)
    user.password_digest.present? && user.locked?
  end

  def _password_locked
    "Password sign-in is locked after too many wrong passwords. Try again in a few minutes."
  end

  # An account without a password (created through OAuth) has none to ask for.
  #
  # Counted like a sign-in: a session left open is not a place to guess the
  # password from without the lockout, and a locked account's password is
  # not checked at all.
  def _password_ok(user)
    # (`_password_locked?` answered first, with a message that says so.)
    return true if user.password_digest.blank?
    return false if user.locked?

    if user.authenticate(params["password"].to_s) == true
      user.clear_failed_attempts
      return true
    end
    user.register_failed_attempt
    false
  end

  def _render_index(user, error, status)
    record = TwoFactor.for_user(user)
    enabled = !record.nil? && record.confirmed?
    render("two_factor/index", {
      "title": "Two-factor authentication",
      "enabled": enabled,
      "codes_left": enabled ? record.backup_codes_left : 0,
      "has_password": user.password_digest.present?,
      "error": error
    }, {"status": status})
  end

  def _render_setup(record, user, error, status)
    render("two_factor/setup", {
      "title": "Set up two-factor authentication",
      "uri": record.uri(user),
      "secret": record.secret,
      "error": error
    }, {"status": status})
  end

  def _reject_challenge(message, status)
    render("two_factor/challenge", {
      "title": "Two-factor authentication",
      "error": message
    }, {"status": status})
  end
end
