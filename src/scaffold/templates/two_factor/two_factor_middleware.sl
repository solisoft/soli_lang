# Second factor gate — generated by `soli generate auth --two-factor`.
#
# Runs right after `load_current_user` (order 5). A user who turned two-factor
# on is signed in only once this session passed the challenge; until then the
# request goes on as a guest and a page load is sent to /two_factor/challenge.
#
# Gating here rather than in the sign-in action covers every way a session is
# opened — password, password reset, remember-me cookie, OAuth — with one
# check, and fails closed for a path added later. A passkey sign-in marks the
# session as verified itself: a passkey already is two factors.
#
# The session remembers the answer ("ok:<user>" or "off:<user>"), so a
# signed-in request costs no query. Turning two-factor on bumps the user's
# session version, which signs every other session out.

# order: 6

def require_second_factor(req)
  user = req["current_user"]
  return req if user.nil?

  state = session_get("two_factor").to_s
  return req if ["ok:#{user._key}", "off:#{user._key}"].includes?(state)

  unless TwoFactor.enabled?(user)
    session_set("two_factor", "off:#{user._key}")
    return req
  end

  # One factor so far: a guest to the app, known only to the challenge.
  req["two_factor_user"] = user
  req["current_user"] = nil
  path = req["path"].to_s
  return req if req["method"] != "GET" || path.starts_with?("/two_factor/challenge")

  redirect("/two_factor/challenge")
end
