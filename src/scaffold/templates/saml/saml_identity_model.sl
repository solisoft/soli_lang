# SamlIdentity — links a User to the identity an identity provider asserts.
# Generated by `soli generate saml`.
# Collection: saml_identities
#
# The link is the pair (issuer, name_id): the NameID is only unique within the
# identity provider that issued it. The email is kept for reference; it is not
# what a later sign-in is matched on, so a user whose address changes at the
# identity provider keeps the same account here.

class SamlIdentity < Model
  validates("user_id", {"presence": true})
  validates("issuer", {"presence": true})
  validates("name_id", {"presence": true})

  static def find_for(issuer, name_id)
    SamlIdentity.where({"issuer": issuer, "name_id": name_id}).first
  end
end
