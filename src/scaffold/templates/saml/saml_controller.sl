# SAML controller — single sign-on with an identity provider.
# Generated by `soli generate saml`.
#
# /saml/login sends the browser to the identity provider; the identity
# provider posts its signed response to /saml/acs, which `config/routes.sl`
# exempts from the CSRF gate: it is a cross-site POST by design, and what
# authenticates it is the signature, not the origin. /saml/metadata is what
# the identity provider's administrator needs.

class SamlController < Controller
  static {
    this.layout = "application"
  }

  # GET /saml/login
  def login
    redirect_external(SamlSso.start(@_local_path(params["return_to"])))
  end

  # POST /saml/acs — the identity provider's response
  def acs
    result = nil
    user = nil
    try
      result = SamlSso.finish(params["SAMLResponse"].to_s)
      user = SamlSso.user_for(result["assertion"])
    catch error
      # The reason goes to the log, not to the browser.
      Logger.warn("SAML sign-in refused: #{error}")
      return @_reject
    end
    # No `user.locked?` here: that lock counts wrong passwords, and the
    # identity provider authenticated this user. Honouring it let anyone who
    # typed eleven wrong passwords for the address shut its owner out of
    # single sign-on for half an hour.

    # New session id after a successful login defeats session fixation.
    session_regenerate()
    session_set("user_id", user._key)
    # When this sign-in happened: the OIDC provider reads it for max_age / auth_time.
    session_set("auth_time", DateTime.utc.to_unix)
    # Stamped so a later password reset can invalidate this session.
    session_set("session_version", user.current_session_version)
    # There is no single logout: this session would outlive the user's
    # removal at the identity provider. It ends at the identity provider's
    # SessionNotOnOrAfter, or after SAML_SESSION_TTL, whichever comes first.
    session_set("sign_in_expires_at", SamlSso.session_expires_at(result["assertion"]))
    redirect(@_local_path(result["return_to"]))
  end

  # GET /saml/metadata
  def metadata
    {
      "status": 200,
      "headers": {"Content-Type": "application/samlmetadata+xml"},
      "body": SamlSso.metadata
    }
  end

  private

  # A path on this site, or "/": the value came from a URL.
  def _local_path(path)
    target = path.to_s
    return "/" unless target.starts_with?("/")
    return "/" if target.starts_with?("//") || target.includes?("\\")

    # A browser drops a tab or a newline from a URL: "/\t/evil.test" would
    # read as "//evil.test". redirect() refuses them; "/" is the answer here.
    return "/" if Regex.matches("[\\x00-\\x1f\\x7f]", target)

    target
  end

  def _reject
    render(
      "sessions/new",
      {
        "title": "Sign in",
        "error": "Single sign-on failed. Try again, or contact your administrator.",
        "email": "",
        "signup_open": auth_signup_open?()
      },
      {"status": 401}
    )
  end
end
