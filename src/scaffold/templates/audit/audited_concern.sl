# Audited — `include Audited` in a model to log who changed what.
# Generated by `soli generate audit`.
#
# Every create, update and delete of the model writes an Audit entry (see
# app/models/audit.sl) with the fields that changed, as [old, new].
#
#   class Invoice < Model
#     include Audited
#
#     static def audit_redacted
#       ["iban"]              # logged as changed, values withheld
#     end
#   end
#
#   invoice.audits            # this record's history, oldest first
#
# What is not logged: writes that skip callbacks — `update_all`, `delete_all`,
# `increment` / `decrement`, raw queries — and a change made by mutating a
# nested Hash or Array in place (reassign the attribute instead). An entry is
# written after the change, in its own write: if that write fails the change
# stands and the error is raised.

module Audited
  included do
    after_create("_audit_created")
    after_update("_audit_updated")
    after_delete("_audit_deleted")
  end

  class_methods do
    # Fields logged as changed with their values withheld. Fields declared
    # with `encrypts` are always treated this way. Override in the model.
    def audit_redacted
      ["password_digest"]
    end

    # Fields left out of the log entirely. Override in the model.
    def audit_ignored
      []
    end
  end

  # This record's entries, oldest first.
  def audits
    Audit.for_record(this)
  end

  def _audit_created
    Audit.record("create", this, @_audit_changes(@previous_changes))
  end

  def _audit_updated
    changes = @_audit_changes(@previous_changes)
    Audit.record("update", this, changes) if changes.length > 0
  end

  # A delete logs the record as it was: every field as [value, nil].
  def _audit_deleted
    fields = @to_h
    snapshot = {}
    fields.keys.each do |name|
      snapshot[name] = [fields[name], nil]
    end
    Audit.record("delete", this, @_audit_changes(snapshot))
  end

  # `changes` without the ignored fields, and with redacted values withheld.
  def _audit_changes(changes)
    model = const_get(this.class)
    redacted = model.audit_redacted + model.encrypted_attributes
    ignored = AUDIT_IGNORED + model.audit_ignored
    logged = {}
    changes.keys.each do |name|
      next if ignored.includes?(name)

      logged[name] = redacted.includes?(name) ? [AUDIT_REDACTED, AUDIT_REDACTED] : changes[name]
    end
    logged
  end
end
