# Audit — one entry per change to a model that includes `Audited`.
# Generated by `soli generate audit`.
# Collection: audits
#
# Fields: action ("create", "update", "delete"), record_type, record_key,
# changes ({field: [old, new]}), at (Unix seconds), actor_type, actor_key,
# actor_label, request_id, ip — and, when the log is chained, seq, prev_hash
# and entry_hash.
#
# Reading:
#
#   record.audits                        # one record's history
#   Audit.by_actor(user)                 # what someone did, newest first
#   Audit.between(from_unix, to_unix)    # a period, oldest first
#
# Entries are never updated or deleted by the application; `purge_before` is
# the one exception, for a retention policy you decide.

# Chain the entries by hash, so that editing or removing one is detectable
# (`Audit.verify`). It costs a read per entry, and writers queue on the tail of
# the log. Set by `soli generate audit --chain`; changing it later needs the
# unique index on `seq` its migration creates.
const AUDIT_CHAINED = false

const AUDIT_REDACTED = "[redacted]"

# Bookkeeping fields: never worth an entry of their own.
const AUDIT_IGNORED = ["id", "_key", "_id", "_rev", "created_at", "updated_at"]

# What an entry's hash covers, in the chained log.
const AUDIT_HASHED = [
  "action",
  "record_type",
  "record_key",
  "changes",
  "at",
  "actor_type",
  "actor_key",
  "actor_label",
  "request_id",
  "ip"
]

class Audit < Model
  # Who is acting: the signed-in user of the request, or "system" outside one
  # (a job, a script, a migration, the console).
  static def actor
    user = req["current_user"] rescue nil
    if user.nil?
      return {
        "actor_type": "system",
        "actor_key": nil,
        "actor_label": nil
      }
    end

    {
      "actor_type": user.class,
      "actor_key": user._key,
      "actor_label": (user.email rescue nil)
    }
  end

  # Where the change came from, when it came from a request.
  static def origin
    {
      "request_id": (req["headers"]["x-request-id"] rescue nil),
      "ip": (req["remote_addr"] rescue nil)
    }
  end

  # Write the entry for `action` on `record`. Called by the Audited concern.
  static def record(action, record, changes)
    entry = Audit.actor.merge(Audit.origin).merge({
      "action": action,
      "record_type": record.class,
      "record_key": record._key,
      "changes": changes,
      "at": DateTime.utc.to_unix
    })
    return Audit.append(entry) if AUDIT_CHAINED

    Audit.create(entry)
  end

  # Add `entry` at the tail of the chain. Two writers that read the same tail
  # both ask for the same `seq`; the unique index refuses one, which retries.
  static def append(entry)
    attempts = 0
    while attempts < 8
      last = Audit.order("seq", "desc").first
      seq = last.nil? ? 1 : last.seq + 1
      prev_hash = last.nil? ? "" : last.entry_hash
      links = {
        "seq": seq,
        "prev_hash": prev_hash,
        "entry_hash": Crypto.ledger_hash(prev_hash, seq, entry)
      }
      row = Audit.create(entry.merge(links)) rescue nil
      return row if !row.nil? && !row._errors

      attempts += 1
    end
    throw "audit: could not append an entry after #{attempts} attempts"
  end

  # Check the chain from its first entry. Returns nil when it is intact, or
  # the `seq` of the first entry that was altered, removed or inserted.
  static def verify
    prev_hash = ""
    seq = 1
    for row in Audit.order("seq", "asc").all
      return seq if row.seq != seq || row.prev_hash != prev_hash
      return seq if row.entry_hash != Crypto.ledger_hash(prev_hash, seq, row.hashed_fields)

      prev_hash = row.entry_hash
      seq += 1
    end
    nil
  end

  static def for_record(record)
    Audit.where({"record_type": record.class, "record_key": record._key}).order("at", "asc").all
  end

  static def by_actor(user)
    Audit.where({"actor_type": user.class, "actor_key": user._key}).order("at", "desc").all
  end

  static def between(from_unix, to_unix)
    Audit.where({"at": {"gte": from_unix, "lt": to_unix}}).order("at", "asc").all
  end

  # Retention: delete the entries older than `unix`. Returns how many. On a
  # chained log this removes the head of the chain, and `verify` then reports
  # the first entry left: purge a chained log only after archiving it.
  static def purge_before(unix)
    old = Audit.where({"at": {"lt": unix}})
    count = old.count
    old.delete_all
    count
  end

  # The fields the entry's hash covers, as they were hashed.
  def hashed_fields
    fields = @to_h
    hashed = {}
    AUDIT_HASHED.each do |name|
      hashed[name] = fields[name]
    end
    hashed
  end
end
