# Magic link mailer — generated by `soli generate auth --magic-link`.
#
# The body renders app/views/magic_link_mailer/sign_in.html.slv. The link is
# built from `auth_base_url` (app/models/user.sl): set APP_BASE_URL.

class MagicLinkMailer < Mailer
  def sign_in(user, token)
    @user = user
    @sign_in_url = "#{auth_base_url()}/login/link/#{token}"
    @minutes = MAGIC_LINK_TTL / 60
    @mail(to: user.email, subject: "Your sign-in link")
  end
end
