# Magic links controller — sign in with a link sent by email.
# Generated by `soli generate auth --magic-link`.
#
# POST /login/link answers the same way whether or not the address has an
# account, and sets the browser cookie either way, so the form cannot be used
# to probe for accounts. It shares the sign-in form's per-IP throttle: it
# sends mail, and it is a guess at a credential.

class MagicLinksController < Controller
  static {
    this.layout = "application"
  }

  # GET /login/link — ask for a link
  def new
    @_form("", "", 200)
  end

  # POST /login/link — send it
  def create
    limiter = rate_limiter_from_ip(req, AUTH_ATTEMPTS_PER_IP, AUTH_IP_WINDOW_SECONDS)
    return @_form("", "Too many requests. Try again in a few minutes.", 429) unless limiter.allowed

    started = clock()
    user = User.find_by("email", params["email"].to_s.trim.downcase)
    # An account that signs in through single sign-on only (`sso_only?`)
    # gets no link, and no different answer: a link in the mailbox would
    # outlive the user's removal at the identity provider. A password
    # lockout does not stop a link — anyone can trip it, and the mailbox is
    # its own proof.
    # The cookie this browser holds is kept — asking again must not undo
    # the link already in the mailbox — and every answer sets one.
    held = (cookies[MAGIC_LINK_COOKIE] rescue nil).to_s
    nonce = Regex.matches("^[0-9a-f]{64}$", held) ? held : Crypto.random_hex(32)
    if !user.nil? && !user.sso_only?
      link = MagicLink.issue(user, client_ip(req), nonce)
      unless link.nil?
        MagicLinkMailer.sign_in(user, link["token"]).deliver_later rescue nil
      end
    else
      # The write an account costs, on no row: same timing either way.
      User.burn_write_work
    end
    set_cookie(MAGIC_LINK_COOKIE, nonce, {
      "path": "/",
      "max_age": MAGIC_LINK_TTL,
      "http_only": true,
      "same_site": "Lax",
      "secure": true
    })

    auth_uniform_wait(started)
    @_form("If that email has an account, a sign-in link is on its way. Open it in this browser.", "", 200)
  end

  # GET /login/link/:token — the emailed link
  def show
    limiter = rate_limiter_from_ip(req, AUTH_ATTEMPTS_PER_IP, AUTH_IP_WINDOW_SECONDS)
    return @_form("", "Too many attempts. Try again in a few minutes.", 429) unless limiter.allowed

    user = MagicLink.redeem(params["token"], (cookies[MAGIC_LINK_COOKIE] rescue nil))
    # A link issued before the account became single sign-on only is refused
    # like an expired one.
    if user.nil? || user.sso_only?
      return @_form(
        "",
        "This link is invalid, has expired, or was opened in another browser than the one that asked for it.",
        401
      )
    end

    # Reading the mail proves the address. An account that was never
    # confirmed may have been created by someone else, with a password of
    # their choosing, in wait for this moment: everything it could be entered
    # with goes before it is confirmed (as a provider or SAML sign-in does).
    # — but only an account nobody ever entered: one that has been in use
    # keeps what its user set, its second factor above all, which a mailbox
    # alone must not remove.
    unless user.confirmed?
      user.revoke_credentials if user.never_signed_in?
      user.confirm_email
    end
    set_cookie(MAGIC_LINK_COOKIE, "", {
      "path": "/",
      "max_age": 0,
      "http_only": true,
      "same_site": "Lax",
      "secure": true
    })
    # A new session, the user's alone (see `auth_open_session`).
    auth_open_session(user)
    redirect("/")
  end

  private

  def _form(notice, error, status)
    render(
      "magic_links/new",
      {
        "title": "Sign in with a link",
        "notice": notice,
        "error": error
      },
      {"status": status}
    )
  end
end
