# MagicLink — a one-time sign-in link sent by email.
# Generated by `soli generate auth --magic-link`.
# Collection: magic_links
#
# A link works once, for MAGIC_LINK_TTL seconds, and only in the browser that
# asked for it: asking sets a cookie whose digest is stored with the link, and
# redeeming needs both. So a link read by a mail scanner, forwarded, or opened
# on another device signs nobody in — and is not used up by the attempt. Only
# digests are stored: a database leak cannot be replayed as a live link.

const MAGIC_LINK_TTL = 900  # a link lives 15 minutes

# Links one account may have pending at once, and how many of them one
# requesting address may have asked for.
const MAGIC_LINKS_PENDING = 100
const MAGIC_LINKS_PER_REQUESTER = 3

# The cookie that binds a link to the browser that asked. `__Host-`: a
# browser accepts that name only from this very host over https, so a
# sibling subdomain cannot plant one.
const MAGIC_LINK_COOKIE = "__Host-magic_link"

class MagicLink < Model
  # A fresh link for `user`, asked for from `requester` (an address, kept
  # for whoever reads the table). Returns the two secrets in plaintext, the
  # only time they exist that way: `token` goes in the email, `nonce` in the
  # browser's cookie — or nil when the account already has
  # MAGIC_LINKS_PENDING links waiting.
  #
  # A link is never removed to make room for another. Anyone can ask for a
  # link to anyone: removing one — the oldest, the requester's own — always
  # gave some way to cancel the link the owner was about to open. Requests
  # are refused instead: past MAGIC_LINKS_PER_REQUESTER for one address, so
  # that filling the account's MAGIC_LINKS_PENDING takes many addresses, not
  # three.
  #
  # `requester` is a network, not an address (`MagicLink.requester_for`):
  # an IPv6 client has a whole prefix of addresses to ask from.
  static def issue(user, requester = "")
    let now = DateTime.utc.to_unix
    # Expired rows go in one write: one per row would make a request for an
    # address someone parked links on slower than one for an unknown address.
    auth_written(MagicLink.where({"user_id": user._key, "expires_at": {"lte": now}}).delete_all)
    let live = MagicLink.where({"user_id": user._key}).all
    return nil if live.length >= MAGIC_LINKS_PENDING
    return nil if live.filter { |link| link.requester.to_s == requester.to_s }.length >= MAGIC_LINKS_PER_REQUESTER

    let token = Crypto.random_hex(32)
    let nonce = Crypto.random_hex(32)
    MagicLink.create({
      "user_id": user._key,
      "requester": requester.to_s,
      "token_digest": Crypto.sha256(token),
      "nonce_digest": Crypto.sha256(nonce),
      "expires_at": DateTime.utc.to_unix + MAGIC_LINK_TTL
    })
    {"token": token, "nonce": nonce}
  end

  # Who is asking, for the per-requester limit: an IPv4 address as it is, an
  # IPv6 one cut to its /64 — the unit one subscriber holds, and the one the
  # rate limiter counts by. Counted per address, a single IPv6 client would
  # be as many requesters as it likes.
  static def requester_for(address)
    let text = address.to_s.trim.downcase
    # What a proxy may write: "[2001:db8::1]:443", "192.0.2.1:5678".
    let bracketed = Regex.matches("^\\[", text)
    text = text.replace("[", "").split("]")[0].to_s if bracketed
    if !bracketed && Regex.matches("^[0-9.]+:[0-9]+$", text)
      text = text.split(":")[0]
    end
    return text unless text.includes?(":")
    # An IPv4 client seen through a dual-stack listener.
    return text.replace("::ffff:", "") if Regex.matches("^::ffff:[0-9.]+$", text)

    let halves = text.split("%")[0].split("::")
    let head = halves[0].to_s.split(":").filter { |group| group.present? }
    let tail = halves.length > 1 ? halves[1].to_s.split(":").filter { |group| group.present? } : []
    let missing = halves.length > 1 ? 8 - head.length - tail.length : 0
    let zeros = (0..missing).map { |i| "0" }
    let groups = [...head, ...zeros, ...tail]
    # Not an address after all: counted as written, never folded into
    # someone else's network.
    let odd = groups.filter { |group| !Regex.matches("^[0-9a-f]{1,4}$", group) }
    return text if odd.length > 0 || groups.length != 8
    # An IPv4 client written in hex (::ffff:c000:201): its own address, not
    # the one network every such client would share.
    let numbers = groups.map { |group| group.to_i(16) }
    if numbers.slice(0, 5).filter { |n| n != 0 }.length == 0 && numbers[5] == 65535
      return "#{numbers[6] / 256}.#{numbers[6] % 256}.#{numbers[7] / 256}.#{numbers[7] % 256}"
    end

    groups.slice(0, 4).map { |group| group.to_i(16).to_s }.join(":") + "::/64"
  end

  # The browser cookie after a request: the nonces it held (the last three)
  # and the new one, so asking again does not undo the link already in the
  # mailbox. Never a held nonce reused for a new link: whoever sat at this
  # browser before knows it.
  static def cookie_with(held, nonce)
    let kept = MagicLink.held_nonces(held)
    kept = kept.slice(kept.length - 3, kept.length) if kept.length > 3
    [...kept, nonce].join(".")
  end

  # The nonces a cookie holds: well-formed ones, the last four at most — a
  # cookie is the visitor's to write, and each piece costs a hash.
  static def held_nonces(cookie)
    let pieces = cookie.to_s.substring(0, 300).split(".").filter { |one| Regex.matches("^[0-9a-f]{64}$", one) }
    pieces = pieces.slice(pieces.length - 4, pieces.length) if pieces.length > 4
    pieces
  end

  # Whom `token` would sign in from the browser holding `nonce`, or nil —
  # without using the link up: what the page that asks "sign in as …?" reads.
  static def peek(token, nonce)
    let link = MagicLink.find_by("token_digest", Crypto.sha256(token.to_s))
    return nil if link.nil? || DateTime.utc.to_unix > link.expires_at

    let matching = MagicLink.held_nonces(nonce).filter { |one| Crypto.secure_compare(link.nonce_digest, Crypto.sha256(one)) }
    return nil if matching.length == 0

    User.find_by("_key", link.user_id)
  end

  # The user `token` signs in from the browser holding `nonce`, or nil. A
  # link opened elsewhere is left as it is; one opened here is used up, in
  # time or not.
  static def redeem(token, nonce)
    let digest = Crypto.sha256(token.to_s)
    let link = MagicLink.find_by("token_digest", digest)
    return nil if link.nil?
    # The cookie holds the nonces of this browser's last few requests
    # (`MagicLink.cookie_with`): any of them opens its own link.
    let matching = MagicLink.held_nonces(nonce).filter { |one| Crypto.secure_compare(link.nonce_digest, Crypto.sha256(one)) }
    return nil if matching.length == 0
    return nil unless MagicLink.claim(link, digest)

    let expired = DateTime.utc.to_unix > link.expires_at
    # Used up, for certain: a delete that did not happen — refused (false),
    # or the row already gone (an "Error: …" string) — signs nobody in.
    let deleted = link.delete
    return nil if expired || deleted == false || type(deleted) == "string"

    User.find_by("_key", link.user_id)
  end

  # Take `link` for this request, or answer false when another one took it
  # first. The write names the digest that was read: of two requests opening
  # the same link at once, one finds it changed. A delete alone does not
  # tell them apart on the SQL adapters, where removing a row that is
  # already gone succeeds; on SoliDB the delete that follows decides too.
  static def claim(link, digest)
    let mark = "claimed:#{Crypto.random_hex(16)}"
    auth_written(MagicLink.where({"_key": link._key, "token_digest": digest}).update_all({"token_digest": mark}))
    let now_holds = MagicLink.find_by("_key", link._key)
    !now_holds.nil? && now_holds.token_digest == mark
  end
end
