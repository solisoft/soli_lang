# MagicLink — a one-time sign-in link sent by email.
# Generated by `soli generate auth --magic-link`.
# Collection: magic_links
#
# A link works once, for MAGIC_LINK_TTL seconds, and only in the browser that
# asked for it: asking sets a cookie whose digest is stored with the link, and
# redeeming needs both. So a link read by a mail scanner, forwarded, or opened
# on another device signs nobody in — and is not used up by the attempt. Only
# digests are stored: a database leak cannot be replayed as a live link.

const MAGIC_LINK_TTL = 900  # a link lives 15 minutes

class MagicLink < Model
  # A fresh link for `user`, replacing any earlier one. Returns the two
  # secrets in plaintext, the only time they exist that way: `token` goes in
  # the email, `nonce` in the browser's cookie.
  static def issue(user)
    token = Crypto.random_hex(32)
    nonce = Crypto.random_hex(32)
    MagicLink.where({"user_id": user._key}).delete_all
    MagicLink.create({
      "user_id": user._key,
      "token_digest": Crypto.sha256(token),
      "nonce_digest": Crypto.sha256(nonce),
      "expires_at": DateTime.utc.to_unix + MAGIC_LINK_TTL
    })
    {"token": token, "nonce": nonce}
  end

  # The user `token` signs in from the browser holding `nonce`, or nil. A
  # link opened elsewhere is left as it is; one opened here is used up, in
  # time or not.
  static def redeem(token, nonce)
    link = MagicLink.find_by("token_digest", Crypto.sha256(token.to_s))
    return nil if link.nil?
    return nil unless Crypto.secure_compare(link.nonce_digest, Crypto.sha256(nonce.to_s))

    expired = DateTime.utc.to_unix > link.expires_at
    link.delete
    return nil if expired

    User.find_by("_key", link.user_id)
  end
end
