# ApiToken — a personal access token: a user's credential for scripts and
# other services. Generated by `soli generate auth --api-tokens`.
# Collection: api_tokens
#
# The token is shown once, when it is created, and only its SHA-256 digest is
# stored — it is 256 random bits, so a fast hash is enough and a database leak
# gives nothing usable. `prefix` is its first characters, kept to tell tokens
# apart in a list. A token carries scopes; what a scope allows is yours to
# decide, with `api_scope?("invoices:write")` in an action.
#
#   curl -H "Authorization: Bearer soli_pat_…" https://app.example.com/api/invoices
#
# app/middleware/api_token.sl authenticates the header.

const API_TOKEN_PREFIX = "soli_pat_"

# The scopes a token can be given. Edit to the ones your API has.
const API_TOKEN_SCOPES = ["read", "write"]

# Seconds between two writes of `last_used_at` for one token: every request
# need not cost a write.
const API_TOKEN_TOUCH_EVERY = 60

# Whether the request may do what `scope` covers. A request signed in with
# the session (a person in a browser) is not limited by scopes; one made with
# a token needs the token to carry it.
def api_scope?(scope)
  token = req["api_token"] rescue nil
  return true if token.nil?

  token.allows?(scope)
end

class ApiToken < Model
  validates("user_id", {"presence": true})
  validates("name", {"presence": true})

  # A new token for `user`. `scopes` outside API_TOKEN_SCOPES are dropped;
  # `days` is its lifetime, nil for none. Returns the record and the token in
  # plaintext, the only time it exists that way.
  static def issue(user, name, scopes, days)
    token = API_TOKEN_PREFIX + Crypto.random_hex(32)
    wanted = scopes ?? []
    record = ApiToken.create({
      "user_id": user._key,
      "name": name.to_s.trim,
      "prefix": token.substring(0, API_TOKEN_PREFIX.length + 6),
      "token_digest": Crypto.sha256(token),
      "scopes": API_TOKEN_SCOPES.filter { |scope| wanted.includes?(scope) },
      "expires_at": days.to_i > 0 ? DateTime.utc.to_unix + days.to_i * 86400 : nil,
      "last_used_at": nil
    })
    {"record": record, "token": token}
  end

  static def for_user(user)
    ApiToken.where({"user_id": user._key}).order("name", "asc").all
  end

  # The live token `bearer` is, or nil: unknown, or expired.
  static def authenticate(bearer)
    value = bearer.to_s
    return nil unless value.starts_with?(API_TOKEN_PREFIX)

    record = ApiToken.find_by("token_digest", Crypto.sha256(value))
    return nil if record.nil? || record.expired?

    record.touch
    record
  end

  def expired?
    !@expires_at.nil? && DateTime.utc.to_unix > @expires_at
  end

  def allows?(scope)
    granted = @scopes ?? []
    granted.includes?(scope)
  end

  # For the list: "read, write", "expires 2027-01-31", "last used 2026-11-15".
  def scopes_label
    granted = @scopes ?? []
    granted.length > 0 ? granted.join(", ") : "no scope"
  end

  def expiry_label
    return "no expiry" if @expires_at.nil?
    return "expired" if @expired?

    "expires " + DateTime.from_unix(@expires_at).to_iso.substring(0, 10)
  end

  def last_used_label
    return "never used" if @last_used_at.nil?

    "last used " + DateTime.from_unix(@last_used_at).to_iso.substring(0, 10)
  end

  # Note the use, at most once per API_TOKEN_TOUCH_EVERY seconds.
  def touch
    now = DateTime.utc.to_unix
    return if !@last_used_at.nil? && now - @last_used_at < API_TOKEN_TOUCH_EVERY

    @last_used_at = now
    @update
  end
end
