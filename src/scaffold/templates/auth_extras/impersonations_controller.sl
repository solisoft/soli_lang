# Impersonations controller — an administrator acts as a user, to see what
# they see. Generated by `soli generate auth --impersonation`.
#
# Who may: an administrator, on an account that is not one — change
# `_may_impersonate` to your own rule. While it lasts the session is the
# user's (`current_user()` is them) and remembers who is behind it
# (`impersonating?()`, `impersonator()`), which the banner partial shows on
# every page: render it in your layout,
#
#   <%- partial("impersonations/banner") %>
#
# Every start and stop is logged, and written to the audit log when the app
# has one (`soli generate audit`).

class ImpersonationsController < Controller
  # POST /impersonate/:id — start acting as a user
  def create
    admin = current_user()
    return redirect("/login") if admin.nil?

    target = User.find_by("_key", params["id"])
    return {"status": 403, "body": "Forbidden"} unless @_may_impersonate(admin, target)

    @_record("impersonate", admin, target)
    @_become(target)
    session_set("impersonator_id", admin._key)
    redirect("/")
  end

  # DELETE /impersonate — back to your own account
  def destroy
    admin_id = session_get("impersonator_id").to_s
    return redirect("/") if admin_id.blank?

    admin = User.find_by("_key", admin_id)
    target = current_user()
    if admin.nil?
      session_destroy()
      return redirect("/login")
    end

    @_record("stop_impersonating", admin, target) unless target.nil?
    @_become(admin)
    redirect("/")
  end

  private

  def _may_impersonate(admin, target)
    return false if target.nil? || !admin.admin?
    # Not from inside an impersonation, not yourself, not another administrator.
    return false if session_get("impersonator_id").to_s.present?
    return false if target._key == admin._key || target.admin?

    true
  end

  # Make the session `user`'s, under a new session id.
  def _become(user)
    session_regenerate()
    session_delete("impersonator_id")
    session_set("user_id", user._key)
    session_set("session_version", user.current_session_version)
    # Nobody signed in as this user just now: no auth_time for the OIDC provider.
    session_delete("auth_time")
    # The administrator passed their own second factor; the user's is not
    # theirs to give.
    session_set("two_factor", "ok:#{user._key}")
  end

  def _record(action, admin, target)
    Logger.info("#{action}: #{admin.email} -> #{target.email}")
    audit = const_get("Audit") rescue nil
    return if audit.nil?

    audit.record(action, target, {"by": [nil, admin.email]})
  end
end
