# API tokens controller — the signed-in user's personal access tokens.
# Generated by `soli generate auth --api-tokens`.
#
# Managing tokens takes a person in a browser: a request made with a token
# cannot list, create or revoke tokens, and neither can an administrator who
# is impersonating the user. An account that signs in through single sign-on
# only (`user.sso_only?`) gets no token: one would keep working after the
# user is removed at the identity provider.

class ApiTokensController < Controller
  static {
    this.layout = "application"
  }

  # GET /api_tokens
  def index
    user = @_person
    return redirect("/login") if user.nil?

    @_render(user, nil, "", 200)
  end

  # POST /api_tokens — create one; the token is shown this once
  def create
    user = @_person
    return redirect("/login") if user.nil?
    return @_render(user, nil, "A single sign-on account cannot have API tokens.", 403) if user.sso_only?
    return @_render(user, nil, "Give the token a name.", 422) if params["name"].to_s.trim.blank?
    # A token is a lasting way in: from a sign-in of the last few minutes.
    unless auth_fresh_sign_in?()
      return @_render(user, nil, "Sign in again to create a token (your last sign-in is too old).", 403)
    end

    scopes = API_TOKEN_SCOPES.filter { |scope| params["scope_#{scope}"].to_s == "1" }
    issued = ApiToken.issue(user, params["name"], scopes, params["days"])
    # A token the database did not store opens nothing: it is not shown.
    if (issued["record"]._errors ?? []).length > 0
      return @_render(user, nil, "The token could not be created. Try again.", 500)
    end
    # Not from a session that ended while this was written (a password
    # reset): the token would outlive it.
    return redirect("/login") unless auth_credential_kept?(user, issued["record"])

    @_render(user, issued["token"], "", 201)
  end

  # DELETE /api_tokens/:id — revoke
  def destroy
    user = @_person
    return redirect("/login") if user.nil?

    token = ApiToken.find_by("_key", params["id"])
    # Someone else's token answers exactly like a missing one.
    token.delete if !token.nil? && token.user_id == user._key
    redirect("/api_tokens")
  end

  private

  # The signed-in user, when the request comes from their own session.
  def _person
    return nil unless auth_own_session?(req)

    current_user()
  end

  def _render(user, new_token, error, status)
    render(
      "api_tokens/index",
      {
        "title": "API tokens",
        "tokens": ApiToken.for_user(user),
        "scopes": API_TOKEN_SCOPES,
        "new_token": new_token,
        "error": error
      },
      {"status": status}
    )
  end
end
