# API tokens controller — the signed-in user's personal access tokens.
# Generated by `soli generate auth --api-tokens`.
#
# Managing tokens takes a person in a browser: a request made with a token
# cannot list, create or revoke tokens, and neither can an administrator who
# is impersonating the user.

class ApiTokensController < Controller
  static {
    this.layout = "application"
  }

  # GET /api_tokens
  def index
    user = @_person
    return redirect("/login") if user.nil?

    @_render(user, nil, "", 200)
  end

  # POST /api_tokens — create one; the token is shown this once
  def create
    user = @_person
    return redirect("/login") if user.nil?
    return @_render(user, nil, "Give the token a name.", 422) if params["name"].to_s.trim.blank?

    scopes = API_TOKEN_SCOPES.filter { |scope| params["scope_#{scope}"].to_s == "1" }
    issued = ApiToken.issue(user, params["name"], scopes, params["days"])
    @_render(user, issued["token"], "", 201)
  end

  # DELETE /api_tokens/:id — revoke
  def destroy
    user = @_person
    return redirect("/login") if user.nil?

    token = ApiToken.find_by("_key", params["id"])
    # Someone else's token answers exactly like a missing one.
    token.delete if !token.nil? && token.user_id == user._key
    redirect("/api_tokens")
  end

  private

  # The signed-in user, when the request comes from their own session.
  def _person
    return nil unless (req["api_token"] rescue nil).nil?
    return nil if session_get("impersonator_id").to_s.present?

    current_user()
  end

  def _render(user, new_token, error, status)
    render(
      "api_tokens/index",
      {
        "title": "API tokens",
        "tokens": ApiToken.for_user(user),
        "scopes": API_TOKEN_SCOPES,
        "new_token": new_token,
        "error": error
      },
      {"status": status}
    )
  end
end
