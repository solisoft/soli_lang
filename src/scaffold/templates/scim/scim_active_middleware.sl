# Deactivated accounts — generated by `soli generate scim`.
#
# A user the directory deactivated (`active: false`) is nobody here: whatever
# signed them in — a session, a remember-me cookie, an API token, a provider —
# the request goes on as a guest's. Checking here rather than in each sign-in
# action covers them all, and the ones added later.
#
# Order 8: after the session's user (5), the two-factor gate (6) and API
# tokens (7).

# order: 8

def refuse_deactivated_users(req)
  user = req["current_user"]
  return req if user.nil? || user.deactivated_at.nil?

  req["current_user"] = nil
  req["api_token"] = nil
  req
end
