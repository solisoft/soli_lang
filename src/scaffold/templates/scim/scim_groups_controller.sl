# SCIM 2.0 Groups — the directory's groups and their members.
# Generated by `soli generate scim`.
#
# Authentication, errors and the response helpers are ScimController's. What a
# group gives a user is in app/models/scim_group.sl: nothing by itself, a role
# through SCIM_GROUP_ROLES, never `admin`.
#
# Member changes come as PATCH operations on `members`, in three shapes:
#
#   {"op": "add",    "path": "members", "value": [{"value": "<user id>"}]}
#   {"op": "remove", "path": "members", "value": [{"value": "<user id>"}]}
#   {"op": "remove", "path": "members[value eq \"<user id>\"]"}
#
# and `replace` on `members` sets the whole list. A `remove` on `members`
# with no value empties the group.

const SCIM_GROUP_SCHEMA = "urn:ietf:params:scim:schemas:core:2.0:Group"

class ScimGroupsController < ScimController
  # GET /scim/v2/Groups — list, or find by displayName
  def index
    return @_unauthorized if @_directory.nil?

    filter = params["filter"].to_s.trim
    if filter.present?
      matched = filter.match("^(?i)displayName\\s+eq\\s+\"(.*)\"$")
      return @_error(400, "Only `displayName eq` is supported", "invalidFilter") if matched.nil?

      group = ScimGroup.find_by("display_name", matched[1])
      found = group.nil? ? [] : [@_group(group)]
      return @_list(found, found.length, 1)
    end

    start = params["startIndex"].to_i > 0 ? params["startIndex"].to_i : 1
    count = params["count"].to_s.present? ? params["count"].to_i : SCIM_PAGE
    count = SCIM_PAGE if count > SCIM_PAGE || count < 0
    groups = ScimGroup.order("display_name", "asc").offset(start - 1).limit(count).all
    @_list(groups.map { |group| @_group(group) }, ScimGroup.count, start)
  end

  # GET /scim/v2/Groups/:id
  def show
    return @_unauthorized if @_directory.nil?

    group = ScimGroup.find_by("_key", params["id"])
    return @_error(404, "Group #{params["id"]} not found", nil) if group.nil?

    @_json(200, @_group(group))
  end

  # POST /scim/v2/Groups
  def create
    return @_unauthorized if @_directory.nil?

    body = @_body
    name = body["displayName"].to_s.trim
    return @_error(400, "displayName is required", "invalidValue") if name.blank?
    return @_error(409, "A group with that displayName exists", "uniqueness") unless ScimGroup.find_by("display_name", name).nil?

    group = ScimGroup.create({"display_name": name, "external_id": body["externalId"]})
    group.replace_members(@_member_ids(body["members"]))
    @_json(201, @_group(group))
  end

  # PUT /scim/v2/Groups/:id — replace, members included
  def replace
    return @_unauthorized if @_directory.nil?

    group = ScimGroup.find_by("_key", params["id"])
    return @_error(404, "Group #{params["id"]} not found", nil) if group.nil?

    body = @_body
    name = body["displayName"].to_s.trim
    return @_error(400, "displayName is required", "invalidValue") if name.blank?

    @_rename(group, name)
    group.external_id = body["externalId"] if body.has_key("externalId")
    group.save
    return @_error(400, "The group could not be saved: #{group._errors}", "invalidValue") if @_failed?(group)

    group.replace_members(@_member_ids(body["members"]))
    @_json(200, @_group(group))
  end

  # PATCH /scim/v2/Groups/:id — members in and out, or a new name
  def update
    return @_unauthorized if @_directory.nil?

    group = ScimGroup.find_by("_key", params["id"])
    return @_error(404, "Group #{params["id"]} not found", nil) if group.nil?

    operations = @_body["Operations"] ?? []
    operations.each do |operation|
      @_apply(group, operation["op"].to_s.downcase, operation["path"].to_s, operation["value"])
    end
    group.save
    return @_error(400, "The group could not be saved: #{group._errors}", "invalidValue") if @_failed?(group)

    @_json(200, @_group(group))
  end

  # DELETE /scim/v2/Groups/:id — its members lose what it gave, at once
  def destroy
    return @_unauthorized if @_directory.nil?

    group = ScimGroup.find_by("_key", params["id"])
    return @_error(404, "Group #{params["id"]} not found", nil) if group.nil?

    group.disband
    {"status": 204, "body": ""}
  end

  private

  # Did the last save leave errors? (`_errors` is nil or empty when it held.)
  def _failed?(record)
    (record._errors ?? []).length > 0
  end

  # One PATCH operation.
  def _apply(group, op, path, value)
    attribute = path.downcase
    one = path.match("^(?i)members\\[value\\s+eq\\s+\"(.*)\"\\]$")
    return group.remove(one[1]) if !one.nil? && op == "remove"

    if attribute == "members"
      ids = @_member_ids(value)
      return group.replace_members(ids) if op == "replace"
      return ids.each { |id| group.add(id) } if op == "add"
      return group.replace_members([]) if ids.length == 0

      return ids.each { |id| group.remove(id) }
    end
    return @_rename(group, value.to_s.trim) if attribute == "displayname" && value.to_s.present?

    group.external_id = value if attribute == "externalid"
    # No path: the attributes are in the value (Okta renames a group this way).
    return unless attribute.blank? && !value.nil?

    @_rename(group, value["displayName"].to_s.trim) if value["displayName"].to_s.present?
    group.external_id = value["externalId"] if value.has_key("externalId")
    group.replace_members(@_member_ids(value["members"])) if value.has_key("members")
  end

  # A new name changes what SCIM_GROUP_ROLES gives: recompute the members'.
  def _rename(group, name)
    return if group.display_name == name

    group.display_name = name
    group.save
    group.members.each { |user| ScimGroup.sync_role(user) }
  end

  # The user ids of a `members` value: [{"value": "<id>"}, …].
  def _member_ids(members)
    list = members ?? []
    # Only the accounts this directory manages (`_user`): a group cannot hand
    # its role to an administrator, a local account or another directory's.
    list.map { |member| member["value"].to_s }.filter { |id| id.present? && !@_user(id).nil? }
  end

  def _group(group)
    {
      "schemas": [SCIM_GROUP_SCHEMA],
      "id": group._key,
      "externalId": group.external_id,
      "displayName": group.display_name,
      "members": group.members.map { |user| {"value": user._key, "display": user.email} },
      "meta": {"resourceType": "Group", "location": "#{auth_base_url()}/scim/v2/Groups/#{group._key}"}
    }
  end
end
