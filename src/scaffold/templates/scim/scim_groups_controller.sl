# SCIM 2.0 Groups — the directory's groups and their members.
# Generated by `soli generate scim`.
#
# Authentication, errors and the response helpers are ScimController's. What a
# group gives a user is in app/models/scim_group.sl: nothing by itself, a role
# through SCIM_GROUP_ROLES, never `admin`.
#
# A directory sees and changes its own groups, and in them the accounts it
# manages — nothing else. Another directory's group is a 404, like another
# directory's user: a token must not hand its users a role through someone
# else's group, read who is in it, or take its members out.
#
# Member changes come as PATCH operations on `members`, in three shapes:
#
#   {"op": "add",    "path": "members", "value": [{"value": "<user id>"}]}
#   {"op": "remove", "path": "members", "value": [{"value": "<user id>"}]}
#   {"op": "remove", "path": "members[value eq \"<user id>\"]"}
#
# and `replace` on `members` sets the whole list. A `remove` on `members`
# with no value empties the group.

const SCIM_GROUP_SCHEMA = "urn:ietf:params:scim:schemas:core:2.0:Group"

class ScimGroupsController < ScimController
  # GET /scim/v2/Groups — list, or find by displayName
  def index
    return @_unauthorized if @_directory.nil?

    filter = params["filter"].to_s.trim
    if filter.present?
      matched = filter.match("^(?i)displayName\\s+eq\\s+\"(.*)\"$")
      return @_error(400, "Only `displayName eq` is supported", "invalidFilter") if matched.nil?

      group = ScimGroup.named(@_directory, matched[1])
      found = group.nil? ? [] : [@_group(group)]
      return @_list(found, found.length, 1)
    end

    start = params["startIndex"].to_i > 0 ? params["startIndex"].to_i : 1
    count = params["count"].to_s.present? ? params["count"].to_i : SCIM_PAGE
    count = SCIM_PAGE if count > SCIM_PAGE || count < 0
    mine = {"scim_directory": @_directory}
    groups = ScimGroup.where(mine).order("display_name", "asc").offset(start - 1).limit(count).all
    @_list(groups.map { |group| @_group(group) }, ScimGroup.where(mine).count, start)
  end

  # GET /scim/v2/Groups/:id
  def show
    return @_unauthorized if @_directory.nil?

    group = ScimGroup.of(@_directory, params["id"])
    return @_error(404, "Group #{params["id"]} not found", nil) if group.nil?

    @_json(200, @_group(group))
  end

  # POST /scim/v2/Groups
  def create
    return @_unauthorized if @_directory.nil?

    body = @_body
    name = body["displayName"].to_s.trim
    return @_error(400, "displayName is required", "invalidValue") if name.blank?
    return @_error(409, "A group with that displayName exists", "uniqueness") unless ScimGroup.named(@_directory, name).nil?

    group = ScimGroup.create({
      "display_name": name,
      "external_id": body["externalId"],
      "scim_directory": @_directory
    })
    return @_error(400, "The group could not be created", "invalidValue") if @_failed?(group)

    group.replace_members(@_member_ids(body["members"]))
    @_json(201, @_group(group))
  end

  # PUT /scim/v2/Groups/:id — replace, members included
  def replace
    return @_unauthorized if @_directory.nil?

    group = ScimGroup.of(@_directory, params["id"])
    return @_error(404, "Group #{params["id"]} not found", nil) if group.nil?

    body = @_body
    name = body["displayName"].to_s.trim
    return @_error(400, "displayName is required", "invalidValue") if name.blank?
    return @_error(409, "A group with that displayName exists", "uniqueness") if @_name_taken?(group, name)

    @_rename(group, name)
    group.external_id = body["externalId"] if body.has_key("externalId")
    group.save
    return @_error(400, "The group could not be saved: #{group._errors}", "invalidValue") if @_failed?(group)

    group.replace_members(@_member_ids(body["members"]))
    @_json(200, @_group(group))
  end

  # PATCH /scim/v2/Groups/:id — members in and out, or a new name
  def update
    return @_unauthorized if @_directory.nil?

    group = ScimGroup.of(@_directory, params["id"])
    return @_error(404, "Group #{params["id"]} not found", nil) if group.nil?

    operations = @_body["Operations"] ?? []
    operations.each do |operation|
      @_apply(group, operation["op"].to_s.downcase, operation["path"].to_s, operation["value"])
    end
    group.save
    return @_error(400, "The group could not be saved: #{group._errors}", "invalidValue") if @_failed?(group)

    @_json(200, @_group(group))
  end

  # DELETE /scim/v2/Groups/:id — its members lose what it gave, at once
  def destroy
    return @_unauthorized if @_directory.nil?

    group = ScimGroup.of(@_directory, params["id"])
    return @_error(404, "Group #{params["id"]} not found", nil) if group.nil?

    group.disband
    {"status": 204, "body": ""}
  end

  private

  # Did the last save leave errors? (`_errors` is nil or empty when it held.)
  def _failed?(record)
    (record._errors ?? []).length > 0
  end

  # One PATCH operation.
  def _apply(group, op, path, value)
    attribute = path.downcase
    one = path.match("^(?i)members\\[value\\s+eq\\s+\"(.*)\"\\]$")
    if !one.nil? && op == "remove"
      # Through `_member_ids`, like every other shape: an account this
      # directory does not manage is not taken out of anything, nor has its
      # role recomputed.
      return @_members_named(group, [{"value": one[1]}]).each { |id| group.remove(id) }
    end

    if attribute == "members"
      ids = @_member_ids(value)
      return group.replace_members(ids) if op == "replace"
      return ids.each { |id| group.add(id) } if op == "add"
      # "Remove" with no value empties the group. With a value that names
      # nobody this directory manages (a user it deleted since), it removes
      # nobody: not everyone.
      named = type(value) == "array" ? value.length : (value.nil? ? 0 : 1)
      return group.replace_members([]) if named == 0

      # Whoever is in the group, managed or not any more (promoted to
      # administrator since, say): a member the directory cannot see must
      # not be one it cannot take out.
      return @_members_named(group, value).each { |id| group.remove(id) }
    end
    return @_rename(group, value.to_s.trim) if attribute == "displayname" && value.to_s.present?

    group.external_id = value if attribute == "externalid"
    # No path: the attributes are in the value (Okta renames a group this way).
    return unless attribute.blank? && !value.nil?

    @_rename(group, value["displayName"].to_s.trim) if value["displayName"].to_s.present?
    group.external_id = value["externalId"] if value.has_key("externalId")
    group.replace_members(@_member_ids(value["members"])) if value.has_key("members")
  end

  # Is `name` another group's, in this directory?
  def _name_taken?(group, name)
    other = ScimGroup.named(@_directory, name)
    !other.nil? && other._key != group._key
  end

  # A new name changes what SCIM_GROUP_ROLES gives: recompute the members'.
  def _rename(group, name)
    return if group.display_name == name
    # Another group of the directory has it: the name stays.
    return if @_name_taken?(group, name)

    group.display_name = name
    group.save
    group.members.each { |user| ScimGroup.sync_role(user) }
  end

  # The user ids of a `members` value: [{"value": "<id>"}, …].
  def _member_ids(members)
    list = members ?? []
    # One member given as an object rather than a list of one.
    list = [members] if type(members) == "hash"
    return [] unless type(list) == "array"

    # Only the accounts this directory manages (`_user`): a group cannot hand
    # its role to an administrator, a local account or another directory's.
    # And only those it has taken charge of: with SCIM_ADOPT_EXISTING an
    # account it merely could adopt is in its reach, but a group must not
    # give a role to one that still holds what its maker set on it — the
    # directory updates the user first, which adopts it.
    list.filter { |member| type(member) == "hash" }
      .map { |member| member["value"].to_s }
      .filter { |id| id.present? && @_provisioned?(id) }
  end

  # The ids of `members` that are in `group` now — to take out. Not through
  # `_member_ids`: that is who may be put in. An id that is not a member is
  # left alone (taking it "out" would only recompute a stranger's role).
  def _members_named(group, members)
    list = type(members) == "hash" ? [members] : (members ?? [])
    return [] unless type(list) == "array"

    list.filter { |member| type(member) == "hash" }
      .map { |member| member["value"].to_s }
      .filter { |id| id.present? && ScimMembership.where({"group_id": group._key, "user_id": id}).count > 0 }
  end

  def _provisioned?(id)
    user = @_user(id)
    !user.nil? && !user.scim_provisioned_at.nil?
  end

  def _group(group)
    {
      "schemas": [SCIM_GROUP_SCHEMA],
      "id": group._key,
      "externalId": group.external_id,
      "displayName": group.display_name,
      # Those this directory manages: an account that left its reach since
      # is not named to it.
      "members": group.members.filter { |user| @_manages?(user) }
        .map { |user| {"value": user._key, "display": user.email} },
      "meta": {"resourceType": "Group", "location": "#{auth_base_url()}/scim/v2/Groups/#{group._key}"}
    }
  end
end
