# ScimGroup — a group of the organisation's directory, and who is in it.
# Generated by `soli generate scim`.
# Collections: scim_groups, scim_memberships
#
# The directory creates groups and moves users in and out of them
# (/scim/v2/Groups). What a group means here is the app's to say, two ways:
#
# - read them: `ScimGroup.names_for(user)` in a policy or a controller;
# - map them to the account's role: SCIM_GROUP_ROLES below.
#
# A directory never makes an administrator. `admin` is granted in the app: a
# mapping to it is ignored, and an account that is an administrator keeps its
# role whatever its groups say. Otherwise a compromised or misconfigured
# directory would hand out the app's administration.
#
# A user who leaves a group, or whose group is deleted, loses what it gave at
# once: the role is recomputed on every change.

# A group belongs to the directory that created it (`scim_directory`, the
# name of its token): another directory does not see it, cannot put its
# users in it, and cannot empty it. Two directories may each have a group of
# the same name.
#
# Group display name => role. A user in several mapped groups gets the role
# of the last one listed here that they are in; in none, "member". A name
# stands for that group in every directory; "okta/Finance" for the one of
# the directory named `okta` only. A key with a `/` is always read that way
# — directory, then name — so a group another directory names "okta/Finance"
# is not it.
#
#   const SCIM_GROUP_ROLES = {"Finance": "accountant", "okta/Support": "agent"}
const SCIM_GROUP_ROLES = {}

class ScimMembership < Model
end

class ScimGroup < Model
  # Unique within its directory: the controller checks before it creates.
  validates("display_name", {"presence": true})

  # The group `id` names, if `directory` owns it — nil otherwise, so another
  # directory's group reads exactly as one that does not exist.
  static def of(directory, id)
    group = ScimGroup.find_by("_key", id.to_s)
    return nil if group.nil? || directory.to_s.blank? || group.scim_directory.to_s != directory.to_s

    group
  end

  static def named(directory, name)
    ScimGroup.where({"scim_directory": directory.to_s, "display_name": name.to_s}).first
  end

  # The groups `user` is in.
  static def for_user(user)
    ScimMembership.where({"user_id": user._key}).all
      .map { |membership| ScimGroup.find_by("_key", membership.group_id) }
      .filter { |group| !group.nil? }
  end

  # Their names, for a policy: `ScimGroup.names_for(user).includes?("Finance")`.
  static def names_for(user)
    ScimGroup.for_user(user).map { |group| group.display_name }
  end

  # Is `user` in the group a SCIM_GROUP_ROLES key names? "Finance" is that
  # group in any directory; "okta/Finance" the one of `okta` — matched on
  # the directory and the name, never on a display name that spells both.
  static def in_mapped_group?(groups, key)
    parts = key.split("/")
    if parts.length < 2
      return groups.filter { |group| group.display_name == key }.length > 0
    end

    # The directory is what precedes the first `/`; the rest is the name.
    # A directory's name is ASCII and has no `/` (`_tokens` in the SCIM
    # controller refuses any other), which is what makes this cut right:
    # `length` counts bytes and `substring` characters, and for ASCII the
    # two agree.
    directory = parts[0]
    name = key.substring(directory.length + 1, key.length)
    groups.filter { |group| group.scim_directory.to_s == directory && group.display_name == name }.length > 0
  end

  # The role `user`'s groups give now: the last mapped one, or "member".
  static def role_for(user)
    groups = ScimGroup.for_user(user)
    role = "member"
    SCIM_GROUP_ROLES.keys.each do |name|
      mapped = SCIM_GROUP_ROLES[name]
      role = mapped if mapped != "admin" && ScimGroup.in_mapped_group?(groups, name)
    end
    role
  end

  # Set the account's role from its groups (SCIM_GROUP_ROLES). An
  # administrator is left alone, and no group makes one.
  static def sync_role(user)
    return if user.admin?

    # Computed, written, and computed again: two memberships of one user
    # changed at the same moment each compute the role from what they read,
    # and the one that writes last may have read the older state. The loop
    # ends when what was written is what the memberships now say.
    attempts = 0
    while attempts < 3
      attempts = attempts + 1
      role = ScimGroup.role_for(user)
      if user.role != role
        user.role = role
        # The role and nothing else: the whole record, written back as this
        # request loaded it, would undo a deactivation or a password reset
        # that happened meanwhile. (Never an administrator's: checked above,
        # and again in the write. A role that was never set is not `admin`
        # either: on SQL, `<>` alone does not match it.)
        not_admin = {"_key": user._key, "or": [{"role": {"ne": "admin"}}, {"role": nil}]}
        written = User.where(not_admin).update_all({"role": role})
        throw written if type(written) == "string" && written.starts_with?("Error:")
      end
      break if ScimGroup.role_for(user) == role
    end
  end

  # The users in this group.
  def members
    ScimMembership.where({"group_id": @_key}).all
      .map { |membership| User.find_by("_key", membership.user_id) }
      .filter { |user| !user.nil? }
  end

  # Put a user in the group. Unknown users are skipped. Idempotent.
  # (The controller hands in only users the group's directory manages.)
  def add(user_id)
    user = User.find_by("_key", user_id.to_s)
    return if user.nil?

    existing = ScimMembership.where({"group_id": @_key, "user_id": user._key}).first
    ScimMembership.create({"group_id": @_key, "user_id": user._key}) if existing.nil?
    ScimGroup.sync_role(user)
  end

  # Take a user out of the group; what the group gave goes with it.
  def remove(user_id)
    ScimMembership.where({"group_id": @_key, "user_id": user_id.to_s}).delete_all
    user = User.find_by("_key", user_id.to_s)
    ScimGroup.sync_role(user) unless user.nil?
  end

  # Make the group's members exactly `user_ids`.
  def replace_members(user_ids)
    wanted = user_ids.map { |id| id.to_s }
    current = @members.map { |user| user._key }
    current.each do |id|
      @remove(id) unless wanted.includes?(id)
    end
    wanted.each do |id|
      @add(id) unless current.includes?(id)
    end
  end

  # Delete the group: its members leave it first, and lose what it gave.
  def disband
    @replace_members([])
    @delete
  end
end
