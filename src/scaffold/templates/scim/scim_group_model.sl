# ScimGroup — a group of the organisation's directory, and who is in it.
# Generated by `soli generate scim`.
# Collections: scim_groups, scim_memberships
#
# The directory creates groups and moves users in and out of them
# (/scim/v2/Groups). What a group means here is the app's to say, two ways:
#
# - read them: `ScimGroup.names_for(user)` in a policy or a controller;
# - map them to the account's role: SCIM_GROUP_ROLES below.
#
# A directory never makes an administrator. `admin` is granted in the app: a
# mapping to it is ignored, and an account that is an administrator keeps its
# role whatever its groups say. Otherwise a compromised or misconfigured
# directory would hand out the app's administration.
#
# A user who leaves a group, or whose group is deleted, loses what it gave at
# once: the role is recomputed on every change.

# Group display name => role. A user in several mapped groups gets the role
# of the last one listed here that they are in; in none, "member".
#
#   const SCIM_GROUP_ROLES = {"Finance": "accountant", "Support": "agent"}
const SCIM_GROUP_ROLES = {}

class ScimMembership < Model
end

class ScimGroup < Model
  validates("display_name", {"presence": true, "uniqueness": true})

  # The groups `user` is in.
  static def for_user(user)
    ScimMembership.where({"user_id": user._key}).all
      .map { |membership| ScimGroup.find_by("_key", membership.group_id) }
      .filter { |group| !group.nil? }
  end

  # Their names, for a policy: `ScimGroup.names_for(user).includes?("Finance")`.
  static def names_for(user)
    ScimGroup.for_user(user).map { |group| group.display_name }
  end

  # Set the account's role from its groups (SCIM_GROUP_ROLES). An
  # administrator is left alone, and no group makes one.
  static def sync_role(user)
    return if user.admin?

    names = ScimGroup.names_for(user)
    role = "member"
    SCIM_GROUP_ROLES.keys.each do |name|
      mapped = SCIM_GROUP_ROLES[name]
      role = mapped if names.includes?(name) && mapped != "admin"
    end
    return if user.role == role

    user.role = role
    user.save
  end

  # The users in this group.
  def members
    ScimMembership.where({"group_id": @_key}).all
      .map { |membership| User.find_by("_key", membership.user_id) }
      .filter { |user| !user.nil? }
  end

  # Put a user in the group. Unknown users are skipped. Idempotent.
  def add(user_id)
    user = User.find_by("_key", user_id.to_s)
    return if user.nil?

    existing = ScimMembership.where({"group_id": @_key, "user_id": user._key}).first
    ScimMembership.create({"group_id": @_key, "user_id": user._key}) if existing.nil?
    ScimGroup.sync_role(user)
  end

  # Take a user out of the group; what the group gave goes with it.
  def remove(user_id)
    ScimMembership.where({"group_id": @_key, "user_id": user_id.to_s}).delete_all
    user = User.find_by("_key", user_id.to_s)
    ScimGroup.sync_role(user) unless user.nil?
  end

  # Make the group's members exactly `user_ids`.
  def replace_members(user_ids)
    wanted = user_ids.map { |id| id.to_s }
    current = @members.map { |user| user._key }
    current.each do |id|
      @remove(id) unless wanted.includes?(id)
    end
    wanted.each do |id|
      @add(id) unless current.includes?(id)
    end
  end

  # Delete the group: its members leave it first, and lose what it gave.
  def disband
    @replace_members([])
    @delete
  end
end
