# SCIM 2.0 — the organisation's directory (Okta, Microsoft Entra ID…) creates,
# updates and deactivates this app's users. Generated by `soli generate scim`.
#
# A directory authenticates with a bearer token of its own:
#
#   SCIM_TOKEN=<32+ characters>                  one directory
#   SCIM_TOKENS=okta=<token>,entra=<token>       several, each named
#
# A token shorter than 32 characters is ignored, so a forgotten placeholder
# opens nothing. The base URL to give the directory is APP_BASE_URL/scim/v2.
#
# What a directory's user maps to: `userName` is the account's email;
# `active: false` deactivates it (app/middleware/scim_active.sl then treats
# any session or token of theirs as a guest's, and their sessions are
# closed); `externalId`, the names and `displayName` are kept on the user.
# An account a directory creates is a member with no password: it signs in
# through SAML, OAuth or a link, or sets a password with a reset link. Its
# first SAML sign-in links it (`soli generate saml`), and, if it has no
# password then, marks it single sign-on only.
#
# Groups are in app/controllers/scim_groups_controller.sl. No bulk, no
# sorting, no ETags. The filter is `userName eq "…"` or `externalId eq "…"`,
# which is what directories send.

const SCIM_USER_SCHEMA = "urn:ietf:params:scim:schemas:core:2.0:User"
const SCIM_LIST_SCHEMA = "urn:ietf:params:scim:api:messages:2.0:ListResponse"
const SCIM_ERROR_SCHEMA = "urn:ietf:params:scim:api:messages:2.0:Error"
const SCIM_PAGE = 100  # users per page, at most

class ScimController < Controller
  # GET /scim/v2/ServiceProviderConfig
  def service_provider_config
    return @_unauthorized if @_directory.nil?

    @_json(
      200,
      {
        "schemas": ["urn:ietf:params:scim:schemas:core:2.0:ServiceProviderConfig"],
        "patch": {"supported": true},
        "bulk": {
          "supported": false,
          "maxOperations": 0,
          "maxPayloadSize": 0
        },
        "filter": {"supported": true, "maxResults": SCIM_PAGE},
        "changePassword": {"supported": false},
        "sort": {"supported": false},
        "etag": {"supported": false},
        "authenticationSchemes": [{
          "type": "oauthbearertoken",
          "name": "Bearer token",
          "description": "A token issued to the directory, in the Authorization header"
        }]
      }
    )
  end

  # GET /scim/v2/ResourceTypes
  def resource_types
    return @_unauthorized if @_directory.nil?

    @_list([{
      "schemas": ["urn:ietf:params:scim:schemas:core:2.0:ResourceType"],
      "id": "User",
      "name": "User",
      "endpoint": "/Users",
      "schema": SCIM_USER_SCHEMA
    }, {
      "schemas": ["urn:ietf:params:scim:schemas:core:2.0:ResourceType"],
      "id": "Group",
      "name": "Group",
      "endpoint": "/Groups",
      "schema": "urn:ietf:params:scim:schemas:core:2.0:Group"
    }], 2, 1)
  end

  # GET /scim/v2/Schemas
  def schemas
    return @_unauthorized if @_directory.nil?

    described = {
      "User": ["userName", "externalId", "displayName", "name", "emails", "active", "groups"],
      "Group": ["displayName", "externalId", "members"]
    }
    @_list(described.keys.map { |name| @_schema(name, described[name]) }, 2, 1)
  end

  # GET /scim/v2/Users — list, or find by userName / externalId
  def index
    return @_unauthorized if @_directory.nil?

    filter = params["filter"].to_s.trim
    if filter.present?
      matched = filter.match("^(?i)(userName|externalId)\\s+eq\\s+\"(.*)\"$")
      return @_error(400, "Only `userName eq` and `externalId eq` are supported", "invalidFilter") if matched.nil?

      user = @_find(matched[1].downcase, matched[2])
      found = user.nil? ? [] : [@_resource(user)]
      return @_list(found, found.length, 1)
    end

    start = params["startIndex"].to_i > 0 ? params["startIndex"].to_i : 1
    count = params["count"].to_s.present? ? params["count"].to_i : SCIM_PAGE
    count = SCIM_PAGE if count > SCIM_PAGE || count < 0
    users = User.order("email", "asc").offset(start - 1).limit(count).all
    @_list(users.map(&{ |user|
      @_resource(user)
    }), User.count, start)
  end

  # GET /scim/v2/Users/:id
  def show
    return @_unauthorized if @_directory.nil?

    user = User.find_by("_key", params["id"])
    return @_error(404, "User #{params["id"]} not found", nil) if user.nil?

    @_json(200, @_resource(user))
  end

  # POST /scim/v2/Users
  def create
    return @_unauthorized if @_directory.nil?

    body = @_body
    email = @_email_of(body)
    return @_error(400, "userName is required", "invalidValue") if email.blank?
    return @_error(409, "A user with that userName exists", "uniqueness") unless User.find_by("email", email).nil?

    user = User.new
    user.email = email
    user.role = "member"
    # The directory vouches for the address.
    user.confirmed_at = DateTime.utc.to_unix
    # Marks a directory account: its first SAML sign-in may link it with
    # SAML_LINK_EXISTING off, when its externalId is the NameID or
    # SAML_LINK_DIRECTORY=on (`SamlSso.directory_link?`).
    user.scim_provisioned_at = DateTime.utc.to_unix
    @_assign(user, body)
    user.save
    return @_error(400, "The user could not be created", "invalidValue") if user._errors

    @_json(201, @_resource(user))
  end

  # PUT /scim/v2/Users/:id — replace
  def replace
    return @_unauthorized if @_directory.nil?

    user = User.find_by("_key", params["id"])
    return @_error(404, "User #{params["id"]} not found", nil) if user.nil?

    body = @_body
    email = @_email_of(body)
    return @_error(400, "userName is required", "invalidValue") if email.blank?

    taken = User.find_by("email", email)
    if !taken.nil? && taken._key != user._key
      return @_error(409, "A user with that userName exists", "uniqueness")
    end

    user.email = email
    @_assign(user, body)
    user.save
    @_json(200, @_resource(user))
  end

  # PATCH /scim/v2/Users/:id — what directories use to deactivate
  def update
    return @_unauthorized if @_directory.nil?

    user = User.find_by("_key", params["id"])
    return @_error(404, "User #{params["id"]} not found", nil) if user.nil?

    operations = @_body["Operations"] ?? []
    operations.each do |operation|
      path = operation["path"].to_s
      value = operation["op"].to_s.downcase == "remove" ? nil : operation["value"]
      if path.blank?
        # Okta's shape: no path, the attributes in the value.
        @_assign(user, value ?? {})
      else
        @_set(user, path, value)
      end
    end
    user.save
    @_json(200, @_resource(user))
  end

  # DELETE /scim/v2/Users/:id
  def destroy
    return @_unauthorized if @_directory.nil?

    user = User.find_by("_key", params["id"])
    return @_error(404, "User #{params["id"]} not found", nil) if user.nil?

    # The account goes. To keep what it owns, deactivate here instead:
    # `@_set_active(user, false)` then `user.save`.
    ScimMembership.where({"user_id": user._key}).delete_all
    user.delete
    {"status": 204, "body": ""}
  end

  private

  # The name of the directory whose token the request carries, or nil.
  def _directory
    header = req["headers"]["authorization"].to_s
    return nil unless header.starts_with?("Bearer ")

    given = Crypto.sha256(header.substring(7, header.length).trim)
    tokens = @_tokens
    found = nil
    tokens.keys.each do |name|
      found = name if Crypto.secure_compare(Crypto.sha256(tokens[name]), given)
    end
    found
  end

  # The directories' tokens, by name. Tokens under 32 characters are left out.
  def _tokens
    tokens = {}
    single = getenv("SCIM_TOKEN").to_s.trim
    tokens["default"] = single if single.length >= 32
    getenv("SCIM_TOKENS").to_s.split(",").each do |pair|
      parts = pair.trim.split("=")
      next unless parts.length == 2 && parts[1].trim.length >= 32

      tokens[parts[0].trim] = parts[1].trim
    end
    tokens
  end

  def _schema(name, attributes)
    {
      "schemas": ["urn:ietf:params:scim:schemas:core:2.0:Schema"],
      "id": "urn:ietf:params:scim:schemas:core:2.0:#{name}",
      "name": name,
      "attributes": attributes.map { |attribute| {"name": attribute, "mutability": "readWrite"} }
    }
  end

  # The user a filter names, or nil.
  def _find(attribute, value)
    return User.find_by("email", value.downcase) if attribute == "username"

    User.find_by("scim_external_id", value)
  end

  # The request body. Directories send `application/scim+json`.
  def _body
    body = req["json"]
    body = json_parse(req["body"].to_s) rescue nil if body.nil?
    body ?? {}
  end

  # The address a resource names: its userName, else its primary email.
  def _email_of(body)
    name = body["userName"].to_s.trim.downcase
    return name if name.present?

    emails = body["emails"] ?? []
    emails.length > 0 ? emails[0]["value"].to_s.trim.downcase : ""
  end

  # Take what a whole resource (or a path-less patch) says about the user.
  def _assign(user, body)
    user.scim_external_id = body["externalId"] if body.has_key("externalId")
    user.email = body["userName"].to_s.trim.downcase if body["userName"].to_s.present?
    user.name = body["displayName"] if body.has_key("displayName")
    name = body["name"]
    unless name.nil?
      user.scim_given_name = name["givenName"] if name.has_key("givenName")
      user.scim_family_name = name["familyName"] if name.has_key("familyName")
      user.name = name["formatted"] if name["formatted"].to_s.present?
    end
    @_set_active(user, body["active"]) if body.has_key("active")
  end

  # Apply one patch operation that names its attribute.
  def _set(user, path, value)
    attribute = path.downcase
    return @_set_active(user, value) if attribute == "active"

    user.scim_external_id = value if attribute == "externalid"
    user.name = value if attribute == "displayname" || attribute == "name.formatted"
    user.scim_given_name = value if attribute == "name.givenname"
    user.scim_family_name = value if attribute == "name.familyname"
    # `userName`, or an email path such as `emails[type eq "work"].value`.
    if (attribute == "username" || attribute.starts_with?("emails")) && value.to_s.present?
      user.email = value.to_s.trim.downcase
    end
  end

  # Deactivate or reactivate. A deactivated account's sessions are closed and
  # its remember-me cookie forgotten; app/middleware/scim_active.sl keeps it
  # out from then on. Entra sends the flag as the string "False".
  def _set_active(user, value)
    active = value.to_s.downcase == "true"
    if active
      user.deactivated_at = nil
      return
    end
    return unless user.deactivated_at.nil?

    user.deactivated_at = DateTime.utc.to_unix
    user.session_version = user.current_session_version + 1
    user.remember_token_digest = nil
  end

  def _resource(user)
    {
      "schemas": [SCIM_USER_SCHEMA],
      "id": user._key,
      "externalId": user.scim_external_id,
      "userName": user.email,
      "displayName": user.name,
      "name": {"givenName": user.scim_given_name, "familyName": user.scim_family_name},
      "emails": [{"value": user.email, "primary": true}],
      "active": user.deactivated_at.nil?,
      # Read-only here: membership is changed on the group.
      "groups": ScimGroup.for_user(user).map { |group| {"value": group._key, "display": group.display_name} },
      "meta": {"resourceType": "User", "location": "#{auth_base_url()}/scim/v2/Users/#{user._key}"}
    }
  end

  def _list(resources, total, start)
    @_json(
      200,
      {
        "schemas": [SCIM_LIST_SCHEMA],
        "totalResults": total,
        "startIndex": start,
        "itemsPerPage": resources.length,
        "Resources": resources
      }
    )
  end

  def _json(status, body)
    {
      "status": status,
      "headers": {"Content-Type": "application/scim+json"},
      "body": json_stringify(body)
    }
  end

  def _error(status, detail, scim_type)
    body = {
      "schemas": [SCIM_ERROR_SCHEMA],
      "status": status.to_s,
      "detail": detail
    }
    body["scimType"] = scim_type unless scim_type.nil?
    @_json(status, body)
  end

  def _unauthorized
    response = @_error(401, "A valid bearer token is required", nil)
    response["headers"]["WWW-Authenticate"] = "Bearer"
    response
  end
end
