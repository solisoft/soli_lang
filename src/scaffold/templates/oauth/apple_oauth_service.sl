# Sign in with Apple (authorization code + PKCE S256).
# Generated by: soli generate oauth apple
#
# Env: APPLE_CLIENT_ID      the Services ID (com.example.app.web)
#      APPLE_TEAM_ID        your developer team
#      APPLE_KEY_ID         the id of the "Sign in with Apple" key
#      APPLE_PRIVATE_KEY    that key's .p8 contents (PEM; `\n` for newlines),
#                           or APPLE_PRIVATE_KEY_FILE, its path inside the app
#                           (the server reads no file outside it) — keep it
#                           out of version control
#      APPLE_REDIRECT_URI   https://your.app/auth/apple/callback
#
# Three things set Apple apart from the other providers:
#
# - There is no client secret to copy: it is a short-lived JWT this service
#   signs with your key (ES256), minted for each token exchange.
# - With the `name email` scope Apple posts its answer (form_post) instead of
#   redirecting. The controller turns that POST into a GET of the same URL.
# - The name comes once, with the first sign-in, in that posted answer; the
#   email comes in the id_token every time. There is no userinfo endpoint.
#
# The id_token is read without checking its signature, on purpose: it arrives
# from Apple's token endpoint over TLS, in answer to this server's own request
# (OpenID Connect Core §3.1.3.7 allows exactly that). Its issuer, audience and
# expiry are still checked.

const APPLE_ISSUER = "https://appleid.apple.com"

class AppleOauth
  static def private_key
    path = getenv("APPLE_PRIVATE_KEY_FILE").to_s
    return File.read(path) if path.present?

    getenv("APPLE_PRIVATE_KEY").to_s.replace("\\n", "\n")
  end

  # The client secret: a JWT naming the team, the client and Apple, signed
  # with the key. Five minutes is plenty for one exchange.
  static def client_secret
    jwt_sign({"sub": getenv("APPLE_CLIENT_ID").to_s}, "", {
      "algorithm": "ES256",
      "key": AppleOauth.private_key,
      "kid": getenv("APPLE_KEY_ID").to_s,
      "iss": getenv("APPLE_TEAM_ID").to_s,
      "aud": APPLE_ISSUER,
      "expires_in": 300
    })
  end

  static def base_url
    url = getenv("APPLE_BASE_URL").to_s.trim
    url.present? ? url : APPLE_ISSUER
  end

  static def authorize_url(state, code_challenge = nil)
    query = [
      "client_id=#{url_encode(getenv("APPLE_CLIENT_ID").to_s)}",
      "redirect_uri=#{url_encode(getenv("APPLE_REDIRECT_URI").to_s)}",
      "response_type=code",
      "response_mode=form_post",
      "scope=#{url_encode("name email")}",
      "state=#{url_encode(state)}",
      "code_challenge=#{url_encode(code_challenge.to_s)}",
      "code_challenge_method=S256"
    ]

    "#{AppleOauth.base_url}/auth/authorize?#{query.join("&")}"
  end

  static def exchange_code(code)
    body = [
      "code=#{url_encode(code)}",
      "client_id=#{url_encode(getenv("APPLE_CLIENT_ID").to_s)}",
      "client_secret=#{url_encode(AppleOauth.client_secret)}",
      "redirect_uri=#{url_encode(getenv("APPLE_REDIRECT_URI").to_s)}",
      "grant_type=authorization_code",
      "code_verifier=#{url_encode(OauthSso.pkce_verifier.to_s)}"
    ].join("&")
    response = HTTP.request(
      "POST",
      "#{AppleOauth.base_url}/auth/token",
      {"Content-Type": "application/x-www-form-urlencoded", "Accept": "application/json"},
      body
    )
    status = response["status"]
    throw "Apple token exchange failed (HTTP #{status}): #{response["body"]}" unless status >= 200 && status < 300

    json_parse(response["body"].to_s)
  end

  # The claims of the id_token, held to this app: Apple issued it, for this
  # client, and it has not expired.
  static def identity(id_token)
    decoded = jwt_decode_unsafe(id_token.to_s)
    throw "Apple sent no readable id_token" if decoded["error"]

    claims = decoded["claims"]
    throw "Apple id_token: wrong issuer" unless claims["iss"] == APPLE_ISSUER
    throw "Apple id_token: issued for another client" unless claims["aud"] == getenv("APPLE_CLIENT_ID").to_s
    throw "Apple id_token: expired" unless claims["exp"].to_i > DateTime.utc.to_unix

    claims
  end

  # "First Last" from the `user` field Apple posts with a first sign-in, or nil.
  static def posted_name
    posted = json_parse(params["user"].to_s) rescue nil
    return nil if posted.nil? || posted["name"].nil?

    full = "#{posted["name"]["firstName"]} #{posted["name"]["lastName"]}".trim
    full.present? ? full : nil
  end

  static def complete!(code)
    token_data = AppleOauth.exchange_code(code)
    if token_data["error"]
      throw "Apple token exchange failed: #{token_data["error_description"] || token_data["error"]}"
    end

    claims = AppleOauth.identity(token_data["id_token"])
    # Apple sends the flag as a boolean or as the string "true".
    # An unverified address links nothing; the identity still signs in once linked.
    email = claims["email_verified"].to_s == "true" ? claims["email"] : nil
    user = OauthSso.find_or_create_user("apple", claims["sub"], email, AppleOauth.posted_name, claims)
    OauthSso.sign_in(user)
    user
  end
end
