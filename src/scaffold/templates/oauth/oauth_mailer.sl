# OAuth mailer — generated by `soli generate oauth`.
#
# Tells an account's owner that a provider was linked to it: a new way to sign
# in, which they should hear about whether or not they added it themselves.
# Delivery is configured as for AuthMailer (SOLI_SMTP_*, or
# SOLI_MAIL_DELIVERY_METHOD=logger in dev).

class OauthMailer < Mailer
  def provider_linked(user, provider)
    @user = user
    @provider = provider.capitalize
    @identities_url = "#{auth_base_url()}/oauth/identities"
    @mail(to: user.email, subject: "#{@provider} can now sign in to your account")
  end
end
