# Shared OAuth client helpers: state, PKCE, and which account a provider
# identity signs in. Generated by `soli generate oauth`.
#
# (Named OauthSso, not OauthClient: `soli generate oidc_provider` owns the
# `OauthClient` model — the relying parties of an app that is itself a provider.)
#
# Which account:
#
#   1. the one already linked to this (provider, uid);
#   2. while a signed-in user is linking a provider (POST /auth/:provider/link,
#      from /oauth/identities), that user — refused when the identity belongs
#      to someone else, when the account's email is not confirmed, when its
#      owner has not signed in (or re-entered their password) in the last ten
#      minutes, or when it signs in through single sign-on only;
#   3. the account with the provider's verified email, linked from now on —
#      never one that signs in through single sign-on only (`User#sso_only?`,
#      `soli generate saml`): a provider vouching for the address must not be
#      a way around the identity provider that account answers to;
#   4. a new one, when sign-up is open (AUTH_SIGNUP, as for /signup).
#
# An SSO-only account signs in through its identity provider and nothing else:
# rule 1 refuses it too, should a provider have been linked before it became one.
#
# Rule 3 hands an existing account to whoever proves the address at the
# provider. If that account never confirmed its email, someone else may have
# created it in wait: everything it can be entered with — password, remember-me
# token, sessions, linked providers, passkeys, API tokens, 2FA, magic links — is
# revoked before it is linked (`User#revoke_credentials`), so the address's
# owner gets the account alone. The owner of an account is emailed whenever a
# provider is linked to it.

class OauthSso
  # How recent a sign-in must be for a signed-in user to link a provider.
  static def reauth_seconds
    600
  end

  # Store a random state token in the session and return it for the authorize
  # URL. Every flow starts as a sign-in: a link left over from a flow abandoned
  # half-way (`oauth_link_user`) is dropped here, and only `begin_link`, called
  # after this, sets it again.
  static def begin_state(provider)
    state = Crypto.random_hex(32)
    session_set("oauth_state", state)
    session_set("oauth_provider", provider)
    session_delete("oauth_link_user")
    state
  end

  # True when the callback `state` matches the one we issued.
  static def valid_state?(state)
    expected = session_get("oauth_state").to_s
    expected.present? && state.to_s.present? && Crypto.secure_compare(expected, state.to_s)
  end

  static def clear_state
    session_delete("oauth_state")
    session_delete("oauth_provider")
    session_delete("oauth_pkce_verifier")
    session_delete("oauth_nonce")
    session_delete("oauth_link_user")
  end

  # OpenID Connect `nonce`, for the providers whose id_token is read (Apple,
  # Microsoft): a random value sent with the authorization request and found
  # again in the token. State and PKCE already tie the code to this browser;
  # the nonce ties the *token* to this request, so one issued for another
  # sign-in cannot be slipped in.
  static def begin_nonce
    nonce = Crypto.random_hex(32)
    session_set("oauth_nonce", nonce)
    nonce
  end

  # Refuse a token whose `nonce` is not the one this sign-in sent.
  static def check_nonce(claimed, provider)
    expected = session_get("oauth_nonce").to_s
    return if expected.present? && claimed.to_s.present? && Crypto.secure_compare(expected, claimed.to_s)

    OauthSso.refuse("the #{provider} token does not answer this sign-in")
  end

  # A provider's or a visitor's words, safe to put on one log line: control
  # characters (a line break forging a second entry) become spaces, and the
  # whole is cut at 2000 characters.
  static def log_safe(text)
    clean = Regex.replace_all("[\\x00-\\x1f\\x7f\\x{85}\\x{2028}\\x{2029}]", text.to_s, " ")
    clean.length > 2000 ? clean.substring(0, 2000) : clean
  end

  # The base URL of a self-hosted provider (GitHub Enterprise, GitLab): the
  # official one when `env_name` is unset, else that URL — over https, or
  # plain http only to this machine. Over plain http to another host the
  # client secret, the code and the profile would cross the network in clear.
  static def instance_base(env_name, official)
    url = getenv(env_name).to_s.trim
    return official if url.blank?

    while url.ends_with?("/")
      url = url.substring(0, url.length - 1)
    end
    local = Regex.matches("^http://(localhost|127\\.0\\.0\\.1|\\[::1\\])(:[0-9]{1,5})?(/|$)", url)
    throw "#{env_name} must be an https:// URL (plain http only for this machine)" unless url.starts_with?("https://") || local

    url
  end

  # PKCE (S256): store the verifier, return the code_challenge for the
  # authorize URL: base64url(SHA256(verifier)), unpadded (RFC 7636 §4.2).
  # Never `plain`: the challenge would be the verifier itself.
  static def begin_pkce
    verifier = Crypto.random_hex(32)
    session_set("oauth_pkce_verifier", verifier)
    Base64.urlsafe_encode(Hex.decode(Crypto.sha256(verifier)))
  end

  static def pkce_verifier
    session_get("oauth_pkce_verifier")
  end

  # A refusal whose message is shown to the browser as is. Only for sentences
  # written here — never one carrying what a provider sent (an error body, an
  # address, a tenant id): those go to the log, and the browser gets
  # `public_message`'s generic line.
  static def refuse(message)
    throw "OAuth: #{message}"
  end

  # Where a provider whose identity this app reads from an unsigned id_token
  # (Apple, Microsoft) is reached: `official`, or the URL in `env_name` only
  # when it is this machine (a stand-in for tests and development). The
  # id_token is trusted because it came over TLS from the provider's own
  # token endpoint; pointed anywhere else, whoever answers there could hand
  # back a forged one, issuer and all.
  static def token_endpoint_base(env_name, official)
    url = getenv(env_name).to_s.trim
    return official if url.blank? || url == official

    unless Regex.matches("^https?://(localhost|127\\.0\\.0\\.1|\\[::1\\])(:[0-9]{1,5})?/?$", url)
      throw "#{env_name} may only name this machine (a stand-in); unset it to reach #{official}"
    end

    url.ends_with?("/") ? url.substring(0, url.length - 1) : url
  end

  # What the browser is told about a failed sign-in.
  static def public_message(error)
    text = error.to_s
    return text.substring(7, text.length) if text.starts_with?("OAuth: ")

    "Sign-in failed. Try again, or sign in another way."
  end

  # --- Re-authentication before linking -------------------------------------

  # Record that `user` has just proved who they are in this session: a sign-in
  # through a provider, or the password typed at /oauth/reauth.
  static def mark_authenticated(user)
    session_set("oauth_reauth_user", user._key)
    session_set("oauth_reauth_at", DateTime.utc.to_unix)
  end

  # Did `user` prove who they are in this session within `reauth_seconds`?
  # A session borrowed for a minute (a shared computer, a stolen cookie) must
  # not be enough to attach a provider that then signs in for good.
  static def recently_authenticated?(user)
    return false if user.nil?
    return false unless session_get("oauth_reauth_user").to_s == user._key.to_s

    at = (session_get("oauth_reauth_at") ?? 0).to_i
    at > 0 && DateTime.utc.to_unix - at <= OauthSso.reauth_seconds
  end

  # Does `user` sign in through single sign-on only? Asked through
  # `respond_to?` so an app whose User has no `sso_only?` (no SAML) keeps working.
  static def sso_only?(user)
    return false if user.nil?
    return false unless user.respond_to?("sso_only?")

    user.sso_only? == true
  end

  # Why `user` may not link a provider right now, or nil.
  static def link_refusal(user)
    return "this account signs in through single sign-on only" if OauthSso.sso_only?(user)
    return "confirm your email address before connecting another account" unless user.confirmed?
    return "sign in again before connecting another account" unless OauthSso.recently_authenticated?(user)

    nil
  end

  # Remember that the signed-in `user` is adding a provider to their account,
  # not signing in. Read back by `find_or_create_user`.
  static def begin_link(user)
    refusal = OauthSso.link_refusal(user)
    OauthSso.refuse(refusal) unless refusal.nil?

    session_set("oauth_link_user", user._key)
  end

  static def linking?
    session_get("oauth_link_user").to_s.present?
  end

  # --- Which account ---------------------------------------------------------

  # The account for a provider identity — see the rules at the top of this
  # file. `email` is the address the provider verified, or nil when it vouches
  # for none: such an identity signs in only once it is linked. Raises when
  # there is no account to give.
  static def find_or_create_user(provider, uid, email, name = nil, raw = nil)
    # No subject, no identity. A provider that sent none would otherwise give
    # every such sign-in the same key — `"<tenant>:null"` — and the same
    # account, or slip past the lookup and be matched by address alone.
    uid = uid.to_s.trim
    if uid.blank? || uid == "null" || uid.ends_with?(":") || uid.ends_with?(":null")
      OauthSso.refuse("#{provider.capitalize} did not say who signed in")
    end

    email = OauthSso.matchable_email(email)
    identity = OauthIdentity.find_for(provider, uid)
    linking = session_get("oauth_link_user").to_s

    if linking.present?
      if !identity.nil? && identity.user_id != linking
        OauthSso.refuse("this #{provider.capitalize} account is linked to another user")
      end

      user = User.find(linking)
      refusal = OauthSso.link_refusal(user)
      OauthSso.refuse(refusal) unless refusal.nil?

      OauthSso.link(user, provider, uid, email, raw, identity.nil?)
      return user
    end
    unless identity.nil?
      user = User.find(identity.user_id)
      OauthSso.refuse("this account signs in through single sign-on only") if OauthSso.sso_only?(user)

      return user
    end

    OauthSso.refuse("#{provider.capitalize} did not share a verified email address") if email.blank?

    user = User.find_by("email", email)
    if user.nil?
      OauthSso.refuse("there is no account for this address, and sign-up is closed") unless auth_signup_open?()

      # In production the first account (the admin) is made at /signup with
      # AUTH_SETUP_TOKEN, never by whoever reaches the provider button first.
      if auth_setup_token_required?() && User.count.zero?
        OauthSso.refuse("create the first account at /signup with AUTH_SETUP_TOKEN")
      end

      user = User.new
      user.email = email
      user.name = name || email.split("@")[0]
      # The account that opens a `first_user` app runs it, as at /signup.
      user.role = "admin" if auth_signup_mode() == "first_user"
      # The provider verified the address. No password: this account signs in
      # through the provider until its owner sets one with a reset link.
      user.confirmed_at = DateTime.utc.to_unix
      user.save
      if user._errors
        Logger.warn("OAuth: could not create the account for #{provider} #{uid}: #{user._errors}")
        OauthSso.refuse("could not create the account")
      end

      OauthSso.link(user, provider, uid, email, raw, false)
      return user
    end

    # Linked by address, an SSO-only account would gain a way in that its
    # identity provider does not control — and keep it once removed there.
    OauthSso.refuse("this account signs in through single sign-on only") if OauthSso.sso_only?(user)

    # Linked already to someone else at this provider: the address now names
    # another person there (a reused mailbox), not the account's owner.
    if OauthIdentity.where({"user_id": user._key, "provider": provider}).count > 0
      OauthSso.refuse("this account is already linked to another #{provider.capitalize} account")
    end

    OauthSso.take_over_unconfirmed(user) unless user.confirmed?
    OauthSso.link(user, provider, uid, email, raw, true)
    user
  end

  # The address to match an account by, lowercased — or "" when it is not
  # plain ASCII. Lowercasing folds letters such as the Kelvin sign into ASCII
  # ones, so a look-alike address a provider verified would match someone
  # else's account; such an identity signs in only once it is linked.
  static def matchable_email(email)
    address = email.to_s.trim
    return "" if Regex.matches("[^\\x00-\\x7f]", address)

    address.downcase
  end

  # Attach the identity; with `notify`, tell the account's owner a new way in
  # was added — the one sign that someone else did it.
  static def link(user, provider, uid, email, raw, notify)
    identity = OauthIdentity.link!(user._key, provider, uid, email.blank? ? nil : email, raw)
    # A link that was not stored is not a link: do not sign in on it, and do
    # not tell the owner one was added.
    if identity.nil? || (identity._errors ?? []).length > 0
      Logger.warn("OAuth: could not link #{provider} #{uid} to #{user._key}: #{identity&._errors}")
      OauthSso.refuse("could not link the #{provider.capitalize} account")
    end
    return unless notify

    try
      OauthMailer.provider_linked(user, provider).deliver_now
    catch error
      Logger.warn("OAuth: provider-linked notification failed: #{error}")
    end
  end

  # An account nobody proved the address of, about to be linked to the person
  # who just did: whatever was set up on it so far is not theirs — the
  # password, the sessions, and every other way in (providers someone linked,
  # passkeys, API tokens, 2FA, magic links).
  static def take_over_unconfirmed(user)
    user.revoke_credentials
    user.confirmed_at = DateTime.utc.to_unix
    user.confirmation_token_digest = nil
    user.save
  end

  static def sign_in(user)
    linking = OauthSso.linking?
    # New session id after a successful login defeats session fixation.
    session_regenerate()
    auth_forget_impersonation()
    session_set("user_id", user._key)
    # Stamped so a later password reset can invalidate this session — and so
    # that this one is not refused for predating the last reset.
    session_set("session_version", user.current_session_version)
    OauthSso.clear_state
    # A provider sign-in is a fresh proof of identity; linking one is not
    # (the session was already signed in) and leaves the stamps as they were.
    # `auth_time` is what an OIDC provider (`soli generate oidc_provider`)
    # puts in its id_tokens and checks `max_age` against.
    unless linking
      OauthSso.mark_authenticated(user)
      session_set("auth_time", DateTime.utc.to_unix)
    end
    session_set("oauth_linked", "1") if linking
  end
end
