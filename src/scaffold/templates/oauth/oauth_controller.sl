# OAuth client — generated by `soli generate oauth`.
#
# GET    /auth/:provider            → start
# POST   /auth/:provider/link       → link_provider
# GET    /auth/:provider/callback   → callback
# POST   /auth/:provider/callback   → callback (Apple posts its answer)
# GET    /oauth/identities          → identities
# DELETE /oauth/identities/:id      → unlink
# GET    /oauth/reauth              → reauth
# POST   /oauth/reauth              → reauthenticate
#
# A provider is the `<Name>Oauth` service class that `soli generate oauth <name>`
# wrote (`GithubOauth`, `GoogleOauth`, `GitlabOauth`, …), found by name, so adding
# a provider never means editing this file. Each service exposes
# `authorize_url(state, code_challenge)` and `complete!(code)`.

# The class for a provider name, or nil. The name is checked against a strict
# pattern first: it comes straight from the URL.
def oauth_service_for(provider)
  return nil if provider.match("^[a-z][a-z0-9]{1,19}$").nil?

  const_get("#{provider.capitalize}Oauth") rescue nil
end

# The providers this app has a service for, among the ones Soli scaffolds.
def oauth_providers
  ["apple", "discord", "github", "gitlab", "google", "linkedin", "microsoft"]
    .filter { |name| !oauth_service_for(name).nil? }
end

# GET /auth/:provider — sign-in: redirects a guest to the provider with a
# fresh state and PKCE challenge. A signed-in user gets the connected-accounts
# page instead: a GET is what any site can make a browser send (a link, an
# image, a top-level redirect), so it never starts linking a provider to the
# account — only the CSRF-checked POST below does.
def start(req)
  provider = (req["params"]["provider"] || "").to_s.downcase
  service = oauth_service_for(provider)
  return {"status": 404, "body": "Unknown OAuth provider"} if service.nil?
  return redirect("/oauth/identities") unless current_user().nil?

  state = OauthSso.begin_state(provider)
  challenge = OauthSso.begin_pkce

  redirect_external(service.authorize_url(state, challenge))
end

# POST /auth/:provider/link — links the provider to the signed-in account
# (the Connect buttons of /oauth/identities), once the account's email is
# confirmed and only within ten minutes of a sign-in (else /oauth/reauth asks
# for the password first).
def link_provider(req)
  user = current_user()
  return redirect("/login") if user.nil?

  # The account's own user, at the keyboard: not an API token, not an
  # administrator acting as them — a provider linked then would be a way in
  # for whoever linked it.
  return {"status": 403, "body": "Forbidden"} unless auth_own_session?(req)

  provider = (req["params"]["provider"] || "").to_s.downcase
  return {"status": 404, "body": "Unknown OAuth provider"} if oauth_service_for(provider).nil?
  return redirect("/oauth/reauth?provider=#{provider}") if user.confirmed? && !OauthSso.recently_authenticated?(user)

  _start_link(user, provider)
end

# GET /auth/:provider/callback — checks state, exchanges the code, signs the
# user in (or links the provider).
def callback(req)
  provider = (req["params"]["provider"] || "").to_s.downcase
  return {"status": 404, "body": "Unknown OAuth provider"} if oauth_service_for(provider).nil?

  # A provider that posts its answer (Apple, response_mode=form_post) does so
  # from its own site, and the session cookie (SameSite=Lax) does not come
  # with a cross-site POST. Hand the answer to a GET of this same URL, which
  # the cookie does come with; nothing is trusted or read from the session here.
  if req["method"] == "POST"
    posted = req["form"] || {}
    query = ["code", "state", "user", "error"]
      .filter { |name| posted[name].to_s.present? }
      .map { |name| "#{name}=#{url_encode(posted[name].to_s)}" }
    return redirect("/auth/#{provider}/callback?#{query.join("&")}")
  end

  answer = req["query"] || req["query_params"] || {}
  unless OauthSso.valid_state?(answer["state"])
    OauthSso.clear_state
    return {"status": 403, "body": "Invalid OAuth state — try signing in again"}
  end

  # The provider must be the one this browser session started with, or a
  # callback for one provider could complete a flow begun for another.
  service = oauth_service_for(provider)
  if service.nil? || session_get("oauth_provider") != provider
    OauthSso.clear_state
    return {"status": 404, "body": "Unknown OAuth provider"}
  end

  # The provider's own words (`error_description`) go to the log, never to
  # the page: they are whatever the query string says.
  if answer["error"].present?
    OauthSso.clear_state
    refused = OauthSso.log_safe("#{answer["error"]} #{answer["error_description"]}")
    Logger.warn("OAuth #{provider}: authorization refused: #{refused}")
    return {"status": 401, "body": "Sign-in was cancelled or refused by the provider."}
  end

  code = answer["code"]
  if code.blank?
    OauthSso.clear_state
    return {"status": 400, "body": "Missing authorization code"}
  end

  linking = OauthSso.linking?
  try
    service.complete!(code)
  catch error
    OauthSso.clear_state
    # Logged (on one line); the page gets only the refusals written for it.
    Logger.warn("OAuth #{provider} sign-in failed: #{OauthSso.log_safe(error)}")
    return {"status": 401, "body": OauthSso.public_message(error)}
  end

  redirect(linking ? "/oauth/identities" : "/")
end

# GET /oauth/identities — the providers linked to the signed-in account
def identities(req)
  user = current_user()
  return redirect("/login") if user.nil?

  linked = OauthIdentity.for_user(user)
  taken = linked.map { |identity| identity.provider }
  render(
    "oauth/identities",
    {
      "title": "Connected accounts",
      "identities": linked,
      "available": oauth_providers().filter { |name| !taken.includes?(name) },
      "can_unlink": user.password_digest.present? || linked.length > 1
    }
  )
end

# DELETE /oauth/identities/:id — unlink a provider
def unlink(req)
  user = current_user()
  return redirect("/login") if user.nil?

  return {"status": 403, "body": "Forbidden"} unless auth_own_session?(req)

  # Removing a way in is as sensitive as adding one: a session left open on
  # a shared machine must not be able to cut the owner's provider off.
  unless OauthSso.recently_authenticated?(user)
    return redirect("/oauth/reauth") if user.password_digest.present?

    return {
      "status": 403,
      "body": "Sign out, sign back in, then disconnect the account within ten minutes."
    }
  end

  identity = OauthIdentity.find_by("_key", req["params"]["id"])
  linked = OauthIdentity.for_user(user)
  # Never the last way in: an account with no password keeps one provider.
  keeps_a_way_in = user.password_digest.present? || linked.length > 1
  # Someone else's identity answers exactly like a missing one.
  identity.delete if !identity.nil? && identity.user_id == user._key && keeps_a_way_in
  redirect("/oauth/identities")
end

# GET /oauth/reauth — asks a signed-in user to prove it is them before a
# provider is linked to their account.
def reauth(req)
  user = current_user()
  return redirect("/login") if user.nil?

  _render_reauth(user, params["provider"].to_s, "", 200)
end

# POST /oauth/reauth — the password, then on to the provider.
def reauthenticate(req)
  user = current_user()
  return redirect("/login") if user.nil?
  return {"status": 403, "body": "Forbidden"} unless auth_own_session?(req)

  provider = params["provider"].to_s.downcase
  # The sign-in form's per-address throttle covers the guesses made here too.
  limiter = rate_limiter_from_ip(req, AUTH_ATTEMPTS_PER_IP, AUTH_IP_WINDOW_SECONDS)
  return _render_reauth(user, provider, "Too many attempts. Try again in a few minutes.", 429) unless limiter.allowed
  # The sign-in form's lockout counts the guesses made here too.
  if user.locked? || !user.authenticate(params["password"].to_s)
    user.register_failed_attempt unless user.password_digest.blank?
    return _render_reauth(user, provider, "That password is not right.", 401)
  end

  user.clear_failed_attempts
  OauthSso.mark_authenticated(user)
  return redirect("/oauth/identities") if oauth_service_for(provider).nil?

  # This POST is CSRF-checked and names the provider: it starts the link
  # itself rather than bouncing through a GET that no longer links.
  _start_link(user, provider)
end

# Off to the provider to link it to `user`'s account — or the refusal
# (`OauthSso.link_refusal`) as a page.
def _start_link(user, provider)
  refusal = OauthSso.link_refusal(user)
  return {"status": 403, "body": "#{refusal.capitalize}."} unless refusal.nil?

  state = OauthSso.begin_state(provider)
  challenge = OauthSso.begin_pkce
  OauthSso.begin_link(user)

  redirect_external(oauth_service_for(provider).authorize_url(state, challenge))
end

def _render_reauth(user, provider, error, status)
  provider = "" if oauth_service_for(provider.downcase).nil?
  render(
    "oauth/reauth",
    {
      "title": "Confirm it's you",
      "provider": provider,
      "error": error,
      "has_password": user.password_digest.present?,
      "linked": OauthIdentity.for_user(user).map { |identity| identity.provider.capitalize }
    },
    {"status": status}
  )
end
