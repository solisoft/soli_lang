# OauthIdentity — links a User to an external OAuth provider account.
# Generated by `soli generate oauth`.
# Collection: oauth_identities

class OauthIdentity < Model
  validates("provider", {"presence": true})
  validates("uid", {"presence": true})
  validates("user_id", {"presence": true})

  belongs_to("user")

  # The identity for provider + uid (e.g. "github", "12345"), or nil.
  static def find_for(provider, uid)
    OauthIdentity.where({"provider": provider, "uid": uid.to_s}).first
  end

  static def for_user(user)
    OauthIdentity.where({"user_id": user._key}).order("provider", "asc").all
  end

  # Attach the identity to a user, or refresh the one that exists.
  static def link!(user_id, provider, uid, email = nil, raw = nil)
    existing = OauthIdentity.find_for(provider, uid)
    unless existing.nil?
      existing.email = email if email
      existing.raw = raw if raw
      existing.save
      return existing
    end

    OauthIdentity.create({
      "user_id": user_id,
      "provider": provider,
      "uid": uid.to_s,
      "email": email,
      "raw": raw
    })
  end
end
