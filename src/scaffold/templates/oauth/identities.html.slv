<div class="max-w-2xl mx-auto px-4 py-10">
  <h1 class="text-2xl font-bold mb-2">Connected accounts</h1>
  <p class="mb-6 text-sm text-slate-400">
    The accounts you can sign in with, besides your password.
  </p>

  <% if identities.length > 0 %>
    <ul class="mb-6 divide-y divide-slate-800 rounded-xl border border-slate-800 bg-slate-900">
      <% identities.each do |identity| %>
        <li class="flex items-center justify-between px-4 py-3">
          <div>
            <p class="font-medium text-white"><%= identity.provider.capitalize %></p>
            <p class="text-xs text-slate-400"><%= identity.email %></p>
          </div>
          <% if can_unlink %>
            <%- button_to("Disconnect", "/oauth/identities/" + identity._key.to_s, {
              "method": "delete", "confirm": "Disconnect this account?",
              "class": "text-sm text-red-400 hover:text-red-300", "form_class": "inline"
            }) %>
          <% end %>
        </li>
      <% end %>
    </ul>
    <% unless can_unlink %>
      <p class="mb-6 text-sm text-slate-400">
        This is your only way to sign in. Set a password (or connect another account) before disconnecting it.
      </p>
    <% end %>
  <% else %>
    <p class="mb-6 text-sm text-slate-400">No connected account yet.</p>
  <% end %>

  <% if available.length > 0 %>
    <div class="flex flex-wrap gap-2">
      <% available.each do |provider| %>
        <a href="/auth/<%= provider %>"
           class="rounded-md bg-indigo-600 hover:bg-indigo-700 px-4 py-2 font-medium text-white transition-colors">
          Connect <%= provider.capitalize %>
        </a>
      <% end %>
    </div>
  <% end %>
</div>
