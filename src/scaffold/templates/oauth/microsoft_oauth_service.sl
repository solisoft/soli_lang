# Microsoft identity platform (Entra ID), authorization code + PKCE S256.
# Generated by: soli generate oauth microsoft
#
# Env: MICROSOFT_CLIENT_ID, MICROSOFT_CLIENT_SECRET, MICROSOFT_REDIRECT_URI,
#      MICROSOFT_TENANT           your tenant id (a GUID), or `organizations`
#      MICROSOFT_ALLOWED_TENANTS  with `organizations`: the tenant ids that may
#                                 sign in, comma-separated
#
# Microsoft does not verify the `email` claim, and in a multi-tenant app a
# foreign tenant can present someone else's address (the "nOAuth" class of
# account takeover). So the email is only ever taken from a tenant you named:
#
# - one tenant (MICROSOFT_TENANT=<tenant id>): its directory is yours;
# - several (MICROSOFT_TENANT=organizations): only the tenants listed in
#   MICROSOFT_ALLOWED_TENANTS, each of which you trust as you trust your own —
#   your customers' directories, say. The tenant is read from the id_token
#   (`tid`), and its issuer must be that tenant's.
#
# `common` and `consumers` are refused: personal Microsoft accounts have no
# tenant to vouch for an address, and an open `organizations` (no list) would
# let any directory in the world assert any email.
#
# Even inside a named tenant, an administrator can set any user's `email`
# attribute to any address, unverified. So the address is used — to find or
# create an account — only when Microsoft says it was verified:
#
# - `xms_edov: true` (the email domain's owner is verified) with `email`, or
# - `verified_primary_email`.
#
# Both are optional claims: add them to the ID token in the Entra admin
# center, App registrations → your app → Token configuration → Add optional
# claim → ID → `email`, `xms_edov`, `verified_primary_email`. Without them no
# address is trusted, and a Microsoft identity signs in only once a signed-in
# user has linked it (/oauth/identities). `preferred_username` is never an
# address: it is whatever the directory calls the user.
#
# An identity's uid is `<tid>:<sub>` (`sub` is only unique within a tenant).
# Apps generated before that stored the bare `sub`; such a row is rewritten to
# the new form the first time its owner signs in (`adopt_legacy_identity`) —
# when the tenant recorded with it is the token's, or, for a row that recorded
# none, only in a single-tenant app.
#
# The id_token is read without checking its signature, on purpose: it arrives
# from Microsoft's token endpoint over TLS, in answer to this server's own
# request (OpenID Connect Core §3.1.3.7 allows exactly that). That trust holds
# only if the answer really is Microsoft's, so the exchange follows no
# redirect, and MICROSOFT_BASE_URL may name nothing but this machine (a
# stand-in for tests): pointed at any other host, whoever answers there could
# hand back a forged token, issuer and all.

class MicrosoftOauth
  static def tenant
    tenant = getenv("MICROSOFT_TENANT").to_s.trim
    throw "MICROSOFT_TENANT is required (a tenant id, or `organizations`)" if tenant.blank?
    if ["common", "consumers"].includes?(tenant.downcase)
      throw "MICROSOFT_TENANT must be your tenant, or `organizations` with MICROSOFT_ALLOWED_TENANTS"
    end
    if tenant.downcase == "organizations" && MicrosoftOauth.allowed_tenants.length == 0
      throw "MICROSOFT_TENANT=organizations needs MICROSOFT_ALLOWED_TENANTS (the tenant ids that may sign in)"
    end

    # A tenant *id*, not a domain: the token names its tenant by id (`tid`),
    # and a domain could not be compared with it — the sign-in would rest on
    # Microsoft's endpoint alone.
    unless tenant.downcase == "organizations" || MicrosoftOauth.tenant_id?(tenant)
      throw "MICROSOFT_TENANT must be a tenant id (a GUID), or `organizations` with MICROSOFT_ALLOWED_TENANTS"
    end

    tenant
  end

  static def tenant_id?(text)
    Regex.matches("^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$", text.to_s.trim.downcase)
  end

  static def multi_tenant?
    getenv("MICROSOFT_TENANT").to_s.trim.downcase == "organizations"
  end

  # The tenant ids that may sign in, lowercased.
  static def allowed_tenants
    getenv("MICROSOFT_ALLOWED_TENANTS").to_s.split(",")
      .map { |id| id.trim.downcase }
      .filter { |id| id.present? }
  end

  static def base_url
    OauthSso.token_endpoint_base("MICROSOFT_BASE_URL", "https://login.microsoftonline.com")
  end

  static def authorize_url(state, code_challenge = nil)
    query = [
      "client_id=#{url_encode(getenv("MICROSOFT_CLIENT_ID").to_s)}",
      "redirect_uri=#{url_encode(getenv("MICROSOFT_REDIRECT_URI").to_s)}",
      "response_type=code",
      "response_mode=query",
      "scope=#{url_encode("openid email profile")}",
      "state=#{url_encode(state)}",
      "code_challenge=#{url_encode(code_challenge.to_s)}",
      "code_challenge_method=S256",
      "nonce=#{url_encode(OauthSso.begin_nonce)}",
      "prompt=select_account"
    ]

    "#{MicrosoftOauth.base_url}/#{url_encode(MicrosoftOauth.tenant)}/oauth2/v2.0/authorize?#{query.join("&")}"
  end

  static def exchange_code(code)
    body = [
      "code=#{url_encode(code)}",
      "client_id=#{url_encode(getenv("MICROSOFT_CLIENT_ID").to_s)}",
      "client_secret=#{url_encode(getenv("MICROSOFT_CLIENT_SECRET").to_s)}",
      "redirect_uri=#{url_encode(getenv("MICROSOFT_REDIRECT_URI").to_s)}",
      "grant_type=authorization_code",
      "code_verifier=#{url_encode(OauthSso.pkce_verifier.to_s)}"
    ].join("&")
    response = HTTP.request(
      "POST",
      "#{MicrosoftOauth.base_url}/#{url_encode(MicrosoftOauth.tenant)}/oauth2/v2.0/token",
      {
        "Content-Type": "application/x-www-form-urlencoded",
        "Accept": "application/json",
        # A redirect would take the token (read unsigned) from another host.
        "follow_redirects": false
      },
      body
    )

    MicrosoftOauth._json_body(response, "token exchange")
  end

  static def _json_body(response, step)
    status = response["status"]
    body = response["body"].to_s
    throw "Microsoft #{step} failed (HTTP #{status}): #{body}" unless status >= 200 && status < 300

    json_parse(body)
  end

  # The claims of the id_token, held to this app and to a tenant it names.
  static def identity(id_token)
    decoded = jwt_decode_unsafe(id_token.to_s)
    throw "Microsoft sent no readable id_token" if decoded["error"]

    claims = decoded["claims"]
    tenant_id = claims["tid"].to_s.downcase
    throw "Microsoft id_token: issued for another client" unless claims["aud"] == getenv("MICROSOFT_CLIENT_ID").to_s
    throw "Microsoft id_token: expired" unless claims["exp"].to_i > DateTime.utc.to_unix
    throw "Microsoft id_token: no tenant" if tenant_id.blank?
    OauthSso.check_nonce(claims["nonce"], "Microsoft")
    # A single tenant named by its id: the token must be that tenant's. The
    # `/{tenant}/` token endpoint only issues its own, but that is Microsoft's
    # promise; this is the app's own check.
    configured = MicrosoftOauth.tenant.downcase
    if configured != "organizations" && tenant_id != configured
      OauthSso.refuse("this Microsoft organization is not allowed to sign in here")
    end
    # The issuer names the tenant that signed the user in; it must be the one
    # the token says it is.
    unless claims["iss"].to_s.downcase == "https://login.microsoftonline.com/#{tenant_id}/v2.0"
      OauthSso.refuse("the Microsoft token's issuer does not match its tenant")
    end
    if MicrosoftOauth.multi_tenant? && !MicrosoftOauth.allowed_tenants.includes?(tenant_id)
      Logger.warn("Microsoft: tenant #{tenant_id} is not in MICROSOFT_ALLOWED_TENANTS")
      OauthSso.refuse("this Microsoft organization is not allowed to sign in here")
    end

    claims
  end

  # The address Microsoft verified, or nil — see the top of this file.
  static def verified_email(claims)
    edov = claims["xms_edov"].to_s
    return claims["email"] if ["true", "1"].includes?(edov) && claims["email"].to_s.present?

    verified = claims["verified_primary_email"]
    return verified[0] if type(verified) == "array" && verified.length > 0 && verified[0].to_s.present?
    return verified if type(verified) == "string" && verified.present?

    nil
  end

  # An identity stored under the bare `sub` (before uids were `<tid>:<sub>`)
  # becomes `uid`, so its owner still signs in to the same account — but only
  # when that row is provably this tenant's user: the `tid` recorded with it
  # (`raw`) is the token's, or, when it recorded none, this app trusts a single
  # tenant (in a multi-tenant one the same `sub` may be someone else's).
  static def adopt_legacy_identity(claims, uid)
    return nil unless OauthIdentity.find_for("microsoft", uid).nil?

    sub = claims["sub"].to_s
    return nil if sub.blank?

    legacy = OauthIdentity.find_for("microsoft", sub)
    return nil if legacy.nil?

    raw = legacy.raw
    recorded_tenant = type(raw) == "hash" ? raw["tid"].to_s.downcase : ""
    if recorded_tenant.present?
      return nil unless recorded_tenant == claims["tid"].to_s.downcase
    elsif MicrosoftOauth.multi_tenant?
      Logger.warn("Microsoft: identity #{legacy._key} has a bare sub and no tenant; not adopted (multi-tenant app)")
      return nil
    end

    legacy.uid = uid
    legacy.save
    legacy
  end

  static def complete!(code)
    token_data = MicrosoftOauth.exchange_code(code)
    if token_data["error"]
      throw "Microsoft token exchange failed: #{token_data["error_description"] || token_data["error"]}"
    end

    claims = MicrosoftOauth.identity(token_data["id_token"])
    # The tenant and `sub` (unique to the user within this app) together, so
    # an identity is never confused across directories.
    uid = "#{claims["tid"].to_s.downcase}:#{claims["sub"]}"
    MicrosoftOauth.adopt_legacy_identity(claims, uid)
    email = MicrosoftOauth.verified_email(claims)
    user = OauthSso.find_or_create_user("microsoft", uid, email, claims["name"], claims)
    OauthSso.sign_in(user)
    user
  end
end
