# GitHub OAuth 2.0 (authorization code + PKCE S256).
# Generated by: soli generate oauth github
#
# Env: GITHUB_CLIENT_ID, GITHUB_CLIENT_SECRET, GITHUB_REDIRECT_URI
# Optional: GITHUB_BASE_URL (default https://github.com) and GITHUB_API_URL
# (default https://api.github.com) for GitHub Enterprise Server.
#
# The address comes from /user/emails, and only the one GitHub marks primary
# AND verified. The profile's public `email` is whatever the user typed in
# their profile, never checked: linking on it would hand an existing account
# to anyone who claims its address.

class GithubOauth
  static def base_url
    OauthSso.instance_base("GITHUB_BASE_URL", "https://github.com")
  end

  static def api_url
    OauthSso.instance_base("GITHUB_API_URL", "https://api.github.com")
  end

  static def authorize_url(state, code_challenge = nil)
    query = [
      "client_id=#{url_encode(getenv("GITHUB_CLIENT_ID").to_s)}",
      "redirect_uri=#{url_encode(getenv("GITHUB_REDIRECT_URI").to_s)}",
      "scope=#{url_encode("read:user user:email")}",
      "state=#{url_encode(state)}",
      "code_challenge=#{url_encode(code_challenge.to_s)}",
      "code_challenge_method=S256"
    ]

    "#{GithubOauth.base_url}/login/oauth/authorize?#{query.join("&")}"
  end

  # `HTTP.request` is the only form that sends headers: `HTTP.post`/`HTTP.get`
  # inspect their options hash for `timeout` alone, so a `"headers"` key there
  # is silently dropped — and they return the body as a String, not a response
  # hash. Headers are the 3rd positional argument; the body is the 4th.
  static def exchange_code(code)
    body = [
      "client_id=#{url_encode(getenv("GITHUB_CLIENT_ID").to_s)}",
      "client_secret=#{url_encode(getenv("GITHUB_CLIENT_SECRET").to_s)}",
      "code=#{url_encode(code.to_s)}",
      "redirect_uri=#{url_encode(getenv("GITHUB_REDIRECT_URI").to_s)}",
      "code_verifier=#{url_encode(OauthSso.pkce_verifier.to_s)}"
    ].join("&")
    response = HTTP.request(
      "POST",
      "#{GithubOauth.base_url}/login/oauth/access_token",
      {"Content-Type": "application/x-www-form-urlencoded", "Accept": "application/json"},
      body
    )

    GithubOauth._json_body(response, "token exchange")
  end

  static def _api_get(access_token, path, step)
    response = HTTP.request(
      "GET",
      "#{GithubOauth.api_url}#{path}",
      {
        "Authorization": "Bearer #{access_token}",
        "Accept": "application/json",
        "User-Agent": "soli-oauth"
      }
    )

    GithubOauth._json_body(response, step)
  end

  static def fetch_user(access_token)
    GithubOauth._api_get(access_token, "/user", "profile fetch")
  end

  static def fetch_emails(access_token)
    GithubOauth._api_get(access_token, "/user/emails", "email fetch")
  end

  # `HTTP.request` returns the response instead of raising on a non-2xx, so the
  # status has to be read. Without this a 401 surfaced as a JSON parse error on
  # GitHub's error page.
  static def _json_body(response, step)
    status = response["status"]
    body = response["body"].to_s
    throw "GitHub #{step} failed (HTTP #{status}): #{body}" unless status >= 200 && status < 300

    json_parse(body)
  end

  # The primary address, when GitHub verified it; nil otherwise. Not "any
  # verified one": a secondary address is easy to add and stays on the
  # account after its owner has lost the mailbox.
  static def primary_email(emails)
    return nil unless type(emails) == "array"

    primary = emails.find { |entry| entry["primary"] == true && entry["verified"] == true }
    primary.nil? ? nil : primary["email"]
  end

  # Full callback: exchange code → profile → User → session.
  static def complete!(code)
    token_data = GithubOauth.exchange_code(code)
    if token_data["error"]
      throw "GitHub token exchange failed: #{token_data["error_description"] || token_data["error"]}"
    end

    access_token = token_data["access_token"]
    profile = GithubOauth.fetch_user(access_token)
    email = GithubOauth.primary_email(GithubOauth.fetch_emails(access_token))
    # No verified primary address: the identity still signs in once linked.
    user = OauthSso.find_or_create_user("github", profile["id"], email, profile["name"] || profile["login"], profile)
    OauthSso.sign_in(user)
    user
  end
end
