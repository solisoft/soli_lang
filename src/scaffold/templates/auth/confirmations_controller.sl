# Confirmations controller — email confirmation. Generated by `soli generate auth`.
#
# Signup sends a confirmation link (see RegistrationsController); this
# controller confirms it and can resend a fresh one. The resend form always
# responds the same way whether or not the email exists.

class ConfirmationsController < Controller
  static {
    this.layout = "application"
  }

  # GET /confirm_email?token=... — the link from the email
  #
  # Shows a page with a button; it confirms nothing. A GET from an email is
  # followed by things that are not the owner — a mail-security scanner, a
  # link preview — and a confirmed address is what the provider and SAML
  # sign-ins link an account by: an account someone else opened with this
  # address must not become "confirmed" because a robot fetched a URL. The
  # button posts to `confirm`, which is where the address is confirmed.
  def show
    token = params["token"].to_s
    user = @_pending(token)
    return @_invalid if user.nil?

    # An account nobody ever entered is asked for the password it was
    # created with (see `confirm`).
    @_page("Confirm your email", "", "", token, user.never_signed_in?)
  end

  # POST /confirm_email — the button on that page
  def confirm
    user = @_pending(params["token"].to_s)
    return @_invalid if user.nil?

    # An account that has been in use (its user never clicked the link —
    # most accounts, where the confirmation is not required): the address is
    # confirmed, nothing else changes. Not signed in: whoever holds the link
    # — a shared mailbox, the colleague the message was forwarded to — has
    # not proved they hold the password.
    unless user.never_signed_in?
      user.confirm_email
      return @_form("Email confirmed", "Your email address is confirmed. Sign in to continue.", "")
    end

    # An account nobody ever entered. Whoever is here holds the mailbox;
    # whoever signed up chose the password — and may be someone else, who
    # created the account in wait for this confirmation. The password is
    # what tells: given here, the same person did both, and it stays. (A
    # cookie left at sign-up would not tell — on a shared machine it is the
    # next visitor's too.) One try: a wrong one takes the path below, which
    # removes the password it was a guess at.
    if user.authenticate(params["password"].to_s) == true
      user.confirm_email
      return @_form("Email confirmed", "Your email address is confirmed. Sign in to continue.", "")
    end

    # No password, or not the one: everything the account could be
    # entered with goes, and a link to choose a password is mailed: sent to
    # the mailbox rather than handed to this browser, so that a confirmation
    # mail forwarded to someone is not a way into the account.
    #
    # Once per link: copies of this request sent together each mailed a
    # reset link, and only the last one stored works. The link is taken by
    # a write that names the digest that was read.
    digest = Crypto.sha256(params["token"].to_s)
    mark = "claimed:#{Crypto.random_hex(16)}"
    as_read = {"_key": user._key, "confirmation_token_digest": digest}
    auth_written(User.where(as_read).update_all({"confirmation_token_digest": mark}))
    now_holds = User.find_by("_key", user._key)
    return @_invalid if now_holds.nil? || now_holds.confirmation_token_digest != mark

    user.revoke_credentials
    user.confirm_email
    AuthMailer.reset_password(user, user.start_password_reset).deliver_later rescue nil
    @_form(
      "Email confirmed",
      "Your email address is confirmed. We sent you a link to choose your password — " +
        "if it does not arrive, ask for one from “Forgot password” in a few minutes.",
      ""
    )
  end

  # GET /confirmation/resend
  def new
    @_form("Confirm your email", "", "")
  end

  # POST /confirmation/resend
  def create
    # Each request mails the address and replaces its pending link: the
    # per-address throttle of the sign-in form applies.
    limiter = rate_limiter_from_ip(req, AUTH_ATTEMPTS_PER_IP, AUTH_IP_WINDOW_SECONDS)
    unless limiter.allowed
      return @_form("Confirm your email", "", "Too many requests. Try again in a few minutes.")
    end

    started = clock()
    email = params["email"].to_s.trim.downcase
    user = User.find_by("email", email)
    if !user.nil? && !user.confirmed? && !user.confirmation_recently_sent?
      token = user.start_email_confirmation
      AuthMailer.confirm_email(user, token).deliver_later rescue nil
    else
      User.burn_write_work
    end

    auth_uniform_wait(started)
    @_form("Confirm your email", "If that email needs confirming, a fresh link is on its way.", "")
  end

  private

  # The account a confirmation token names, while the link is still good.
  # An expired link is indistinguishable from an invalid one to the visitor,
  # which is right: both mean "ask for a fresh one".
  def _pending(token)
    return nil if token.blank?

    user = User.find_by("confirmation_token_digest", Crypto.sha256(token))
    return nil if user.nil? || user.confirmation_token_expired?
    # Confirmed since the link was sent (a password reset, a provider): the
    # link has nothing left to do, and must do nothing.
    return nil if user.confirmed?

    user
  end

  def _invalid
    @_form(
      "Confirm your email",
      "",
      "That confirmation link is invalid or was already used. Enter your email to get a fresh one."
    )
  end

  # The confirmation page with a title, a notice and an error.
  def _form(title, notice, error)
    @_page(title, notice, error, "", false)
  end

  # With a `token`, the page is the "confirm this address" button; without
  # one, the "send me a fresh link" form.
  def _page(title, notice, error, token, ask_password)
    render(
      "confirmations/new",
      {
        "title": title,
        "notice": notice,
        "error": error,
        "token": token,
        "ask_password": ask_password
      }
    )
  end
end
