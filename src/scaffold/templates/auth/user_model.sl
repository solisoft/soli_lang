# User model — generated by `soli generate auth`.
# Collection: users
#
# Passwords are never stored in plaintext: assign through `set_password`,
# which hashes with Argon2id (the built-in Crypto module), and verify with
# `authenticate`. Reset/confirmation/remember tokens are random UUIDs whose
# SHA-256 digest is stored — a leak of the users can't be replayed as a live
# link. (The mail that carries a link sits in the jobs collection until it is
# delivered or given up on; its body is removed then.)

# --- Auth flow tuning --------------------------------------------------------
const AUTH_RESET_TOKEN_TTL = 7200  # password-reset links live 2 hours
const AUTH_MAX_FAILED_ATTEMPTS = 10  # failed logins before lockout
const AUTH_LOCKOUT_SECONDS = 1800  # auto-unlock after 30 minutes
const AUTH_CONFIRMATION_TOKEN_TTL = 172800  # confirmation links last 48 hours
const AUTH_REMEMBER_DAYS = 30  # remember-me cookie lifetime
const AUTH_MIN_PASSWORD_LENGTH = 12  # shortest password accepted at sign-up

# A positive integer from the environment, or `fallback` when the variable is
# unset, blank or not a positive number.
def auth_env_int(name, fallback)
  value = getenv(name).to_s.trim.to_i
  value > 0 ? value : fallback
end

# Per-IP throttle on the credential endpoints (login, sign-up, reset). The
# per-account lockout above cannot see credential stuffing spread thinly
# across thousands of accounts; keying on the source address does.
#
# The lockout is also a way to keep an owner out: whoever knows an address
# can send it wrong passwords. The budget is under AUTH_MAX_FAILED_ATTEMPTS,
# so one address cannot do it in one go — it takes it two windows, ten
# minutes with the defaults, and several addresses none. That is the price
# of the lock: counting failures only within a window, or per address, would
# spare the owner and hand a guesser five times the tries, unlocked and
# unannounced. The owner is mailed when the lock trips, it lifts by itself
# after AUTH_LOCKOUT_SECONDS, and a password reset lifts it at once.
#
# Tune per deployment with AUTH_ATTEMPTS_PER_IP and AUTH_IP_WINDOW_SECONDS
# (an office behind one NAT may need a higher limit).
const AUTH_ATTEMPTS_PER_IP = auth_env_int("AUTH_ATTEMPTS_PER_IP", 8)
const AUTH_IP_WINDOW_SECONDS = auth_env_int("AUTH_IP_WINDOW_SECONDS", 300)

# How long a reset or a confirmation link stays the only one: a new request
# within this time sends nothing (the answer is the same either way).
const AUTH_RESEND_SECONDS = auth_env_int("AUTH_RESEND_SECONDS", 300)

# How recent a sign-in must be to add a way into the account (a passkey, an
# API token, an authenticator app). A session left open on a shared machine,
# or one restored from the remember-me cookie, signs in again first.
const AUTH_FRESH_SECONDS = auth_env_int("AUTH_FRESH_SECONDS", 900)
# How long an administrator may act as a user before the session ends.
const AUTH_IMPERSONATION_SECONDS = auth_env_int("AUTH_IMPERSONATION_SECONDS", 3600)

# Is the account's owner at the keyboard? Not when the request is carried by
# an API token (a script must not become its owner's browser), and not while
# an administrator is acting as the user. Asked before anything that adds or
# removes a way into the account.
def auth_own_session?(req)
  return false unless (req["api_token"] rescue nil).nil?

  session_get("impersonator_id").to_s.blank?
end

# Did this session sign in within AUTH_FRESH_SECONDS? (`auth_time` is set by
# every sign-in, and by nothing else: not by remember-me, not by an
# impersonation, and not by the second factor passed after either — that
# re-opens the session within the sign-in it had, and keeps its time.)
def auth_fresh_sign_in?
  signed_in_at = (session_get("auth_time") ?? 0).to_i
  signed_in_at > 0 && DateTime.utc.to_unix - signed_in_at <= AUTH_FRESH_SECONDS
end

# How long the answers that must not tell a registered address from an
# unknown one take, at least (seconds). The work behind them differs — a
# token stored, a mail queued, or nothing — and `auth_uniform_wait` holds
# the reply until this much time has passed either way.
const AUTH_UNIFORM_SECONDS = 0.25

# Hold a reply until AUTH_UNIFORM_SECONDS have passed since `started` (a
# `clock()` reading taken when the action began).
def auth_uniform_wait(started)
  remaining = AUTH_UNIFORM_SECONDS - (clock() - started)
  sleep(remaining) if remaining > 0
end

# Make the session `user`'s, as a sign-in that happened just now. Every action
# that signs someone in goes through here.
#
# `session_regenerate` gives the session a new id and keeps its data: without
# the deletions below, what the previous occupant of the session left behind
# became the new user's. An impersonation, whose "stop" then returned the
# administrator's session. A two-factor marker (`off:<user>`, `ok:<user>`)
# parked in the session by an earlier sign-in to that same account, which
# then skipped the challenge the account had since turned on. A SAML
# session's expiry, cutting a password sign-in short.
#
# What the caller knows on top — a passkey that verified its user, a SAML
# session's end — it sets afterwards.
#
# `same_sign_in`: the session is being re-opened inside the sign-in it
# already belongs to — the second factor passed, an administrator starting
# or stopping an impersonation. The end a SAML sign-in came with stays, or
# passing the challenge would lift the only thing that ends such a session.
#
# `by_owner`: the account's own user is signing in (not an administrator
# acting as them). The first time, the account is marked as used
# (`User#never_signed_in?`).
def auth_open_session(user, same_sign_in = false, by_owner = true)
  sign_in_ends = same_sign_in ? session_get("sign_in_expires_at") : nil
  # The moment the sign-in this continues began — none, for a session the
  # remember-me cookie restored: a second factor passed after it proves the
  # device, not that the password was typed.
  signed_in_at = same_sign_in ? session_get("auth_time") : DateTime.utc.to_unix
  # A provider sign-in vouches for a moment (`OauthSso.mark_authenticated`):
  # within the same sign-in, and for this same user, it stays — an account
  # with no password has no other way to prove itself before linking.
  vouched_at = nil
  if same_sign_in && by_owner && session_get("oauth_reauth_user").to_s == user._key.to_s
    vouched_at = session_get("oauth_reauth_at")
  end
  session_regenerate()
  auth_forget_impersonation()
  session_delete("two_factor")
  # "Remember me", ticked at a password step that waits for a second factor.
  session_delete("remember_wanted")
  # An authenticator set-up started by the previous occupant: its secret is
  # theirs to see, not the next sign-in's in the same browser.
  session_delete("two_factor_setup")
  session_delete("sign_in_expires_at")
  # Who re-authenticated to link a provider, and for whom: the previous
  # occupant's, not this user's.
  session_delete("oauth_link_user")
  session_delete("oauth_reauth_user")
  session_delete("oauth_reauth_at")
  session_set("sign_in_expires_at", sign_in_ends) unless sign_in_ends.nil?
  unless vouched_at.nil?
    session_set("oauth_reauth_user", user._key)
    session_set("oauth_reauth_at", vouched_at)
  end
  session_set("user_id", user._key)
  # When this sign-in happened: the OIDC provider reads it for max_age /
  # auth_time, and adding a way into the account asks for a recent one.
  signed_in_at.nil? ? session_delete("auth_time") : session_set("auth_time", signed_in_at)
  # Stamped so a later password reset can invalidate this session.
  session_set("session_version", user.current_session_version)
  user.mark_signed_in if by_owner
end

# A sign-in is a new person: whatever impersonation the session carried is
# over. `session_regenerate` keeps the session's data, so every action that
# opens a session calls this.
def auth_forget_impersonation
  session_delete("impersonator_id")
  session_delete("impersonator_version")
  session_delete("impersonation_started_at")
end

# Who may create an account at /signup, from AUTH_SIGNUP:
#
#   first_user  (default) only while no account exists: the first visitor
#               bootstraps the app and becomes its admin, then sign-up closes
#   open        anyone, for a public app
#   closed      nobody: create accounts from a console, a seed or an admin page
#
# Any other value counts as `closed`, so a typo fails shut rather than open.
def auth_signup_mode
  mode = getenv("AUTH_SIGNUP").to_s.trim.downcase
  return "first_user" if mode.blank?
  return mode if ["open", "closed", "first_user"].includes?(mode)

  "closed"
end

# True when /signup may create an account right now.
def auth_signup_open?
  mode = auth_signup_mode()
  return true if mode == "open"
  return false if mode == "closed"

  User.count.zero?
end

# `first_user` asks for AUTH_SETUP_TOKEN: the first account becomes the
# admin, and on a freshly deployed app the first visitor to reach /signup is
# not necessarily you. Set AUTH_SETUP_TOKEN, then sign up with it; until it is
# set, no first account is created.
#
# Only a development or test run goes without: `soli serve --dev`, or
# APP_ENV=development / test. Asking "is this production?" instead left the
# door open on every deployment that forgot to say so.
def auth_setup_token_required?
  return false unless auth_signup_mode() == "first_user"
  return false if dev_mode?()

  !["development", "test"].includes?(getenv("APP_ENV").to_s.trim.downcase)
end

# Whether `given` unlocks the first sign-up (always, in development and test).
def auth_setup_token_ok?(given)
  return true unless auth_setup_token_required?()

  expected = getenv("AUTH_SETUP_TOKEN").to_s
  return false if expected.length < 16

  Crypto.secure_compare(given.to_s, expected)
end

# Base URL used in password-reset / confirmation emails.
#
# Read from the environment so a deployment sets it once, next to its other
# config, rather than by editing this file. The literal fallback is a dev
# convenience: left in place in production it mails `http://localhost` reset
# links, which are both useless and, if the host does resolve, sent in the
# clear. Set APP_BASE_URL to your `https://` origin.
def auth_base_url
  return getenv("APP_BASE_URL").to_s if getenv("APP_BASE_URL").present?

  "http://localhost:5011"
end

# Require a confirmed email before sign-in. Flip to true once SMTP is
# configured (SOLI_SMTP_* env vars — see the mailer docs) so users can
# actually receive the confirmation link.
#
# Always true when anyone may sign up (AUTH_SIGNUP=open): the sign-up form
# answers the same for a free address and a taken one, and that only holds if
# the account it may have created cannot be signed in to before its mailbox
# answered — otherwise "sign up, then try to sign in" tells which it was.
#
# Do not make this false while strangers can sign up. An account signed in
# to at sign-up counts as in use from its first second, so one created with
# your address and someone else's password is no longer taken back when you
# prove the address (`User#never_signed_in?`): its creator keeps their way
# in.
# A bulk write (`update_all`, `delete_all`) the database refuses raises. It
# used to answer with an "Error: …" string, and this guard is kept for a
# write that still would: where one that did not happen leaves a way into an
# account — a token not deleted, a counter not reset — the action stops.
def auth_written(result)
  # (`type`, not `.to_s`: on a hash — what a delete answers — a dot reads a key.)
  throw result if type(result) == "string" && result.starts_with?("Error:")

  result
end

# Remember this browser: a new remember-me token for `user`, in its cookie.
def auth_remember(user)
  # nil when the password changed while this sign-in was being checked.
  token = user.start_remember_me
  return if token.nil?

  # `secure` matters more here than on the session cookie: this one is a
  # 30-day bearer credential, and without the flag a single plaintext
  # request to the same host hands it to anyone on the path.
  set_cookie("remember_token", "#{user._key}:#{token}", {
    "max_age": AUTH_REMEMBER_DAYS * 86400,
    "http_only": true,
    "same_site": "Lax",
    "secure": true
  })
end

# After adding a way into `user`'s account — a token, a passkey, a linked
# provider, a device: is it kept? Not when the account's sessions were ended
# while this request ran (a password reset, `revoke_credentials`): the row
# was written by a session that is over, possibly after the sweep that
# removed its like, and it goes. `user` is the account as this request
# loaded it.
#
# The reset counts the version, sweeps, changes the password, counts again
# and sweeps again. A row written before a sweep is swept; one written after
# the last sweep is read back here after the last count, which no session
# opened before it matches.
def auth_credential_kept?(user, record)
  kept = false
  try
    current = User.find_by("_key", user._key)
    kept = !current.nil? && current.current_session_version == user.current_session_version
  catch error
    # The question could not be asked: the row is not kept on the strength
    # of an answer nobody gave.
    record.delete rescue nil
    throw error
  end
  return true if kept

  record.delete
  false
end

def auth_require_confirmed_email
  auth_signup_mode() == "open"
end

# The models of the optional generators that hold a way into an account, or
# something granted to it, as [class name, field holding the user's key]:
# `revoke_credentials` empties those the app has. The OpenID Connect
# provider's rows (`soli generate oidc_provider`) name the user by
# `user_key`; the others by `user_id`.
const USER_CREDENTIAL_MODELS = [
  ["OauthIdentity", "user_id"],
  ["SamlIdentity", "user_id"],
  ["PasskeyCredential", "user_id"],
  ["ApiToken", "user_id"],
  ["TwoFactor", "user_id"],
  ["MagicLink", "user_id"],
  ["Device", "user_id"],
  ["OauthConsent", "user_key"],
  ["OauthAuthorizationCode", "user_key"],
  ["OauthDeviceCode", "user_key"],
  ["OauthRefreshToken", "user_key"]
]

class User < Model
  # Fields: email, password_digest, role, plus the auth-flow fields:
  # reset_token_digest, reset_sent_at, confirmation_token_digest,
  # confirmation_sent_at, confirmed_at, remember_token_digest,
  # failed_attempts, locked_at.
  # (Model stores fields dynamically — no need to declare them.)
  validates(
    "email",
    {
      "presence": true,
      "uniqueness": true,
      "format": "email"
    }
  )
  before_save("normalize")

  def normalize
    @email = @email.trim.downcase unless @email.blank?
    @role = "member" if @role.blank?
  end

  # Hash `plaintext` and store it in `password_digest`. No-op when blank so a
  # profile update that doesn't change the password leaves the digest intact.
  # Callers that accept a *new* password must run `password_error` first —
  # this method deliberately has no opinion, so that a profile save with no
  # password field doesn't wipe the digest.
  def set_password(plaintext)
    return if plaintext.blank?

    @password_digest = Crypto.password_hash(plaintext)
  end

  # Why `plaintext` is unacceptable as a new password, or nil when it is fine.
  #
  # Length is the only rule here on purpose. Composition rules ("one digit,
  # one symbol") push people toward `Password1!` — they add a decimal digit of
  # real entropy and a lot of friction. Length is what actually raises the
  # cost of an offline attack against the Argon2id digest.
  def password_error(plaintext)
    value = plaintext.to_s
    return "Password is required" if value.blank?

    return "Password must be at least #{AUTH_MIN_PASSWORD_LENGTH} characters" if value.length < AUTH_MIN_PASSWORD_LENGTH

    nil
  end

  # True when `plaintext` matches the stored Argon2id digest. Never for an
  # account with no password, nor for one that signs in through single
  # sign-on only — and either costs the same work as a wrong password, so
  # the answer's timing does not tell such an account apart.
  def authenticate(plaintext)
    return User.burn_password_work(plaintext) if @sso_only? || @password_digest.blank?

    Crypto.password_verify(plaintext, @password_digest)
  end

  # An account that signs in through an identity provider only — created by
  # `soli generate saml`, or a directory-provisioned account SAML linked. It
  # has no password sign-in, no password reset, no magic link, no new API
  # token and no use of an old one, no passkey registration and no passkey
  # sign-in: every way in goes through the identity provider. There is no
  # single logout: a user removed at the identity provider keeps a session
  # open here until it ends (SAML_SESSION_TTL, 8 hours by default, or the
  # identity provider's SessionNotOnOrAfter), unless a SCIM deactivation
  # (`soli generate scim`) or `revoke_credentials` ends it first.
  def sso_only?
    @sso_only ? true : false
  end

  # Spend the same Argon2id work as a real `authenticate` without having an
  # account to check against. Sign-in calls this when no user matches the
  # submitted email: verifying costs ~100ms and returning early costs none, so
  # without it the response time alone tells an attacker which addresses are
  # registered — a user-enumeration oracle that no error-message wording can
  # close. The result is deliberately discarded.
  static def burn_password_work(plaintext)
    Crypto.password_hash(plaintext.to_s)
    false
  end

  # The database write a known address costs (a token stored, an attempt
  # counted), spent on no row: with the mail sent off the request
  # (`deliver_later`), an unknown address then answers in the same time.
  static def burn_write_work
    # Refused like a real one (`auth_written`): a database that takes no
    # writes answers the same for an address it knows and one it does not.
    auth_written(User.where({"_key": "no-such-user"}).update_all({"reset_sent_at": 0}))
    nil
  end

  def admin?
    @role == "admin"
  end

  # --- Password reset ---------------------------------------------------------

  # Issue a reset token: returns the plaintext token (goes into the email);
  # only its digest is stored.
  def start_password_reset
    token = uuid_v4()
    @reset_token_digest = Crypto.sha256(token)
    @reset_sent_at = DateTime.utc.to_unix
    @_patch({"reset_token_digest": @reset_token_digest, "reset_sent_at": @reset_sent_at})
    token
  end

  # Was a reset link sent in the last AUTH_RESEND_SECONDS? Then it is still
  # in the mailbox and stays the one that works: a second request — anyone
  # can make one for any address — used to replace it, so a request sent a
  # second after the owner's kept their link from ever working.
  def reset_recently_sent?
    @reset_token_digest.present? && DateTime.utc.to_unix - (@reset_sent_at ?? 0).to_i < AUTH_RESEND_SECONDS
  end

  def confirmation_recently_sent?
    @confirmation_token_digest.present? &&
      DateTime.utc.to_unix - (@confirmation_sent_at ?? 0).to_i < AUTH_RESEND_SECONDS
  end

  def reset_token_expired?
    return true if @reset_sent_at.nil?

    DateTime.utc.to_unix - @reset_sent_at > AUTH_RESET_TOKEN_TTL
  end

  # Set the new password, burn the token, and clear any lockout.
  #
  # Also drops the remember-me digest. Resetting a password is what someone
  # does when they think the account is compromised, and a remember-me cookie
  # outlives it by up to AUTH_REMEMBER_DAYS — leaving it valid means the reset
  # doesn't actually evict the attacker.
  #
  # Returns true when the new password is stored. The rows go first and the
  # account's own secrets last, as in `revoke_credentials`: a failure on a
  # row raises with the old password and the link still in place, so the
  # reset can be tried again — the other order could change the password,
  # burn the link, and leave a stranger's API token behind for good.
  #
  # The link is taken first, by a write that names the digest that was read:
  # of two requests completing the same link together, one finds it changed
  # and answers false — both went through, and the session of one outlived
  # the password of the other. A failure further down gives the link back.
  def finish_password_reset(plaintext)
    held = @reset_token_digest
    mark = nil
    unless held.blank?
      mark = "claimed:#{Crypto.random_hex(16)}"
      auth_written(User.where({"_key": @_key, "reset_token_digest": held}).update_all({"reset_token_digest": mark}))
      now_holds = User.find_by("_key", @_key)
      return false if now_holds.nil? || now_holds.reset_token_digest != mark
    end
    try
      @_reset_password_and_credentials(plaintext)
    catch error
      unless mark.nil?
        User.where({"_key": @_key, "reset_token_digest": mark}).update_all({"reset_token_digest": held}) rescue nil
      end
      throw error
    end
  end

  # What `finish_password_reset` does once the link is its own.
  def _reset_password_and_credentials(plaintext)
    # A reset is what someone does when the account may be in other hands:
    # the ways in that a visitor to the account could have added — API
    # tokens, passkeys, pending sign-in links, and the push devices that
    # receive its notifications — go with the old password.
    # (Linked providers and the authenticator app stay: they are the owner's.)
    #
    # The authenticator stays on purpose. Dropped here, the mailbox alone
    # would be enough to get past a second factor; kept, an authenticator
    # someone else enrolled with the old password locks the owner out until
    # an administrator removes it — the lesser of the two.
    #
    # Sessions end first, and before the rows go: a request of a session
    # that is being ended may still be adding a token, and it checks the
    # version after writing (`auth_credential_kept?`).
    @end_sessions
    @_reset_sweep.each do |name|
      model = const_get(name)
      auth_written(model.where({"user_id": @_key}).delete_all) unless model.nil?
    end
    @set_password(plaintext)
    @reset_token_digest = nil
    @reset_sent_at = nil
    @remember_token_digest = nil
    @remember_previous_digest = nil
    @remember_created_at = nil
    @failed_attempts = 0
    @locked_at = nil
    # The reset link went to the mailbox: whoever completes it holds the
    # address, which is all a confirmation proves. Without this an owner who
    # only ever reset their password stayed "unconfirmed", and their first
    # provider sign-in treated the account as squatted and wiped it.
    @confirmed_at = DateTime.utc.to_unix if @confirmed_at.nil?
    # Whoever resets the password holds the mailbox: no placeholder any
    # more. (Written here too, so that this whole-record write cannot put
    # back a mark another request cleared meanwhile.)
    @awaiting_owner = false
    # A confirmation link still in the mailbox is spent with it.
    @confirmation_token_digest = nil
    @confirmation_sent_at = nil
    # These fields and no others (`_patch`): the session version is counted
    # in the database, never written back from this copy.
    @_patch({
      "password_digest": @password_digest,
      "reset_token_digest": nil,
      "reset_sent_at": nil,
      "remember_token_digest": nil,
      "remember_previous_digest": nil,
      "remember_created_at": nil,
      "failed_attempts": 0,
      "locked_at": nil,
      "confirmed_at": @confirmed_at,
      "awaiting_owner": false,
      "confirmation_token_digest": nil,
      "confirmation_sent_at": nil
    })
    # And again, now that the old password opens nothing: a sign-in with it
    # that slipped in since the first count is behind this one — and what it
    # may have added since the sweep above goes in a second one.
    @end_sessions
    @_reset_sweep.each do |name|
      model = const_get(name)
      auth_written(model.where({"user_id": @_key}).delete_all) unless model.nil?
    end
    true
  end

  # The models a password reset empties for this account: what a visitor to
  # it could have added. Push devices are those of `soli generate devices`,
  # which names its model (PUSH_DEVICES_MODEL) — not whatever an app calls
  # Device.
  def _reset_sweep
    names = ["ApiToken", "PasskeyCredential", "MagicLink"]
    devices = const_get("PUSH_DEVICES_MODEL")
    names.push(devices) if type(devices) == "string"
    names
  end

  # Invalidate every session opened before this moment.
  #
  # Sessions are not indexed by user, so there is nothing to delete; instead
  # each session records the `session_version` it was opened at, and
  # `load_current_user` refuses one that is behind. Without this, an attacker
  # who was already signed in stayed signed in through the victim's reset —
  # which is the one thing a password reset is supposed to stop.
  #
  # Counted in the database (one atomic step, raising when it cannot be
  # made), not written from this copy of the record: two of these at once
  # both count, and neither can put an older number back.
  def end_sessions
    @increment("session_version")
    true
  end

  # Write these fields and no others. `@update` writes the whole record as
  # this request loaded it: a sign-in that started before a password reset
  # and finished after it (Argon2 takes a tenth of a second) would put the
  # old password, and the old session version, back.
  def _patch(fields)
    auth_written(User.where({"_key": @_key}).update_all(fields))
    true
  end

  # Bumped whenever every existing session must be invalidated (a password
  # reset, `revoke_credentials`; add other events here as they appear).
  def current_session_version
    @session_version ?? 0
  end

  # Remove every way into this account except its email address, and save:
  # the password, a pending reset link, the remember-me cookie, every open
  # session, and the rows of the optional generators tied to it (OAuth and
  # SAML identities, passkeys, API tokens, two-factor, magic links, push
  # devices, and the OpenID Connect provider's consents, codes and refresh
  # tokens — each only when the app has that model). Called when an account
  # whose address nobody proved is handed to the person an identity provider
  # vouches for: whoever created it keeps nothing.
  #
  # The rows go first, the account's own secrets last, and any failure
  # raises: a takeover that stops halfway leaves the account as it was
  # (password included) and the caller links nothing, and running it again
  # finishes the job. The reverse order could clear the password, fail on a
  # row, and leave a passkey or a token behind on an account that looked
  # cleaned. (Not one transaction: the models may live on other connections.)
  def revoke_credentials
    # Sessions first, as in `finish_password_reset`.
    @end_sessions
    @_sweep_credentials
    @password_digest = nil
    # Taken back from whoever made it, or revoked by its owner: either way
    # no placeholder any more (and this whole-record write must not put back
    # a mark another request cleared meanwhile).
    @awaiting_owner = false
    # (A SAML take-over sets it again after this; revoked on purpose, the
    # account is not waiting to be linked.)
    @saml_link_pending = false
    @reset_token_digest = nil
    @reset_sent_at = nil
    @remember_token_digest = nil
    @remember_previous_digest = nil
    @remember_created_at = nil
    @_patch({
      "password_digest": nil,
      "awaiting_owner": false,
      "saml_link_pending": false,
      "reset_token_digest": nil,
      "reset_sent_at": nil,
      "remember_token_digest": nil,
      "remember_previous_digest": nil,
      "remember_created_at": nil
    })
    # Again, and a second sweep, as in `finish_password_reset`.
    @end_sessions
    @_sweep_credentials
    true
  end

  # Delete the rows of USER_CREDENTIAL_MODELS that name this account.
  def _sweep_credentials
    USER_CREDENTIAL_MODELS.each do |entry|
      # `const_get` answers nil for a class this app does not have. Push
      # devices are the model `soli generate devices` names, not whatever
      # the app calls Device (see `_reset_sweep`).
      name = entry[0]
      name = const_get("PUSH_DEVICES_MODEL") if name == "Device"
      model = type(name) == "string" ? const_get(name) : nil
      unless model.nil?
        owner = {}
        owner[entry[1]] = @_key
        auth_written(model.where(owner).delete_all)
      end
    end
  end

  # --- Email confirmation -----------------------------------------------------
  def start_email_confirmation
    token = uuid_v4()
    @confirmation_token_digest = Crypto.sha256(token)
    @confirmation_sent_at = DateTime.utc.to_unix
    @_patch({
      "confirmation_token_digest": @confirmation_token_digest,
      "confirmation_sent_at": @confirmation_sent_at
    })
    token
  end

  # Confirmation links expire like reset links do.
  #
  # `confirmation_sent_at` was stored and never read, so a link stayed valid
  # forever: a forwarded email, an archived mailbox, or a link-following
  # security scanner could confirm the address (and, before the change below,
  # sign in as that user) months later.
  def confirmation_token_expired?
    return true if @confirmation_sent_at.nil?

    DateTime.utc.to_unix - @confirmation_sent_at > AUTH_CONFIRMATION_TOKEN_TTL
  end

  def confirm_email
    @confirmed_at = DateTime.utc.to_unix
    @confirmation_token_digest = nil
    @confirmation_sent_at = nil
    @_patch({"confirmed_at": @confirmed_at, "confirmation_token_digest": nil, "confirmation_sent_at": nil})
  end

  def confirmed?
    !@confirmed_at.nil?
  end

  # Is this account a placeholder — created at the sign-up form, by its
  # owner or by someone else with a password of their own, in wait — that
  # nobody has entered yet? Only such an account is *taken over* by a proof
  # of its address (a confirmation without the sign-up password, a sign-in
  # link, a provider): everything it could be entered with is revoked first.
  # An account that has been used keeps what its user set — its second
  # factor above all, which a mailbox alone must not remove.
  #
  # The sign-up form marks it (`awaiting_owner`); the first session or API
  # token of its own clears the mark. Marked, not inferred: an account made
  # any other way — by an administrator, a directory, a seed, or before this
  # mark existed — is never one, so nothing has to be set on existing
  # accounts and a missing field fails towards leaving the account alone.
  # (An open-sign-up app that already held unconfirmed accounts nobody
  # entered can mark them once: `User.where({"confirmed_at": nil}).update_all(
  # {"awaiting_owner": true})` — leave out any you know to be in use.)
  def never_signed_in?
    @awaiting_owner == true
  end

  def mark_signed_in
    return true unless @awaiting_owner == true

    @awaiting_owner = false
    @signed_in_at = DateTime.utc.to_unix
    @_patch({"awaiting_owner": false, "signed_in_at": @signed_in_at})
  end

  # --- Remember me ------------------------------------------------------------

  # A token for the "Remember me" cookie, or nil when the password changed
  # while this sign-in was being checked (Argon2 takes a tenth of a second):
  # the write names the password it was checked against, so a sign-in that
  # straddles a reset cannot leave a token behind for the old password.
  def start_remember_me
    token = uuid_v4()
    digest = Crypto.sha256(token)
    now = DateTime.utc.to_unix
    User.where({"_key": @_key, "password_digest": @password_digest}).update_all({
      "remember_token_digest": digest,
      "remember_previous_digest": nil,
      "remember_rotated_at": nil,
      "remember_created_at": now
    })
    return nil unless @_remember_digest_is?(digest)

    @remember_token_digest = digest
    @remember_previous_digest = nil
    @remember_created_at = now
    token
  end

  def forget_me
    return true if @remember_token_digest.blank?

    @remember_token_digest = nil
    @remember_previous_digest = nil
    @remember_created_at = nil
    @_patch({"remember_token_digest": nil, "remember_previous_digest": nil, "remember_created_at": nil})
  end

  # A remember-me token is used once: each time it restores a session it is
  # replaced (`load_current_user` sets the new cookie). The one it replaces
  # stays good for a minute, for the requests a browser sent side by side;
  # after that, seeing it again means two parties hold the cookie — a copy —
  # and remember-me is ended for the account (`remembered_by?`).
  #
  # Returns the new token, or nil when the stored one is no longer the one
  # this request read: another request replaced it first (its cookie
  # stands), or a password reset cleared it. The write is a compare-and-swap
  # on the digest, never an overwrite.
  def rotate_remember_me
    token = uuid_v4()
    digest = Crypto.sha256(token)
    current = @remember_token_digest
    now = DateTime.utc.to_unix
    User.where({"_key": @_key, "remember_token_digest": current}).update_all({
      "remember_token_digest": digest,
      "remember_previous_digest": current,
      "remember_rotated_at": now
    })
    return nil unless @_remember_digest_is?(digest)

    @remember_previous_digest = current
    @remember_rotated_at = now
    @remember_token_digest = digest
    token
  end

  # Is `digest` what the database holds now?
  def _remember_digest_is?(digest)
    stored = User.find_by("_key", @_key)
    !stored.nil? && stored.remember_token_digest == digest
  end

  # Is `token` the current one (the caller then rotates it)?
  def remember_current?(token)
    @remember_token_digest.present? && Crypto.secure_compare(Crypto.sha256(token.to_s), @remember_token_digest)
  end

  # The cookie's lifetime is the browser's to keep; this one is the
  # server's: a copied token stops working AUTH_REMEMBER_DAYS after it was
  # issued, whatever the copy says.
  def remembered_by?(token)
    return false if @remember_token_digest.blank?
    # A token from before tokens had an age (an app regenerated over its
    # users) is given one now, once, rather than refused.
    if @remember_created_at.nil?
      @remember_created_at = DateTime.utc.to_unix
      @_patch({"remember_created_at": @remember_created_at})
    end
    return false if DateTime.utc.to_unix - @remember_created_at.to_i > AUTH_REMEMBER_DAYS * 86400
    return true if @remember_current?(token)
    return false if @remember_previous_digest.blank?
    return false unless Crypto.secure_compare(Crypto.sha256(token.to_s), @remember_previous_digest)
    # The replaced token, within its minute: a request sent alongside the
    # one that rotated it.
    return true if DateTime.utc.to_unix - (@remember_rotated_at ?? 0).to_i <= 60

    # The replaced token, later: someone else holds a copy, and one of the
    # two is signed in right now. Nobody is remembered any more, every
    # session of the account ends, and the owner is told.
    Logger.warn("remember-me token of #{@email} reused after rotation: sessions ended")
    @forget_me
    @end_sessions
    AuthMailer.sessions_ended(this).deliver_later rescue nil
    false
  end

  # --- Account lockout --------------------------------------------------------
  def locked?
    return false if @locked_at.nil?

    if DateTime.utc.to_unix - @locked_at > AUTH_LOCKOUT_SECONDS
      # The lockout window has passed — auto-unlock.
      @locked_at = nil
      @failed_attempts = 0
      @_patch({"locked_at": nil, "failed_attempts": 0})
      return false
    end
    true
  end

  def register_failed_attempt
    # Don't re-stamp `locked_at` on an account that is *currently* locked:
    # doing so slides the 30-minute window forward on every further guess, so
    # an attacker who keeps knocking keeps the owner locked out indefinitely.
    # The lockout should expire on schedule no matter how loud the attack is.
    #
    # Ask `locked?` rather than testing `locked_at` directly — it is what
    # clears an expired stamp. Testing the raw field meant that once the first
    # lockout landed, nothing on the failure path ever cleared it, so
    # `failed_attempts` froze and the account could never lock a second time:
    # after the first window elapsed the attacker guessed at full rate forever.
    return true if @locked?

    # Only a password can be guessed. An account with none (single sign-on,
    # a directory-provisioned user) has nothing to lock, and counting wrong
    # passwords against it let anyone who knows the address lock its owner
    # out of the ways in that do work.
    # (The write the others cost is spent all the same, so the answer takes
    # as long and fails as they do when the database refuses writes.)
    if @sso_only? || @password_digest.blank?
      User.burn_write_work
      return true
    end

    # Counted in the database (`increment` is one atomic write): a read, +1
    # and save let parallel guesses overwrite each other's count, so a burst
    # of wrong passwords slipped past the lockout.
    @increment("failed_attempts")
    attempts = @failed_attempts ?? 0
    if attempts >= AUTH_MAX_FAILED_ATTEMPTS
      @locked_at = DateTime.utc.to_unix
      @_patch({"locked_at": @locked_at})
    end
    # One notification, from the guess that reached the limit.
    just_locked = attempts == AUTH_MAX_FAILED_ATTEMPTS

    # Tell the owner once, when the lock trips. The sign-in response says only
    # "Invalid email or password" whether or not the account is locked, because
    # a distinct "locked" reply during the lockout tells an attacker which guess
    # was the right one. Delivery failures must not break sign-in.
    if just_locked
      try
        AuthMailer.account_locked(this, AUTH_LOCKOUT_SECONDS / 60).deliver_later
      catch error
        Logger.warn("account-locked notification failed: #{error}")
      end
    end

    true
  end

  def clear_failed_attempts
    attempts = @failed_attempts ?? 0
    return if attempts == 0 && @locked_at.nil?

    @failed_attempts = 0
    @locked_at = nil
    @_patch({"failed_attempts": 0, "locked_at": nil})
  end
end
