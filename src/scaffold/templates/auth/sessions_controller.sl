# Sessions controller — login + logout. Generated by `soli generate auth`.
#
# Ships with a per-IP throttle (AUTH_ATTEMPTS_PER_IP per
# AUTH_IP_WINDOW_SECONDS), account lockout (AUTH_MAX_FAILED_ATTEMPTS wrong
# passwords lock the account for AUTH_LOCKOUT_SECONDS), optional remember-me
# (persistent HttpOnly + Secure cookie), and an optional confirmed-email gate
# (flip `auth_require_confirmed_email` in app/models/user.sl).
#
# The failure paths are deliberately uniform in both wording and cost: an
# unknown address and a wrong password produce the same message and the same
# response time, so sign-in cannot be used to enumerate accounts.

class SessionsController < Controller
  static {
    this.layout = "application"
  }

  # GET /login
  def new
    render(
      "sessions/new",
      {
        "title": "Sign in",
        "error": "",
        "email": "",
        "signup_open": auth_signup_open?()
      }
    )
  end

  # POST /login
  def create
    # Every refusal below answers after the same time (`_reject`): a known
    # address and an unknown one do not cost the same database work.
    @started = clock()
    email = params["email"].to_s.trim.downcase
    password = params["password"].to_s

    # First gate: how many sign-in attempts this source address gets. The
    # per-account lockout below is blind to credential stuffing (one guess
    # each against thousands of accounts) and it is itself abusable as a
    # denial of service against a known address. This closes both.
    limiter = rate_limiter_from_ip(req, AUTH_ATTEMPTS_PER_IP, AUTH_IP_WINDOW_SECONDS)
    return @_reject("Too many sign-in attempts. Try again in a few minutes.", email, 429) unless limiter.allowed

    user = User.find_by("email", email)

    # A locked account answers exactly like a wrong password, and its password
    # is not verified at all.
    #
    # The lockout check used to run *after* `authenticate`, which left two
    # problems. The response distinguished a correct password (403 "Account
    # locked") from a wrong one (401) throughout the lockout, so an attacker
    # spreading guesses across addresses could still find the password and
    # simply wait out the window — the lockout stopped nothing it was meant to
    # stop. And every guess against a locked account still paid for a full
    # Argon2id verification, so knocking on one known address was a cheap way to
    # burn server CPU.
    #
    # Work is still burned here so the timing matches a normal failure: the cost
    # is what makes a locked account indistinguishable from a wrong password and
    # from an address that was never registered. The owner learns about the lock
    # from the notification `register_failed_attempt` sends when it trips, not
    # from this response.
    if !user.nil? && user.locked?
      User.burn_password_work(password)
      User.burn_write_work
      return @_reject(@_failure_message, email, 401)
    end

    # Both branches must cost the same. `authenticate` runs Argon2id (~100ms);
    # bailing out on a missing account would return in microseconds, and that
    # difference is a reliable "is this address registered?" oracle no matter
    # how carefully the error message is worded.
    authenticated = user.nil? ? User.burn_password_work(password) : user.authenticate(password)

    unless authenticated
      # An address with no account costs the write a counted attempt does.
      user.nil? ? User.burn_write_work : user.register_failed_attempt
      return @_reject(@_failure_message, email, 401)
    end

    # The same answer as a wrong password: a distinct "confirm your email"
    # appeared only once the password was right, which confirmed it.
    if auth_require_confirmed_email() && !user.confirmed?
      # The write a counted wrong password costs: "sign up, then sign in"
      # must not tell a right password on an unconfirmed account from a
      # wrong one by its timing.
      User.burn_write_work
      return @_reject(@_failure_message, email, 401)
    end

    user.clear_failed_attempts
    # A new session, the user's alone (see `auth_open_session`).
    auth_open_session(user)

    if params["remember_me"].to_s == "1"
      # nil when the password changed while this sign-in was being checked.
      token = user.start_remember_me
      # `secure` matters more here than on the session cookie: this one is a
      # 30-day bearer credential, and without the flag a single plaintext
      # request to the same host hands it to anyone on the path.
      unless token.nil?
        set_cookie("remember_token", "#{user._key}:#{token}", {
          "max_age": AUTH_REMEMBER_DAYS * 86400,
          "http_only": true,
          "same_site": "Lax",
          "secure": true
        })
      end
    end

    redirect("/")
  end

  # DELETE /logout
  def destroy
    user_id = session_get("user_id")
    # The remember-me token is its owner's to drop: not an administrator's
    # acting as them, nor a visitor's who only got as far as the password,
    # nor a session a password reset has already ended. The account is read
    # here, and that read is not rescued: the user the middleware loaded
    # comes from a rescued read, and a database that did not answer it must
    # neither skip this (the token would stay alive behind a logout that
    # said it was done) nor let a half-signed-in session through.
    if !user_id.blank? && auth_own_session?(req)
      user = User.find_by("_key", user_id)
      # …or the request holds the token itself, which is proof enough to
      # end it: a session an expired one's cookie just restored is, on an
      # account with a second factor, waiting at the challenge.
      if !user.nil? && (@_fully_signed_in?(user) || @_holds_remember_token?(user))
        user.forget_me
      end
    end
    # Expire the remember-me cookie immediately.
    set_cookie("remember_token", "", {
      "max_age": 0,
      "http_only": true,
      "same_site": "Lax",
      "secure": true
    })
    session_destroy()
    redirect("/login")
  end

  private

  # Is this session `user`'s own, past every step of signing in? Its version
  # is current (no reset since), and where the app has two-factor and the
  # account turned it on, the session passed the challenge.
  def _fully_signed_in?(user)
    return false if session_get("session_version").to_i < user.current_session_version

    two_factor = const_get("TwoFactor")
    return true if two_factor.nil? || !two_factor.enabled?(user)

    session_get("two_factor").to_s == "ok:#{user._key}"
  end

  # Does this request carry `user`'s remember-me token — the current one,
  # or the one it replaced a moment ago (the middleware rotates it when it
  # restores a session, in this very request)?
  def _holds_remember_token?(user)
    given = (cookies["remember_token"] rescue nil).to_s
    return false unless given.includes?(":")

    parts = given.split(":")
    return false unless parts[0] == user._key.to_s

    digest = Crypto.sha256(parts[1].to_s)
    # The replaced one for its minute only, as `remembered_by?` reads it:
    # later it is a copy, not the holder's.
    replaced_lately = DateTime.utc.to_unix - (user.remember_rotated_at ?? 0).to_i <= 60
    stored = [user.remember_token_digest.to_s, replaced_lately ? user.remember_previous_digest.to_s : ""]
    stored.filter { |one| one.present? && Crypto.secure_compare(one, digest) }.length > 0
  end

  # What every refused sign-in says. With confirmation required it also
  # covers an unconfirmed account, which must not answer differently.
  def _failure_message
    return "Invalid email or password." unless auth_require_confirmed_email()

    "Invalid email or password — or, if you just signed up, confirm your email first (check your inbox)."
  end

  # Re-render the sign-in form with an error and an accurate status code.
  # Every failure path goes through here so none of them can drift into
  # leaking more than the others.
  def _reject(message, email, status)
    auth_uniform_wait(@started)
    render(
      "sessions/new",
      {
        "title": "Sign in",
        "error": message,
        "email": email,
        "signup_open": auth_signup_open?()
      },
      {"status": status}
    )
  end
end
