# Load the current user — generated by `soli generate auth`.
#
# Runs on every request (low order so it lands before app middleware). Reads
# the signed-in user id from the session and loads the User record into
# `req["current_user"]`, which `current_user()` / `authorize()` read. When no
# session exists, a valid remember-me cookie (set at login when the user
# ticked "Remember me") is promoted to a fresh session. Guests leave it nil.
# This never blocks the request — gating is the job of policies and the
# `require_login` pattern, not this loader.

# order: 5

def load_current_user(req)
  user_id = session_get("user_id")
  unless user_id.blank?
    user = User.find_by("_key", user_id) rescue nil
    # Sessions opened before the last password reset are refused.
    #
    # Server-side sessions are not indexed by user, so a reset cannot go and
    # delete them; each session instead carries the `session_version` it was
    # opened at. Without this an attacker who was already signed in survived the
    # victim's password reset, which defeats the one thing a reset is for.
    if !user.nil? && session_get("session_version").to_i < user.current_session_version
      session_destroy()
      return {"continue": true, "request": req}
    end
    # A sign-in that came with an end (SAML: the identity provider's
    # SessionNotOnOrAfter, or SAML_SESSION_TTL) ends here too, so a user
    # removed at the identity provider is out once it passes.
    expires_at = session_get("sign_in_expires_at")
    if !expires_at.nil? && DateTime.utc.to_unix >= expires_at.to_i
      session_destroy()
      return {"continue": true, "request": req}
    end
    # An impersonation (`soli generate auth --impersonation`) lasts while
    # the administrator behind it is still one, still holds the sessions it
    # was started from (a password reset, a demotion or a revocation ends it
    # here), and for AUTH_IMPERSONATION_SECONDS at most.
    admin_id = session_get("impersonator_id").to_s
    if admin_id.present?
      admin = User.find_by("_key", admin_id) rescue nil
      started_at = (session_get("impersonation_started_at") ?? 0).to_i
      over = admin.nil? || !admin.admin? ||
        (session_get("impersonator_version") ?? -1).to_i != admin.current_session_version ||
        DateTime.utc.to_unix - started_at > AUTH_IMPERSONATION_SECONDS
      if over
        session_destroy()
        return {"continue": true, "request": req}
      end
    end
    req["current_user"] = user
    return {"continue": true, "request": req}
  end

  # Remember-me: the cookie carries "<user key>:<token>"; only the token's
  # digest is stored, and the comparison is constant-time.
  remember = cookies["remember_token"] rescue nil
  if !remember.blank? && remember.includes?(":")
    parts = remember.split(":")
    user = User.find_by("_key", parts[0]) rescue nil
    # The gates of the sign-in form hold here too: an account that became
    # single sign-on only, or that must confirm its address first, is not
    # let back in by an old cookie.
    allowed = !user.nil? && !user.sso_only? && (user.confirmed? || !auth_require_confirmed_email())
    if allowed && user.remembered_by?(parts[1])
      session_regenerate()
      auth_forget_impersonation()
      # No `auth_time`: nobody signed in just now.
      session_delete("auth_time")
      session_set("user_id", user._key)
      session_set("session_version", user.current_session_version)
      req["current_user"] = user
      # Used once: replaced now, for whatever is left of its lifetime.
      if user.remember_current?(parts[1])
        left = AUTH_REMEMBER_DAYS * 86400 - (DateTime.utc.to_unix - (user.remember_created_at ?? 0).to_i)
        set_cookie("remember_token", "#{user._key}:#{user.rotate_remember_me}", {
          "max_age": left,
          "http_only": true,
          "same_site": "Lax",
          "secure": true
        })
      end
    end
  end
  {"continue": true, "request": req}
end
