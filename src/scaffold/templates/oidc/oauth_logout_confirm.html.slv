<div class="min-h-screen flex items-center justify-center px-4">
  <div class="w-full max-w-md text-center">
    <% if signed_out %>
      <h1 class="text-2xl font-bold mb-3">You are signed out</h1>
      <p class="text-slate-400 mb-6">
        There is no session to end on this device.
      </p>
      <% if post_logout_redirect_uri.present? %>
        <a href="<%= post_logout_redirect_uri %>"
           class="rounded-md bg-indigo-600 hover:bg-indigo-700 px-4 py-2 font-medium text-white transition-colors">
          Return to the application
        </a>
      <% end %>
    <% else %>
      <h1 class="text-2xl font-bold mb-3">Sign out?</h1>
      <p class="text-slate-400 mb-6">
        This will end your session on this device.
      </p>
      <%- form_with(null, {"url": "/oauth/logout", "method": "post"}) do |f| -%>
        <% if post_logout_redirect_uri.present? %>
          <input type="hidden" name="post_logout_redirect_uri" value="<%= post_logout_redirect_uri %>">
          <input type="hidden" name="id_token_hint" value="<%= id_token_hint %>">
        <% end %>
        <%- f.submit("Sign out") %>
      <%- end -%>
      <p class="text-xs text-slate-500 mt-6">
        You are seeing this because the sign-out was requested by a plain link.
        Confirming here is what tells us the request was yours: without it, any
        page you visit could sign you out just by loading an image.
      </p>
    <% end %>
  </div>
</div>
