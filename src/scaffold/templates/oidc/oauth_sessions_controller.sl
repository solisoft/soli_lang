# RP-initiated logout — generated by `soli generate oidc_provider`.

class OauthSessionsController < Controller
  # GET /oauth/logout
  # POST /oauth/logout
  #
  # Ends the session here, then optionally returns the browser to the relying
  # party. The return URI is honoured only when it is one the client
  # registered (`post_logout_redirect_uris`, or its redirect_uris for a client
  # registered without them) — an unchecked post_logout_redirect_uri is an
  # open redirect in exactly the same way the authorization endpoint's would be.
  def end_session
    hint = @_verified_hint
    destination = @_post_logout_destination(hint)

    # Nobody is signed in here, so there is nothing to end — and nothing to
    # tie the request to this browser. Redirecting straight away would make
    # this endpoint bounce any visitor anywhere a hint (anyone's own
    # id_token) allows; the "signed out" page links back instead.
    if current_user().nil?
      # A session that is not signed in to the end — waiting for its second
      # factor, or whose account could not be read — is ended by the
      # confirmed form all the same: "there is no session" must be true
      # when it is said. (A bare GET ends nothing: see below.)
      Session.destroy if req["method"] == "POST" && !Session.get("user_id").to_s.blank?
      return render(
        "oauth/logout_confirm",
        {
          "signed_out": true,
          "post_logout_redirect_uri": destination,
          "id_token_hint": "",
          "client_name": @_client_name(hint)
        }
      )
    end

    # A bare GET must not end the session: `<img src="/oauth/logout">` on any
    # page would log the visitor out, and the same-origin CSRF gate covers only
    # state-changing methods. A GET carrying an `id_token_hint` this provider
    # signed, for the user signed in here, is a real RP-initiated logout and
    # proceeds; anything else gets a confirmation page, which is what turns
    # the click into intent.
    #
    # `logout_confirmation` posts back to this same route, and the POST is
    # covered by the CSRF gate like any other form.
    unless @_request_confirms_logout(hint)
      return render(
        "oauth/logout_confirm",
        {
          "signed_out": false,
          "post_logout_redirect_uri": destination.blank? ? "" : destination,
          "id_token_hint": destination.blank? ? "" : params["id_token_hint"].to_s,
          "client_name": @_client_name(hint)
        }
      )
    end

    # End the session as `DELETE /logout` does: without forgetting the
    # remember-me token, the next request restores the session from its
    # cookie and the relying party's "sign in" finds the user still here.
    # The token is its owner's to drop, as there: not an administrator's
    # acting as them, nor an API token's.
    current_user()&.forget_me if auth_own_session?(req)
    Cookie.set("remember_token", "", {
      "max_age": 0,
      "http_only": true,
      "same_site": "Lax",
      "secure": true
    })
    Session.destroy

    return redirect_external(destination) unless destination.blank?

    redirect("/")
  end

  private

  # Did this request actually ask to log out, rather than merely load a URL?
  # Either a POST (CSRF-checked), or a GET whose verified hint names the user
  # signed in here. A hint for someone else — an attacker's own id_token for
  # the same client — proves nothing about this browser's user.
  def _request_confirms_logout(hint)
    return true if req["method"].to_s.upcase == "POST"
    return false if hint.nil?

    user = current_user()
    !user.nil? && hint["sub"].to_s == user["_key"].to_s
  end

  # The claims of `id_token_hint` when this provider signed it, or nil.
  #
  # The hint used to be read with `JWT.decode_unsafe`, so anyone could write
  # one naming any client and skip the confirmation page. The signature and
  # issuer are checked now; the expiry is not, on purpose: OpenID Connect
  # RP-Initiated Logout §2 lets a relying party send an id_token that has
  # since expired (they live ten minutes; sessions last longer), so the
  # leeway is a year. Both the active and the previous key are tried, so a
  # hint signed before a key rotation still verifies.
  def _verified_hint
    hint = params["id_token_hint"].to_s
    return nil if hint.blank?

    for key in [oidc_public_key(), oidc_previous_public_key()]
      next if key.blank?

      # `JWT.verify` raises on a token whose header does not parse.
      claims = JWT.verify(hint, "", {
        "algorithm": "RS256",
        "key": key,
        "issuer": oidc_issuer(),
        "leeway": 31536000
      }) rescue nil
      next if claims.nil? || claims["error"] == true
      # An access token carries the same signature and issuer; it is not an
      # id_token.
      return nil unless claims["scope"].nil?

      return claims
    end

    nil
  end

  # The application asking for the sign-out, for the confirmation page to
  # name: a person should see who sends them where before they agree.
  def _client_name(hint)
    return "" if hint.nil?

    client = OauthClient.find_active(hint["aud"].to_s)
    client.nil? ? "" : client.name.to_s
  end

  def _post_logout_destination(hint)
    requested = params["post_logout_redirect_uri"].to_s
    return "" if requested.blank?
    return "" if hint.nil?

    # The hint names the client (its audience), whose registrations the URI
    # is checked against.
    client = OauthClient.find_active(hint["aud"].to_s)
    return "" if client.nil?
    return "" unless client.post_logout_redirect_uri_allowed?(requested)

    requested
  end
end
