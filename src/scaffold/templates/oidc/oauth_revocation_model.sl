# Access-token denylist — generated by `soli generate oidc_provider`.
# Collection: oauth_revocations
#
# Access tokens are self-contained JWTs, so a resource server verifying one
# offline cannot know it was revoked. This table closes that window for *this*
# provider's own endpoints (userinfo, refresh). It stays small because rows are
# only written on an explicit revoke or a detected token reuse, and each one
# can be dropped once `expires_at` has passed.

class OauthRevocation < Model
  # Fields: jti, expires_at, reason.
  static def revoke(jti, reason)
    return false if jti.to_s.blank?
    return true if OauthRevocation.revoked?(jti)

    stored = OauthRevocation.create({
      "jti": jti.to_s,
      "reason": reason,
      "expires_at": DateTime.utc().to_unix() + OIDC_ACCESS_TOKEN_TTL
    })
    OauthRevocation.must_be_stored(stored, jti.to_s)
    # Past this point the token has expired on its own and the row is
    # redundant — prune on whatever schedule suits you.

    return true
  end

  # A revoked refresh-token family (`chain_id`), remembered for as long as one
  # of its tokens could still be presented. Revoking the rows that exist is
  # not enough: a rotation in flight inserts the next token after the rows
  # were read, and that token would outlive the revocation.
  static def revoke_family(chain_id, reason)
    return false if chain_id.to_s.blank?

    marker = "chain:#{chain_id}"
    return true if OauthRevocation.revoked?(marker)

    stored = OauthRevocation.create({
      "jti": marker,
      "reason": reason,
      "expires_at": DateTime.utc().to_unix() + OIDC_REFRESH_TOKEN_TTL
    })
    OauthRevocation.must_be_stored(stored, marker)

    return true
  end

  # A revocation the database did not store revokes nothing: `create`
  # hands back an unsaved record then, and "revoked" must not be answered
  # over a token that still works. (Refused because another request wrote
  # the same row first is fine: it is there.)
  static def must_be_stored(record, jti)
    return if (record._errors ?? []).length == 0
    return if OauthRevocation.revoked?(jti)

    throw "the revocation of #{jti} could not be stored: #{record._errors}"
  end

  static def family_revoked?(chain_id)
    return false if chain_id.to_s.blank?

    return OauthRevocation.revoked?("chain:#{chain_id}")
  end

  static def revoked?(jti)
    return false if jti.to_s.blank?

    return !OauthRevocation.find_by("jti", jti.to_s).nil?
  end
end
