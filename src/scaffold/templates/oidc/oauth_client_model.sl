# Registered relying party — generated by `soli generate oidc_provider`.
# Collection: oauth_clients
#
# Register one from a console or a seed:
#
#   result = OauthClient.register("My App", ["https://app.example/callback"],
#                                 { "client_type": "confidential" })
#   print(result["client_id"])
#   print(result["client_secret"])   # shown once — only its digest is stored

class OauthClient < Model
  # Fields: client_id, client_secret_digest, client_type, name, redirect_uris,
  # scopes, grant_types, require_pkce, skip_consent, request_object_key,
  # introspect_any, post_logout_redirect_uris, disabled_at.

  # Create a client and return the credentials. The secret is returned in the
  # clear exactly once, because only its Argon2 digest is persisted.
  static def register(name, redirect_uris, options)
    options = options ?? {}
    client_type = options["client_type"] ?? "confidential"
    # The rule dynamic registration applies: https, or plain http to this
    # machine only. A plain-http redirect to a remote host sends the code
    # across the network in the clear.
    invalid = redirect_uris.filter(fn(uri) { !OauthClient.registrable_redirect_uri?(uri) })
    if invalid.length() != 0
      throw ("redirect_uris must be https URLs (plain http only to localhost / 127.0.0.1 / [::1]) " +
        "without a fragment: #{invalid.join(", ")}")
    end
    post_logout = options["post_logout_redirect_uris"]
    unless post_logout.nil?
      invalid = post_logout.filter(fn(uri) { !OauthClient.registrable_redirect_uri?(uri) })
      if invalid.length() != 0
        throw ("post_logout_redirect_uris must be https URLs (plain http only to localhost / 127.0.0.1 / [::1]) " +
          "without a fragment: #{invalid.join(", ")}")
      end
    end

    attributes = {
      "client_id": nanoid(24),
      "name": name,
      "client_type": client_type,
      "redirect_uris": redirect_uris,
      "scopes": options["scopes"] ?? [
        "openid",
        "profile",
        "email",
        "offline_access"
      ],
      "grant_types": options["grant_types"] ?? ["authorization_code", "refresh_token"],
      "require_pkce": client_type == "public" ? true : (options["require_pkce"] ?? true),
      "skip_consent": options["skip_consent"] ?? false,
      # Public PEM the client signs authorization request objects (JAR, RFC 9101)
      # with. Empty means the client cannot use `request=`.
      "request_object_key": options["request_object_key"] ?? "",
      # A resource server that introspects tokens issued to other clients.
      # Every other client introspects only its own (/oauth/introspect).
      "introspect_any": options["introspect_any"] == true,
      # Where /oauth/logout may send the browser back to. Left out (nil), the
      # client's redirect_uris serve, as they did before this field existed;
      # an empty list means nowhere.
      "post_logout_redirect_uris": post_logout,
      "client_secret_digest": null,
      "disabled_at": null
    }
    # A public client cannot keep a secret, so PKCE is the only thing binding
    # the code to the requester. Never let it be switched off for one.

    secret = ""
    if client_type == "confidential"
      secret = Crypto.random_token()
      attributes["client_secret_digest"] = Crypto.argon2_hash(secret)
    end

    client = OauthClient.create(attributes)

    return {
      "client": client,
      "client_id": attributes["client_id"],
      "client_secret": secret
    }
  end

  # `redirect_external` (and the spec) only accept absolute http(s) URLs, and
  # RFC 6749 §3.1.2 forbids a fragment. Rejecting at registration means the
  # failure surfaces here rather than mid-flow with a half-built authorization.
  static def valid_redirect_uri?(uri)
    return false if uri.to_s.blank?
    return false if uri.to_s.contains("#")

    return uri.to_s.starts_with("http://") || uri.to_s.starts_with("https://")
  end

  # What dynamic registration accepts: https, or http to this machine only
  # (127.0.0.1, [::1], localhost — RFC 8252 §7.3, for native apps and
  # development). A plain-http redirect to a remote host sends the
  # authorization code across the network in the clear.
  static def registrable_redirect_uri?(uri)
    return false unless OauthClient.valid_redirect_uri?(uri)

    text = uri.to_s
    # A backslash is a path separator to some URL parsers and part of the host
    # to others: `http://localhost:80\evil.example` is evil.example to a browser.
    return false if text.contains("\\")
    return true if text.starts_with("https://")

    rest = text.substring(7, text.length())
    ["127.0.0.1", "[::1]", "localhost"].any? { |host| OauthClient.loopback_authority?(rest, host) }
  end

  # Is `rest` (a URL with its `http://` cut off) `host`, then nothing but an
  # optional `:port` and a path or query? Anything else after the host —
  # `localhost.evil.example`, `[::1]evil.example`, `localhost@evil.example` —
  # names another machine.
  static def loopback_authority?(rest, host)
    return false unless rest.downcase().starts_with(host)

    tail = rest.substring(host.length(), rest.length())
    return true if tail.blank? || tail.starts_with("/") || tail.starts_with("?")
    return false unless tail.starts_with(":")

    port = tail.substring(1, tail.length()).split("/")[0].split("?")[0]
    !port.match("^[0-9]{1,5}$").nil?
  end

  # May this client introspect a token issued to `token_client_id`?
  def may_introspect?(token_client_id)
    return true if this.introspect_any == true

    token_client_id.to_s == this.client_id.to_s
  end

  static def find_active(client_id)
    return null if client_id.to_s.blank?

    client = OauthClient.find_by("client_id", client_id.to_s)
    return null if client.nil?
    return null unless client["disabled_at"].nil?

    return client
  end

  def public?
    this.client_type == "public"
  end

  # Exact match against a registered URI — byte for byte, no prefix matching,
  # no wildcards, no normalization. Anything looser lets an attacker who can
  # register a lookalike path harvest authorization codes.
  def redirect_uri_allowed?(candidate)
    return false if candidate.to_s.blank?

    return (this.redirect_uris ?? []).includes?(candidate.to_s)
  end

  # Where /oauth/logout may return the browser: an exact match against
  # `post_logout_redirect_uris`, or, for a client registered without that
  # field (every client made before it existed), against its redirect_uris.
  def post_logout_redirect_uri_allowed?(candidate)
    return false if candidate.to_s.blank?

    registered = this.post_logout_redirect_uris
    return this.redirect_uri_allowed?(candidate) if registered.nil?

    registered.includes?(candidate.to_s)
  end

  def authenticate_secret(secret)
    return false if this.client_secret_digest.blank?
    return false if secret.to_s.blank?

    Crypto.argon2_verify(secret.to_s, this.client_secret_digest)
  end

  # Narrow a requested scope set to what this client may actually have. An
  # unknown scope is dropped rather than rejected, per RFC 6749 §3.3.
  def allowed_scopes(requested)
    granted = this.scopes ?? []

    requested.filter(fn(scope) { granted.includes?(scope) && OIDC_SUPPORTED_SCOPES.includes?(scope) })
  end

  def supports_grant?(grant_type)
    return (this.grant_types ?? []).includes?(grant_type.to_s)
  end
end
