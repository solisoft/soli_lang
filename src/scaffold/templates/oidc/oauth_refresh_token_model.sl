# Refresh token — generated by `soli generate oidc_provider`.
# Collection: oauth_refresh_tokens
#
# Refresh tokens rotate: every use issues a new one and retires the old. A
# retired token being presented again means it leaked, so the whole family
# (`chain_id`) is revoked — the legitimate holder and the attacker both lose
# access, which is the correct outcome because we cannot tell them apart.

class OauthRefreshToken < Model
  # Fields: token_digest, chain_id, client_id, user_key, scope, issued_at,
  # expires_at, rotated_at, revoked_at, revoked_reason, access_jti,
  # session_version (the user's, at issue: a refresh after it moved — a
  # password reset — is refused and ends the chain).
  #
  # `chain_expires_at` is the family's ceiling: the previous token's when
  # rotating, the sign-in's own expiry (or nil) for the first one. A family
  # never outlives OIDC_REFRESH_CHAIN_TTL from its first token, and past its
  # ceiling no token is issued (nil is returned).
  static def issue(chain_id, client_id, user_key, scopes, access_jti, session_version = 0, chain_expires_at = nil, first = true)
    token = Crypto.random_token()
    now = DateTime.utc().to_unix()
    ceiling = chain_expires_at
    if first
      ceiling = now + OIDC_REFRESH_CHAIN_TTL
      ceiling = chain_expires_at.to_i if !chain_expires_at.nil? && chain_expires_at.to_i < ceiling
    end
    # A row from before families had a ceiling gets one now.
    ceiling = now + OIDC_REFRESH_CHAIN_TTL if ceiling.nil?
    return nil if ceiling.to_i <= now

    expires_at = now + OIDC_REFRESH_TOKEN_TTL
    expires_at = ceiling.to_i if ceiling.to_i < expires_at

    record = OauthRefreshToken.create({
      "token_digest": Crypto.sha256(token),
      "chain_id": chain_id,
      "client_id": client_id,
      "user_key": user_key,
      "scope": scopes.join(" "),
      "issued_at": now,
      "expires_at": expires_at,
      "chain_expires_at": ceiling.to_i,
      "rotated_at": null,
      "revoked_at": null,
      "revoked_reason": null,
      "access_jti": access_jti,
      "session_version": session_version ?? 0
    })
    # The family was revoked while this token was being minted (a reuse was
    # detected, the user disconnected the app, the client revoked): it is
    # born revoked, and the access token issued with it is denylisted.
    # `revoke_chain` writes its marker before it reads the rows, so a token
    # it did not see always finds the marker here.
    if OauthRevocation.family_revoked?(chain_id)
      record.revoked_at = now
      record.revoked_reason = "family_revoked"
      record.update()
      OauthRevocation.revoke(access_jti, "family_revoked")
    end

    return token
  end

  static def find_by_token(token)
    return null if token.to_s.blank?

    return OauthRefreshToken.find_by("token_digest", Crypto.sha256(token.to_s))
  end

  # Revoke every token in a family and denylist the access tokens they were
  # issued alongside, so a detected leak does not leave a live credential.
  static def revoke_chain(chain_id, reason)
    return 0 if chain_id.to_s.blank?

    # The marker first, then the rows: see `issue`.
    OauthRevocation.revoke_family(chain_id, reason)
    now = DateTime.utc().to_unix()
    tokens = OauthRefreshToken.where({"chain_id": chain_id.to_s})
    tokens.each do |token|
      OauthRevocation.revoke(token["access_jti"], reason)
      next unless token["revoked_at"].nil?

      token.revoked_at = now
      token.revoked_reason = reason
      token.update()
    end

    return tokens.length()
  end

  def active?
    return false unless this.revoked_at.nil?
    return false unless this.rotated_at.nil?
    return false if this.expires_at.nil?

    DateTime.utc().to_unix() < this.expires_at
  end

  # Already rotated = this token was superseded by a newer one. Seeing it again
  # is the reuse signal.
  def reused?
    !this.rotated_at.nil?
  end

  def mark_rotated
    this.rotated_at = DateTime.utc().to_unix()

    this.update()
  end

  # Claim a refresh token for rotation, atomically.
  #
  # The controller used to read the row, check `reused?`/`active?`, then write
  # `rotated_at` in a separate step. Two concurrent presentations of the same
  # token both passed the checks before either wrote, so both were rotated into
  # the same chain and the reuse signal — the whole point of rotation — was lost
  # for that pair. Authorization codes were made atomic for exactly this reason
  # (`OauthAuthorizationCode.burn`); refresh tokens were not.
  #
  # A single filtered UPDATE lets the database decide the winner: the loser
  # matches no row and is treated as reuse.
  static def claim_for_rotation(token)
    return null if token.to_s.blank?

    digest = Crypto.sha256(token.to_s)
    now = DateTime.utc().to_unix()
    rows = @sdbql{
      FOR t IN oauth_refresh_tokens
        FILTER t.token_digest == #{digest}
          AND t.rotated_at == null
          AND t.revoked_at == null
          AND t.expires_at > #{now}
        UPDATE t WITH { rotated_at: #{now} } IN oauth_refresh_tokens
        RETURN NEW
    }
    # A failed query comes back as an error *string*, so anything that is not an
    # array means "did not claim" rather than something to trust.
    return null unless rows.is_a?("array")

    return rows.first()
  end

  def scopes
    oidc_scope_list(this.scope)
  end
end
