<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <% host = req["headers"]["host"].to_s %>
  <% origin = (host.starts_with?("localhost") || host.starts_with?("127.") ? "http://" : "https://") + host %>
  <% description = @description ?? "Run a Soli web app inside a Cloudflare Worker: the interpreter compiled to WebAssembly." %>
  <title><%= @title %> · Soli at the edge</title>
  <meta name="description" content="<%= description %>">
  <link rel="canonical" href="<%= origin + req["path"] %>">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Soli at the edge">
  <meta property="og:title" content="<%= @title %> · Soli at the edge">
  <meta property="og:description" content="<%= description %>">
  <meta property="og:url" content="<%= origin + req["path"] %>">
  <meta property="og:image" content="<%= origin %>/images/og.png">
  <meta property="og:image:type" content="image/png">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="A Soli web app inside a Cloudflare Worker: worker.js, the Soli interpreter in WebAssembly, your app, and D1.">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= @title %> · Soli at the edge">
  <meta name="twitter:description" content="<%= description %>">
  <meta name="twitter:image" content="<%= origin %>/images/og.png">
  <meta name="theme-color" content="#0F1D33">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700&family=Barlow:wght@400;500;600&display=swap">
  <link rel="stylesheet" href="/css/site.css">
  <link rel="stylesheet" media="(prefers-color-scheme: light)" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/styles/github.min.css">
  <link rel="stylesheet" media="(prefers-color-scheme: dark)" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/styles/github-dark.min.css">
  <script defer src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/highlight.min.js"></script>
  <script defer src="/js/code.js"></script>
</head>
<body>
  <header class="top">
    <a class="brand" href="/">Soli <span>at the edge</span></a>
    <nav>
      <a href="/guide">Guide</a>
      <a href="/limits">Limits</a>
      <a href="/try">Try it</a>
      <a href="/d1">D1</a>
      <a href="/api/info">API</a>
    </nav>
  </header>
  <main>
    <%- yield %>
  </main>
  <footer>
    <% if @runtime %>
      <p>
        Rendered by Soli <strong><%= @runtime["version"] %></strong>
        on <strong><%= @runtime["runtime"] %></strong>,
        datacenter <strong><%= @runtime["colo"] %></strong>
        (visitor in <%= @runtime["country"] %>), at <%= @runtime["rendered_at"] %>.
      </p>
    <% end %>
    <p><a href="https://github.com/solisoft/soli_lang">Soli</a> · this site is <code>examples/cloudflare-worker</code> in the Soli repository.</p>
  </footer>
</body>
</html>
