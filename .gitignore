/target
node_modules
.dmux/

# LLVM coverage profile artifacts from `cargo test` runs.
*.profraw

# Per-app secrets — never commit (e.g. SOLI_DEPLOY_API_KEY).
.env
.env.*
!.env.sample
!.env.example
# Test-fixture apps must carry their own `.env.test`: the test runner refuses to
# start without one, so a fixture whose file is ignored passes locally and fails
# on a clean checkout with "".env.test file not found". These hold no secrets.
!tests-e2e/*/.env.test
.claude/settings.local.json
# Anchored to the repo root: the unanchored `tasks*` also matched
# `evals/tasks/`, so the eval harness's task fixtures were never committed and
# `scripts/evals/run.py` raised FileNotFoundError on a clean clone.
/tasks*

# codegraph sub-crate build artifacts
/codegraph/target/
/codegraph/Cargo.lock

# generated builtin API coverage audit
/builtin_coverage_report.md

# bytecode cache from scripts/builtin_audit.py
__pycache__/

# libFuzzer crash/timeout repros. Transient by nature and uploaded by the Fuzz
# workflow; a repro worth keeping becomes a case in the relevant test module
# (see `hostile_input_errors_instead_of_panicking_or_hanging`). The curated
# seed corpus under fuzz/corpus/ IS tracked; a fuzzing run's own corpus growth
# is not — it reached 16 MB in one session.
/fuzz/artifacts/
