<%# The sidebar. Its order — and the previous/next arrows at the foot of every
    page — come from `docs_nav_sections()` in app/helpers/docs_nav.sl, so the two
    cannot disagree. Add a page there, not here.

    An item marked `"collapsible": true` owns the `"indent"` items that follow it:
    they start hidden, open when the current page is the item or one of them
    (`syncNavGroups` in the docs layout), and its chevron toggles them. %>
<% for section in docs_nav_sections() %>
<% group = "" %>
<div><h5 class="flex items-center gap-2 px-3 text-xs font-semibold text-gray-500 uppercase tracking-wider mb-3"><%- section["icon"] %><%= section["title"] %></h5><ul class="space-y-1">
<% for item in section["items"] %>
<% if item["indent"].present? %>
<li class="nav-group-child" data-nav-parent="<%= group %>"<% if group.present? %> hidden<% end %>><a href="<%= item["path"] %>" class="sidebar-link block px-4 py-2.5 text-sm rounded-lg transition-all text-gray-400 hover:bg-white/5 hover:text-white pl-8"><%= item["label"] %></a></li>
<% elsif item["collapsible"].present? %>
<% group = item["path"] %>
<li class="flex items-center"><a href="<%= item["path"] %>" class="sidebar-link flex-1 block px-4 py-2.5 text-sm rounded-lg transition-all text-gray-400 hover:bg-white/5 hover:text-white"><%= item["label"] %></a><button type="button" class="nav-group-toggle shrink-0 p-2 rounded-lg text-gray-500 hover:text-white hover:bg-white/5" data-nav-group="<%= group %>" aria-expanded="false" aria-label="Show the <%= item["label"] %> pages"><svg class="w-4 h-4 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg></button></li>
<% else %>
<% group = "" %>
<li><a href="<%= item["path"] %>" class="sidebar-link block px-4 py-2.5 text-sm rounded-lg transition-all text-gray-400 hover:bg-white/5 hover:text-white"><%= item["label"] %></a></li>
<% end %>
<% end %>
</ul></div>
<% end %>
