<%# The sidebar. Its order — and the previous/next arrows at the foot of every
    page — come from `docs_nav_sections()` in app/helpers/docs_nav.sl, so the two
    cannot disagree. Add a page there, not here. %>
<% for section in docs_nav_sections() %>
<div><h5 class="flex items-center gap-2 px-3 text-xs font-semibold text-gray-500 uppercase tracking-wider mb-3"><%- section["icon"] %><%= section["title"] %></h5><ul class="space-y-1"><% for item in section["items"] %><li><a href="<%= item["path"] %>" class="sidebar-link block px-4 py-2.5 text-sm rounded-lg transition-all text-gray-400 hover:bg-white/5 hover:text-white<% if item["indent"].present? %> pl-8<% end %>"><%= item["label"] %></a></li><% end %></ul></div>
<% end %>
