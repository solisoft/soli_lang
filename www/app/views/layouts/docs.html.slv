<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> — Soli docs</title>
    <meta name="description" content="<%= docs_og ? docs_og["description"] : "Soli documentation: the language, the web framework, the ORM, views, jobs, mail, PDF, live views, testing and deploy — all in one binary." %>">

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Fraunces:opsz,wght@9..144,600;9..144,700&family=Instrument+Sans:wght@400;500;600&display=swap" rel="stylesheet">

    <!-- Highlight.js for syntax highlighting -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/styles/atom-one-dark.min.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/highlight.min.js"></script>

    <!-- Fuse.js for search -->
    <script src="https://cdn.jsdelivr.net/npm/fuse.js@7.0.0"></script>

    <script src="<%= public_path("js/theme.js") %>"></script>
    <link rel="stylesheet" href="<%= public_path("css/application.css") %>">
    <style>
        body { font-family: 'Inter', sans-serif; }
        code, pre { font-family: 'JetBrains Mono', monospace; }

        /* Premium scrollbar */
        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb {
            background: rgba(245, 158, 11, 0.25);
            border-radius: 3px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: rgba(245, 158, 11, 0.45);
        }

        /* Page Transition */
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .animate-fade-in {
            animation: fadeIn 0.5s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
        }

        /* Premium Code block styling */
        pre {
            margin: 0 !important;
            padding: 0 !important;
            background: #171412 !important;
            border-radius: 0.5rem !important;
            border: 1px solid rgba(255, 255, 255, 0.08) !important;
            position: relative;
            overflow: hidden !important;
        }

        /* Code block filename label */
        pre[data-filename]::before {
            content: attr(data-filename);
            display: flex;
            align-items: center;
            justify-content: center;
            height: 36px;
            background: rgba(255, 255, 255, 0.03);
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
            color: #9ca3af;
            font-family: 'Inter', sans-serif;
            font-size: 0.75rem;
            font-weight: 500;
        }

        pre code, pre .hljs {
            padding: 1.25rem 1.5rem !important;
            font-size: 0.875rem !important;
            line-height: 1.7 !important;
            font-family: 'JetBrains Mono', monospace !important;
            display: block;
            background: transparent !important;
        }

        /* Copy-to-clipboard button (injected into every code block) */
        .code-copy-btn {
            position: absolute;
            top: 6px;
            right: 8px;
            z-index: 2;
            display: inline-flex;
            align-items: center;
            gap: 0.3rem;
            padding: 0.25rem 0.55rem;
            font-family: 'Inter', sans-serif;
            font-size: 0.7rem;
            font-weight: 500;
            color: #9ca3af;
            background: rgba(255, 255, 255, 0.06);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 0.375rem;
            cursor: pointer;
            opacity: 0;
            transition: opacity 0.15s ease, color 0.15s ease, background 0.15s ease;
        }

        pre:hover .code-copy-btn { opacity: 1; }
        .code-copy-btn:hover { color: #fff; background: rgba(255, 255, 255, 0.12); }
        .code-copy-btn.copied { color: #34d399; border-color: rgba(52, 211, 153, 0.4); }
        .code-copy-btn svg { width: 0.85rem; height: 0.85rem; }

        /* Inline code styling */
        :not(pre) > code:not([class*="bg-"]) {
            background: rgba(245, 158, 11, 0.08);
            color: #fcd34d;
            padding: 0.2rem 0.4rem;
            border-radius: 0.375rem;
            font-size: 0.85em;
            font-weight: 500;
            border: 1px solid rgba(245, 158, 11, 0.2);
        }

        /* Mermaid diagrams (```mermaid fences in markdown blog posts / docs) */
        .mermaid-wrap {
            position: relative;
            margin: 1.5rem auto;
            max-width: 100%;
            border-radius: 0.75rem;
            border: 1px solid #30363d;
            background: #0b0d0f;
            overflow: hidden;
        }
        .mermaid-toolbar {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            gap: 0.35rem;
            padding: 0.45rem 0.55rem;
            background: rgba(255, 255, 255, 0.03);
            border-bottom: 1px solid rgba(255, 255, 255, 0.06);
        }
        .mermaid-toolbar-hint {
            margin-right: auto;
            font-size: 0.7rem;
            color: #6b7280;
            user-select: none;
        }
        .mermaid-zoom-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 1.85rem;
            height: 1.85rem;
            padding: 0 0.4rem;
            font-family: 'Inter', sans-serif;
            font-size: 0.75rem;
            font-weight: 600;
            color: #9ca3af;
            background: rgba(255, 255, 255, 0.06);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 0.375rem;
            cursor: pointer;
            transition: color 0.15s ease, background 0.15s ease, border-color 0.15s ease;
        }
        .mermaid-zoom-btn:hover {
            color: #fff;
            background: rgba(245, 158, 11, 0.15);
            border-color: rgba(245, 158, 11, 0.35);
        }
        .mermaid-zoom-label {
            min-width: 2.75rem;
            text-align: center;
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.7rem;
            color: #9ca3af;
            user-select: none;
        }
        .mermaid-viewport {
            overflow: auto;
            padding: 1.25rem 1rem;
            max-height: min(70vh, 520px);
            cursor: grab;
            touch-action: pan-x pan-y;
        }
        .mermaid-viewport.is-dragging { cursor: grabbing; }
        .mermaid-viewport-inner {
            display: inline-block;
            min-width: 100%;
            text-align: center;
            transform-origin: top center;
            transition: transform 0.12s ease-out;
        }
        .mermaid-diagram {
            margin: 0 !important;
            padding: 0 !important;
            border: none !important;
            background: transparent !important;
            text-align: center;
        }
        .mermaid-diagram svg {
            max-width: none;
            height: auto;
            display: inline-block;
        }
        /* Fullscreen lightbox */
        .mermaid-lightbox {
            position: fixed;
            inset: 0;
            z-index: 200;
            display: flex;
            flex-direction: column;
            background: rgba(8, 9, 11, 0.92);
            backdrop-filter: blur(6px);
        }
        .mermaid-lightbox[hidden] { display: none !important; }
        .mermaid-lightbox-toolbar {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            gap: 0.5rem;
            padding: 0.75rem 1rem;
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
            flex-shrink: 0;
        }
        .mermaid-lightbox-stage {
            flex: 1;
            overflow: auto;
            padding: 1.5rem;
            cursor: grab;
            touch-action: pan-x pan-y;
        }
        .mermaid-lightbox-stage.is-dragging { cursor: grabbing; }
        .mermaid-lightbox-inner {
            display: inline-block;
            min-width: 100%;
            text-align: center;
            transform-origin: top center;
            transition: transform 0.12s ease-out;
        }
        .mermaid-lightbox-close {
            margin-right: auto;
            font-size: 0.8rem;
            font-weight: 500;
            color: #9ca3af;
            background: transparent;
            border: none;
            cursor: pointer;
            padding: 0.35rem 0.5rem;
        }
        .mermaid-lightbox-close:hover { color: #fff; }


        /* Prose customization - full width */
        .prose-docs {
            max-width: none !important;
        }

        .prose-docs :where(code):not(:where([class~="not-prose"] *))::before { content: "" !important; }
        .prose-docs :where(code):not(:where([class~="not-prose"] *))::after { content: "" !important; }

        .prose-docs h1 {
            color: white;
            font-family: 'Fraunces', Georgia, serif;
            font-weight: 800;
            font-size: 2.5rem;
            letter-spacing: -0.025em;
            margin-bottom: 1.5rem;
        }

        .prose-docs h2 {
            color: white;
            font-family: 'Fraunces', Georgia, serif;
            font-weight: 700;
            font-size: 1.75rem;
            margin-top: 3.5rem;
            padding-bottom: 0.75rem;
            border-bottom: 1px solid rgba(255,255,255,0.08);
            letter-spacing: -0.015em;
            scroll-margin-top: 5rem;
        }

        .prose-docs h3 {
            color: #e5e7eb;
            font-weight: 600;
            font-size: 1.25rem;
            margin-top: 2.5rem;
            scroll-margin-top: 5rem;
        }

        /* Right-rail "On this page" TOC */
        .toc a {
            display: block;
            padding: 0.3rem 0;
            color: rgba(148, 163, 184, 0.85);
            font-size: 0.83rem;
            line-height: 1.4;
            transition: color .15s ease;
            text-decoration: none;
            border-bottom: 0;
        }
        .toc a:hover { color: #fff; }
        .toc a.is-current { color: #fcd34d; }
        .toc a.is-current::before {
            content: "● ";
            color: #f59e0b;
            font-size: 0.6em;
            vertical-align: middle;
            margin-right: 0.25rem;
        }

        .prose-docs img {
            border-radius: 0.75rem;
            border: 1px solid rgba(255,255,255,0.1);
            margin: 1.5rem 0;
        }

        .prose-docs p { color: #9ca3af; line-height: 1.8; margin-bottom: 1.5rem; }
        .prose-docs ul, .prose-docs ol { color: #9ca3af; margin-bottom: 1.5rem; }
        .prose-docs li { margin-top: 0.5rem; margin-bottom: 0.5rem; }

        .prose-docs a {
            color: #fbbf24;
            text-decoration: none;
            border-bottom: 1px solid transparent;
            transition: all 0.2s;
        }
        .prose-docs a:hover {
            color: #fcd34d;
            border-bottom-color: #fcd34d;
        }

        .prose-docs strong { color: white; font-weight: 600; }

        .prose-docs blockquote {
            border-left: 3px solid #f59e0b;
            background: linear-gradient(to right, rgba(245, 158, 11, 0.08), transparent);
            padding: 1rem 1.5rem;
            border-radius: 0.5rem;
            margin: 2rem 0;
            font-style: normal;
        }
        .prose-docs blockquote p { color: #fde68a; margin: 0; }

        /* Sidebar animation */
        .sidebar-link {
            position: relative;
            transition: all 0.2s ease;
        }

        .sidebar-link:hover {
            background: rgba(255, 255, 255, 0.05);
            color: white;
        }

        .sidebar-link.active {
            background: rgba(245, 158, 11, 0.1);
            color: #fbbf24;
            font-weight: 500;
        }

        .sidebar-link.active::before {
            content: '';
            position: absolute;
            left: 0;
            top: 0;
            bottom: 0;
            width: 3px;
            background: #f59e0b;
            border-radius: 3px 0 0 3px;
            box-shadow: 2px 0 10px rgba(245, 158, 11, 0.5);
        }

        /* Sticky Haders */
        header.sticky-glass {
            background: rgba(12, 10, 9, 0.7);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        }

        /* Mobile menu */
        .mobile-menu {
            transform: translateX(-100%);
            transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .mobile-menu.open {
            transform: translateX(0);
        }
    </style>

    <% if docs_og %>
    <!-- OpenGraph card of a docs page (docs_controller: docs_og) -->
    <link rel="canonical" href="<%= docs_og["url"] %>">
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="Soli">
    <meta property="og:title" content="<%= title %> — Soli docs">
    <meta property="og:description" content="<%= docs_og["description"] %>">
    <meta property="og:url" content="<%= docs_og["url"] %>">
    <meta property="og:image" content="https://soli.solisoft.net<%= public_path(docs_og["image_path"]) %>">
    <meta property="og:image:type" content="image/png">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content="<%= title %> — Soli docs">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= title %> — Soli docs">
    <meta name="twitter:description" content="<%= docs_og["description"] %>">
    <meta name="twitter:image" content="https://soli.solisoft.net<%= public_path(docs_og["image_path"]) %>">
    <% end %>

    <!-- Per-page <head> injection (og:image and friends from blog posts, etc.) -->
    <%= yield "head" %>
    <style>
        /* 2026 redesign: warm ink surface, solar orange accent, Fraunces headings.
           The reading surface stays dark because page content is written for it. */
        body.antialiased { background-color: #1C1814; }
        body.antialiased ::selection { background: rgba(232, 89, 12, 0.35); color: #fff; }
        :focus-visible { outline: 2px solid #E8590C; outline-offset: 2px; }

        aside.lg\:flex, #mobileSidebar { background-color: #16130F; border-color: #2E2822; }
        header.sticky-glass { background: rgba(28, 24, 20, 0.88); border-bottom: 1px solid #2E2822; }

        /* Sidebar */
        #desktopNav h5, #mobileSidebar h5 {
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.68rem;
            font-weight: 500;
            letter-spacing: 0.12em;
            color: #A69C8C;
        }
        .sidebar-link { color: #B9AFA0; border-radius: 0.6rem; }
        .sidebar-link:hover { background: rgba(255, 253, 248, 0.05); color: #F6F1E7; }
        .sidebar-link.active { background: rgba(232, 89, 12, 0.14); color: #F2A365; font-weight: 500; }
        .sidebar-link.active::before { background: #E8590C; }

        /* Article */
        .prose-docs h1 { font-weight: 600; font-size: 3rem; line-height: 1.02; letter-spacing: -0.035em; color: #F6F1E7; }
        .prose-docs h2 { font-weight: 600; font-size: 2rem; letter-spacing: -0.03em; color: #F6F1E7; border-bottom-color: #2E2822; }
        .prose-docs h3 { font-family: 'Fraunces', Georgia, serif; font-weight: 600; letter-spacing: -0.02em; color: #E9E2D6; }
        .prose-docs p, .prose-docs ul, .prose-docs ol { color: #B9AFA0; }
        .prose-docs strong { color: #F6F1E7; }
        .prose-docs a { color: #F2A365; }
        .prose-docs a:hover { color: #FFC08A; border-bottom-color: #FFC08A; }
        .prose-docs blockquote { border-left-color: #E8590C; background: linear-gradient(to right, rgba(232, 89, 12, 0.1), transparent); }
        .prose-docs blockquote p { color: #F5D3B8; }
        :not(pre) > code:not([class*="bg-"]) { background: rgba(232, 89, 12, 0.1); color: #F2A365; border-color: rgba(232, 89, 12, 0.25); }
        pre { background: #14110E !important; border-color: #2E2822 !important; }

        /* On this page */
        .toc { border-color: #2E2822 !important; }
        .toc a.is-current { color: #F2A365; }
        .toc a.is-current::before { color: #E8590C; }
        #page-toc + *, aside p.font-mono { color: #A69C8C; }

        /* Breadcrumb */
        header.sticky-glass nav { font-family: 'JetBrains Mono', monospace; font-size: 0.8rem; }
    </style>
    <link rel="stylesheet" href="<%= public_path("css/theme.css") %>">
    <link rel="stylesheet" href="<%= public_path("css/site.css") %>">
</head>

<body class="bg-[#0C0A09] text-gray-300 antialiased h-full selection:bg-amber-500/40 selection:text-white">
    <%- render_partial("layouts/search_modal") %>

    <!-- The site's top bar; on small screens its menu button opens the docs sidebar. -->
    <%- render_partial("layouts/site_nav", { "docs": true }) %>

    <!-- Mobile Menu Overlay -->
    <div id="mobileMenuOverlay" class="lg:hidden fixed inset-0 bg-black/50 backdrop-blur-sm z-40 hidden" onclick="toggleMobileMenu()"></div>

    <!-- Mobile Sidebar -->
    <aside id="mobileSidebar" class="mobile-menu docs-mobile-sidebar lg:hidden fixed left-0 bottom-0 w-72 z-40 bg-[#0C0A09] border-r border-white/5 overflow-y-auto">
        <div class="p-6">
            <nav class="docs-site-links" aria-label="Site">
                <a href="/">Home</a>
                <a href="/docs/getting-started/installation">Get started</a>
                <a href="/ai">AI</a>
                <a href="/demos">Demos</a>
                <a href="/docs/getting-started/changelog">Changelog</a>
                <a href="/docs/blog">Blog</a>
                <a href="https://github.com/solisoft/soli_lang" target="_blank" rel="noopener">GitHub</a>
            </nav>
            <nav class="space-y-6">
                <%- render_partial("layouts/docs_nav") %>
            </nav>
        </div>
    </aside>

    <div class="docs-shell flex">
        <!-- Desktop Sidebar -->
        <aside class="docs-pane hidden lg:flex lg:flex-col w-72 border-r border-white/5 bg-[#0C0A09]/50">
            <!-- Search Button -->
            <div class="px-4 py-3 border-b border-white/5">
                <button onclick="openSearchModal()" class="w-full flex items-center gap-3 px-3 py-2 text-sm text-gray-400 bg-white/5 hover:bg-white/10 rounded-lg transition-colors">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                    </svg>
                    <span>Search the docs</span>
                    <kbd class="ml-auto px-1.5 py-0.5 text-xs bg-white/10 rounded">Ctrl+K</kbd>
                </button>
            </div>

            <!-- Navigation -->
            <nav id="desktopNav" class="flex-1 overflow-y-auto py-6 px-4">
                <div class="space-y-6">
                    <%- render_partial("layouts/docs_nav") %>
                </div>
            </nav>

        </aside>

        <!-- Main Content -->
        <main class="docs-pane flex-1 min-w-0 lg:overflow-y-auto">

            <!-- Content Area -->
            <div class="px-4 py-8 lg:px-8 lg:py-10">
                <nav class="docs-crumb flex items-center gap-2 text-sm mb-8" aria-label="Breadcrumb">
                    <a href="/" class="text-gray-400 hover:text-white transition-colors">Home</a>
                    <svg class="w-4 h-4 text-gray-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                    </svg>
                    <% if defined("breadcrumb_href") and breadcrumb_href != "" %>
                    <a href="<%= breadcrumb_href %>" class="text-gray-400 hover:text-white transition-colors">Docs</a>
                    <% else %>
                    <span class="text-gray-400">Docs</span>
                    <% end %>
                    <svg class="w-4 h-4 text-gray-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                    </svg>
                    <span class="text-white font-medium"><%= title %></span>
                </nav>
                <div class="<% if defined("hide_toc") and hide_toc %>min-w-0<% else %>xl:grid xl:grid-cols-[minmax(0,1fr)_220px] xl:gap-12<% end %>">
                    <div class="min-w-0">
                        <article id="doc-article" class="prose prose-invert max-w-none animate-fade-in prose-docs">
                            <!-- Two nested wrappers absorb up to 2 stray </div> tags from
                                 malformed page content so the layout's column structure
                                 stays intact even when an individual page has mismatched
                                 tags. -->
                            <div><div>
                                <%= yield %>
                            </div></div>

                            <%# Previous / next, from the same ordered list the
                                sidebar renders from. Rendered here so every page
                                has them and no page carries its own. %>
                            <% if defined("nav_path") %>
                            <%- render_partial("layouts/docs_page_nav", { "nav_path": nav_path }) %>
                            <% end %>
                        </article>

                        <!-- Footer -->
                        <footer class="mt-16 pt-8 border-t border-white/5">
                            <div class="flex flex-col sm:flex-row justify-between items-center gap-4 text-sm">
                                <p class="text-gray-500">&copy; 2026 SoliLang. MIT License.</p>
                                <a href="https://github.com/solisoft/soli_lang" target="_blank" class="flex items-center gap-2 text-gray-400 hover:text-white transition-colors">
                                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                                    </svg>
                                    Edit this page on GitHub
                                </a>
                            </div>
                        </footer>
                    </div>

                    <!-- Right rail: on-this-page TOC (omitted when hide_toc is set) -->
                    <% if defined("hide_toc") and hide_toc %>
                    <% else %>
                    <aside class="hidden xl:block">
                        <div class="sticky top-20">
                            <p class="text-[10px] font-mono tracking-[0.22em] uppercase text-gray-500 mb-3">On this page</p>
                            <nav id="page-toc" class="toc border-l border-white/10 pl-4"></nav>
                        </div>
                    </aside>
                    <% end %>
                </div>
            </div>
        </main>
    </div>

    <!-- Scripts -->
    <script>
    function toggleMobileMenu() {
        const sidebar = document.getElementById('mobileSidebar');
        const overlay = document.getElementById('mobileMenuOverlay');
        const isOpening = !sidebar.classList.contains('open');

        sidebar.classList.toggle('open');
        overlay.classList.toggle('hidden');
        document.body.classList.toggle('overflow-hidden');

        // Scroll to active item when opening mobile menu
        if (isOpening) {
            const activeLink = sidebar.querySelector('.sidebar-link.active');
            if (activeLink) {
                setTimeout(() => {
                    const sidebarRect = sidebar.getBoundingClientRect();
                    const linkRect = activeLink.getBoundingClientRect();
                    const offset = linkRect.top - sidebarRect.top - (sidebarRect.height / 2) + (linkRect.height / 2);
                    sidebar.scrollTop = offset;
                }, 100);
            }
        }
    }

    // SoliLang language definition for highlight.js. Registered lazily inside
    // a function (NOT at top level) so a missing `hljs` can never throw and
    // abort the rest of this script. Instant-nav (/__soli/nav.js) swaps the
    // <body> but merges only the new <head>'s stylesheets/meta — NOT its
    // <script> tags. So arriving at a docs page from a layout that doesn't load
    // highlight.js (the home/blog pages use layouts/application, which has no
    // hljs) leaves `hljs` undefined until initHighlighting() loads it on
    // demand. A top-level `hljs.registerLanguage(...)` here used to throw in
    // exactly that case, aborting before initDocPage() ran — which is what
    // broke BOTH code highlighting and active-menu selection after navigating.
    var __soliLangRegistered = false;
    function registerSoliLanguage() {
        if (__soliLangRegistered || typeof hljs === 'undefined') return;
        __soliLangRegistered = true;
        hljs.registerLanguage('soli', function(hljs) {
        // Identifiers may end in `?` or `!` (predicate / bang methods).
        var IDENT = '[A-Za-z_][A-Za-z0-9_]*[?!]?';
        var KEYWORDS = {
            keyword: 'def fn if unless then else elsif elif end return let for in while do break continue class extends interface module enum static this self super new import use as try catch rescue ensure finally throw raise yield defer match case when and or not export',
            literal: 'null nil true false',
            built_in: 'print println puts debug len str int float bool range push pop keys values render redirect grouped params session_get session_set session_delete session_destroy session_regenerate authorize policy_for current_user signed_in current_action forbidden halt h Model Controller Crypto HTTP JSON Cache Cron FeatureFlags const'
        };
        var SUBST = { className: 'subst', begin: '\\\\\\(', end: '\\)', keywords: KEYWORDS };
        var STRING = {
            className: 'string',
            variants: [
                { begin: '"""', end: '"""+' },
                { begin: 'r?"', end: '"', contains: [hljs.BACKSLASH_ESCAPE, SUBST] }
            ]
        };
        return {
            name: 'SoliLang',
            aliases: ['soli'],
            keywords: KEYWORDS,
            contains: [
                hljs.COMMENT('#', '$'),
                hljs.COMMENT('//', '$'),
                hljs.COMMENT('/\\*', '\\*/'),
                STRING,
                { className: 'number', begin: '-?\\b\\d+(\\.\\d+)?([eE][+-]?\\d+)?\\b', relevance: 0 },
                { className: 'symbol', begin: ':' + IDENT, relevance: 0 },
                { className: 'variable', begin: '@' + IDENT, relevance: 0 },
                {
                    // `class Foo < Bar` / `interface`, etc. — colour the class
                    // name and its superclass; end at the line/brace/`end`.
                    beginKeywords: 'class interface module enum',
                    end: '($|\\{|\\bend\\b|\\n)',
                    returnEnd: true,
                    contains: [
                        { className: 'title.class', begin: IDENT, relevance: 0 },
                        { begin: '(<|extends)', contains: [{ className: 'title.class.inherited', begin: IDENT }] }
                    ]
                },
                { className: 'title.function', begin: '(?:def|fn)\\s+' + IDENT, relevance: 10 },
                { className: 'title.function', begin: IDENT + '(?=\\s*\\()', relevance: 0 },
                { className: 'type', begin: ':\\s*(Any|String|Int|Float|Bool|Decimal|Array|Hash|Object|Void|Request|Response)\\b', relevance: 2 }
            ]
        };
        });

        // `.html.slv` template snippets (`language-erb`): HTML base with the
        // tag regions highlighted as Soli. Mirrors highlight.js's own erb
        // grammar with the Ruby sublanguage swapped for `soli` (registered
        // just above); the end pattern also closes the newline-trimming
        // dash-form closer. The delimiters are built by concatenation so
        // this layout's own template tokenizer never sees a literal tag
        // opener inside the inline script.
        var ERB_OPEN = '<' + '%';
        var ERB_CLOSE = '%' + '>';
        hljs.registerLanguage('erb', function(hljs) {
            return {
                name: 'ERB',
                aliases: ['slv'],
                subLanguage: 'xml',
                contains: [
                    hljs.COMMENT(ERB_OPEN + '#', ERB_CLOSE),
                    {
                        begin: ERB_OPEN + '[%=-]?',
                        end: '[%-]?' + ERB_CLOSE,
                        subLanguage: 'soli',
                        excludeBegin: true,
                        excludeEnd: true
                    }
                ]
            };
        });
    }

    var MERMAID_SRC = 'https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.min.js';
    var MERMAID_ZOOM_STEPS = [0.5, 0.75, 1, 1.25, 1.5, 2, 2.5, 3];

    function mermaidZoomLabel(scale) {
        return Math.round(scale * 100) + '%';
    }

    function nearestMermaidZoomIndex(scale) {
        var best = 0;
        var bestDiff = Infinity;
        for (var i = 0; i < MERMAID_ZOOM_STEPS.length; i++) {
            var diff = Math.abs(MERMAID_ZOOM_STEPS[i] - scale);
            if (diff < bestDiff) { bestDiff = diff; best = i; }
        }
        return best;
    }

    function ensureMermaidLightbox() {
        var box = document.getElementById('mermaid-lightbox');
        if (box) return box;

        box = document.createElement('div');
        box.id = 'mermaid-lightbox';
        box.className = 'mermaid-lightbox';
        box.hidden = true;
        box.innerHTML =
            '<div class="mermaid-lightbox-toolbar">' +
                '<button type="button" class="mermaid-lightbox-close" data-mermaid-lb="close">Close (Esc)</button>' +
                '<span class="mermaid-toolbar-hint">Drag to pan · Ctrl+scroll to zoom</span>' +
                '<button type="button" class="mermaid-zoom-btn" data-mermaid-lb="out" aria-label="Zoom out">−</button>' +
                '<span class="mermaid-zoom-label" data-mermaid-lb="label">100%</span>' +
                '<button type="button" class="mermaid-zoom-btn" data-mermaid-lb="in" aria-label="Zoom in">+</button>' +
                '<button type="button" class="mermaid-zoom-btn" data-mermaid-lb="reset" aria-label="Reset zoom">Reset</button>' +
            '</div>' +
            '<div class="mermaid-lightbox-stage" data-mermaid-lb="stage">' +
                '<div class="mermaid-lightbox-inner" data-mermaid-lb="inner"></div>' +
            '</div>';

        document.body.appendChild(box);

        var lbState = { scale: 1, source: null };

        function setLbScale(scale) {
            lbState.scale = scale;
            var inner = box.querySelector('[data-mermaid-lb="inner"]');
            var label = box.querySelector('[data-mermaid-lb="label"]');
            if (inner) inner.style.transform = 'scale(' + scale + ')';
            if (label) label.textContent = mermaidZoomLabel(scale);
        }

        function lbZoom(delta) {
            var idx = nearestMermaidZoomIndex(lbState.scale);
            idx = Math.max(0, Math.min(MERMAID_ZOOM_STEPS.length - 1, idx + delta));
            setLbScale(MERMAID_ZOOM_STEPS[idx]);
        }

        box.querySelector('[data-mermaid-lb="out"]').addEventListener('click', function() { lbZoom(-1); });
        box.querySelector('[data-mermaid-lb="in"]').addEventListener('click', function() { lbZoom(1); });
        box.querySelector('[data-mermaid-lb="reset"]').addEventListener('click', function() { setLbScale(1); });
        box.querySelector('[data-mermaid-lb="close"]').addEventListener('click', function() { closeMermaidLightbox(); });

        box.addEventListener('click', function(e) {
            if (e.target === box) closeMermaidLightbox();
        });

        var stage = box.querySelector('[data-mermaid-lb="stage"]');
        attachMermaidPan(stage);
        attachMermaidWheelZoom(stage, function(delta) { lbZoom(delta); });

        document.addEventListener('keydown', function(e) {
            if (!box.hidden && e.key === 'Escape') closeMermaidLightbox();
        });

        box._mermaidLb = {
            open: function(svg) {
                var inner = box.querySelector('[data-mermaid-lb="inner"]');
                inner.innerHTML = '';
                inner.appendChild(svg.cloneNode(true));
                lbState.scale = 1.25;
                setLbScale(1.25);
                box.hidden = false;
                document.body.classList.add('overflow-hidden');
                stage.scrollTop = 0;
                stage.scrollLeft = 0;
            },
            close: function() {
                box.hidden = true;
                document.body.classList.remove('overflow-hidden');
            }
        };

        return box;
    }

    function closeMermaidLightbox() {
        var box = document.getElementById('mermaid-lightbox');
        if (box && box._mermaidLb) box._mermaidLb.close();
    }

    function attachMermaidPan(viewport) {
        var dragging = false;
        var startX = 0;
        var startY = 0;
        var scrollLeft = 0;
        var scrollTop = 0;

        viewport.addEventListener('mousedown', function(e) {
            if (e.button !== 0) return;
            dragging = true;
            viewport.classList.add('is-dragging');
            startX = e.pageX;
            startY = e.pageY;
            scrollLeft = viewport.scrollLeft;
            scrollTop = viewport.scrollTop;
        });

        window.addEventListener('mousemove', function(e) {
            if (!dragging) return;
            viewport.scrollLeft = scrollLeft - (e.pageX - startX);
            viewport.scrollTop = scrollTop - (e.pageY - startY);
        });

        window.addEventListener('mouseup', function() {
            dragging = false;
            viewport.classList.remove('is-dragging');
        });
    }

    function attachMermaidWheelZoom(viewport, onStep) {
        viewport.addEventListener('wheel', function(e) {
            if (!e.ctrlKey && !e.metaKey) return;
            e.preventDefault();
            onStep(e.deltaY > 0 ? -1 : 1);
        }, { passive: false });
    }

    function wrapMermaidDiagram(diagram) {
        if (diagram.closest('.mermaid-wrap')) return;

        var wrap = document.createElement('div');
        wrap.className = 'mermaid-wrap';

        var toolbar = document.createElement('div');
        toolbar.className = 'mermaid-toolbar';
        toolbar.innerHTML =
            '<span class="mermaid-toolbar-hint">Drag to pan · Ctrl+scroll to zoom</span>' +
            '<button type="button" class="mermaid-zoom-btn" data-mermaid="out" aria-label="Zoom out">−</button>' +
            '<span class="mermaid-zoom-label" data-mermaid="label">100%</span>' +
            '<button type="button" class="mermaid-zoom-btn" data-mermaid="in" aria-label="Zoom in">+</button>' +
            '<button type="button" class="mermaid-zoom-btn" data-mermaid="reset" aria-label="Reset zoom">Reset</button>' +
            '<button type="button" class="mermaid-zoom-btn" data-mermaid="expand" aria-label="Expand diagram" title="Expand">' +
                '<svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">' +
                    '<path stroke-linecap="round" stroke-linejoin="round" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5v-4m0 4h-4m4 0l-5-5"/>' +
                '</svg>' +
            '</button>';

        var viewport = document.createElement('div');
        viewport.className = 'mermaid-viewport';

        var inner = document.createElement('div');
        inner.className = 'mermaid-viewport-inner';

        diagram.parentNode.insertBefore(wrap, diagram);
        inner.appendChild(diagram);
        viewport.appendChild(inner);
        wrap.appendChild(toolbar);
        wrap.appendChild(viewport);

        var state = { scale: 1 };

        function setScale(scale) {
            state.scale = scale;
            inner.style.transform = 'scale(' + scale + ')';
            toolbar.querySelector('[data-mermaid="label"]').textContent = mermaidZoomLabel(scale);
        }

        function stepZoom(delta) {
            var idx = nearestMermaidZoomIndex(state.scale);
            idx = Math.max(0, Math.min(MERMAID_ZOOM_STEPS.length - 1, idx + delta));
            setScale(MERMAID_ZOOM_STEPS[idx]);
        }

        toolbar.querySelector('[data-mermaid="out"]').addEventListener('click', function() { stepZoom(-1); });
        toolbar.querySelector('[data-mermaid="in"]').addEventListener('click', function() { stepZoom(1); });
        toolbar.querySelector('[data-mermaid="reset"]').addEventListener('click', function() { setScale(1); });
        toolbar.querySelector('[data-mermaid="expand"]').addEventListener('click', function() {
            var svg = diagram.querySelector('svg');
            if (!svg) return;
            ensureMermaidLightbox()._mermaidLb.open(svg);
        });

        viewport.addEventListener('dblclick', function() {
            var svg = diagram.querySelector('svg');
            if (!svg) return;
            ensureMermaidLightbox()._mermaidLb.open(svg);
        });

        attachMermaidPan(viewport);
        attachMermaidWheelZoom(viewport, stepZoom);
    }

    // Turn ```mermaid fenced blocks into rendered SVG diagrams. Must run before
    // highlight.js so the raw source isn't syntax-highlighted as code.
    function initMermaid() {
        var article = document.getElementById('doc-article');
        if (!article) return;

        var codes = article.querySelectorAll('pre > code.language-mermaid');
        if (codes.length === 0) return;

        var nodes = [];
        codes.forEach(function(code) {
            var pre = code.parentElement;
            if (!pre) return;
            var div = document.createElement('div');
            div.className = 'mermaid mermaid-diagram';
            div.textContent = code.textContent;
            pre.replaceWith(div);
            nodes.push(div);
        });

        function runMermaid() {
            if (typeof mermaid === 'undefined') return;
            mermaid.initialize({
                startOnLoad: false,
                theme: 'dark',
                securityLevel: 'loose',
                fontFamily: 'Inter, system-ui, sans-serif',
                themeVariables: {
                    primaryColor: '#101319',
                    primaryTextColor: '#e5e7eb',
                    primaryBorderColor: '#f59e0b',
                    lineColor: '#f59e0b',
                    secondaryColor: '#161a22',
                    tertiaryColor: '#0b0d0f'
                }
            });
            mermaid.run({ nodes: nodes }).then(function() {
                nodes.forEach(wrapMermaidDiagram);
            }).catch(function(err) {
                console.error('Mermaid render failed:', err);
            });
        }

        if (typeof mermaid !== 'undefined') {
            runMermaid();
            return;
        }

        var loader = document.getElementById('__mermaid-loader');
        if (!loader) {
            loader = document.createElement('script');
            loader.id = '__mermaid-loader';
            loader.src = MERMAID_SRC;
            document.head.appendChild(loader);
        }
        loader.addEventListener('load', runMermaid, { once: true });
    }

    function initDocPage() {
        // `soli:load` keeps this bound on `document` across swaps, so it also
        // fires when navigating to a non-docs page (a different layout). Bail
        // unless the docs article is present, so we don't add copy buttons /
        // highlighting to pages that didn't ask.
        if (!document.getElementById('doc-article')) return;
        initMermaid();
        initHighlighting();
        addCopyButtons();
        scrollToActiveMenuItem();
        buildOnThisPage();
    }

    // Inject a copy-to-clipboard button into every code block. Idempotent so
    // it can run again after livereload re-injects the article body.
    function addCopyButtons() {
        const copyIcon = '<svg fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 17.25v3.375c0 .621-.504 1.125-1.125 1.125h-9.75a1.125 1.125 0 01-1.125-1.125V7.875c0-.621.504-1.125 1.125-1.125H6.75a9.06 9.06 0 011.5.124m7.5 10.376h3.375c.621 0 1.125-.504 1.125-1.125V11.25c0-4.46-3.243-8.161-7.5-8.876a9.06 9.06 0 00-1.5-.124H9.375c-.621 0-1.125.504-1.125 1.125v3.5m7.5 10.375H9.375a1.125 1.125 0 01-1.125-1.125v-9.25m11.25 5.5H16.5a1.125 1.125 0 01-1.125-1.125v-3.5m3.375 4.625h-3.375"/></svg>';

        document.querySelectorAll('pre').forEach(function(pre) {
            if (pre.querySelector('.code-copy-btn')) return;
            const code = pre.querySelector('code');
            if (!code) return;

            const btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'code-copy-btn';
            btn.setAttribute('aria-label', 'Copy code to clipboard');
            btn.innerHTML = copyIcon + '<span>Copy</span>';

            btn.addEventListener('click', function() {
                const text = code.textContent || '';
                navigator.clipboard.writeText(text).then(function() {
                    btn.classList.add('copied');
                    btn.querySelector('span').textContent = 'Copied!';
                    setTimeout(function() {
                        btn.classList.remove('copied');
                        btn.querySelector('span').textContent = 'Copy';
                    }, 1800);
                });
            });

            pre.appendChild(btn);
        });
    }

    // Holds the current observer so we can disconnect it before rebuilding
    // (livereload re-injects the article body, leaving the old observer
    // pointing at detached nodes). MUST be `var`, not `let`/`const`: instant
    // navigation re-executes this whole inline script on every <body> swap, and
    // a top-level `let` redeclaration throws `Identifier '__tocObserver' has
    // already been declared`, aborting the entire re-run (which is what broke
    // code highlighting and active-menu selection after navigating).
    var __tocObserver = null;

    function buildOnThisPage() {
        const article = document.getElementById('doc-article');
        const toc = document.getElementById('page-toc');
        if (!article || !toc) return;

        const slug = function(s) {
            return s.toLowerCase()
                .replace(/[^a-z0-9]+/g, '-')
                .replace(/^-|-$/g, '')
                .slice(0, 60);
        };

        const headings = Array.from(article.querySelectorAll('h2'));
        toc.innerHTML = '';

        if (__tocObserver) { __tocObserver.disconnect(); __tocObserver = null; }

        if (headings.length === 0) {
            toc.innerHTML = '<p class="text-[12.5px] text-gray-500 italic">No subsections.</p>';
            return;
        }

        const seen = new Set();
        const links = new Map();
        headings.forEach(function(h) {
            const text = (h.textContent || '').replace(/\s+/g, ' ').trim();
            if (!text) return;

            let id = h.id;
            if (!id) {
                id = slug(text);
                let n = 1;
                while (seen.has(id)) { id = slug(text) + '-' + (++n); }
                h.id = id;
            }
            seen.add(id);

            const a = document.createElement('a');
            a.href = '#' + id;
            a.textContent = text;
            toc.appendChild(a);
            links.set(id, a);
        });

        // Scope the observer to the scrolling <main>, not the viewport — the
        // article lives inside `lg:h-screen lg:overflow-y-auto`.
        const scrollRoot = document.querySelector('main.lg\\:overflow-y-auto') || null;
        __tocObserver = new IntersectionObserver(function(entries) {
            entries.forEach(function(e) {
                if (e.isIntersecting) {
                    const id = e.target.id;
                    links.forEach(function(a) { a.classList.remove('is-current'); });
                    const cur = links.get(id);
                    if (cur) cur.classList.add('is-current');
                }
            });
        }, { root: scrollRoot, rootMargin: '-20% 0px -70% 0px', threshold: 0 });

        headings.forEach(function(h) { __tocObserver.observe(h); });
    }

    // A collapsible sidebar item (see layouts/_docs_nav) hides its sub-pages
    // until you are on one of them, or open it with its chevron. Each sidebar
    // (desktop, mobile) has its own copy, so a toggle acts on its own list.
    function setNavGroupOpen(toggle, open) {
        const list = toggle.closest('ul');
        const group = toggle.getAttribute('data-nav-group');
        list.querySelectorAll('.nav-group-child').forEach(function (li) {
            if (li.getAttribute('data-nav-parent') === group) li.hidden = !open;
        });
        toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
        const chevron = toggle.querySelector('svg');
        if (chevron) chevron.style.transform = open ? 'rotate(90deg)' : '';
    }

    function syncNavGroups(currentPath) {
        document.querySelectorAll('.nav-group-toggle').forEach(function (toggle) {
            const group = toggle.getAttribute('data-nav-group');
            let here = currentPath === group;
            toggle.closest('ul').querySelectorAll('.nav-group-child').forEach(function (li) {
                const link = li.querySelector('a');
                if (li.getAttribute('data-nav-parent') === group && link
                    && link.getAttribute('href') === currentPath) here = true;
            });
            setNavGroupOpen(toggle, here || toggle.dataset.userOpen === '1');
        });
    }

    if (!window.__navGroupToggleBound) {
        window.__navGroupToggleBound = true;
        document.addEventListener('click', function (event) {
            const toggle = event.target.closest('.nav-group-toggle');
            if (!toggle) return;
            event.preventDefault();
            const open = toggle.getAttribute('aria-expanded') !== 'true';
            toggle.dataset.userOpen = open ? '1' : '0';
            setNavGroupOpen(toggle, open);
        });
    }

    function scrollToActiveMenuItem() {
        const currentPath = window.location.pathname;

        // Find and activate links matching current URL in both sidebars
        document.querySelectorAll('.sidebar-link').forEach(link => {
            link.classList.remove('active', 'bg-amber-500/10', 'text-amber-400', 'font-medium');
            link.classList.add('text-gray-400', 'hover:bg-white/5', 'hover:text-white');

            if (link.getAttribute('href') === currentPath) {
                link.classList.add('active', 'bg-amber-500/10', 'text-amber-400', 'font-medium');
                link.classList.remove('text-gray-400');
            }
        });

        syncNavGroups(currentPath);

        // Scroll desktop nav to active item
        const desktopNav = document.getElementById('desktopNav');
        if (desktopNav) {
            const activeLink = desktopNav.querySelector('.sidebar-link.active');
            if (activeLink) {
                setTimeout(() => {
                    const linkTop = activeLink.offsetTop;
                    const navHeight = desktopNav.clientHeight;
                    desktopNav.scrollTop = linkTop - (navHeight / 2);
                }, 100);
            }
        }
    }

    // highlight.js lives in this layout's <head>. When you reach a docs page
    // via an instant-nav <body> swap from a layout that doesn't load it (the
    // home/blog pages), nav.js doesn't carry over <head> <script> tags, so
    // `hljs` is undefined. Load it once, on demand, then highlight — instead of
    // throwing and taking the rest of initDocPage() (incl. the active-menu
    // selection) down with it.
    var HLJS_SRC = "https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/highlight.min.js";

    function initHighlighting() {
        if (typeof hljs === 'undefined') {
            var loader = document.getElementById('__hljs-loader');
            if (loader) {
                loader.addEventListener('load', runHighlight, { once: true });
                return;
            }
            loader = document.createElement('script');
            loader.id = '__hljs-loader';
            loader.src = HLJS_SRC;
            loader.addEventListener('load', runHighlight, { once: true });
            document.head.appendChild(loader);
            return;
        }
        runHighlight();
    }

    function runHighlight() {
        registerSoliLanguage();

        // Reset the marker only on blocks whose content is actually fresh (a
        // livereload morph re-injects plain text but can keep the attribute).
        // A block still carrying hljs spans IS highlighted — re-running hljs on
        // it nests the markup and fires its "unescaped HTML" security warning.
        document.querySelectorAll('code[data-highlighted]').forEach(function(block) {
            if (!block.querySelector('span[class*="hljs"]')) {
                block.removeAttribute('data-highlighted');
            }
        });

        hljs.highlightAll();
    }

    // --- Page initialization -------------------------------------------------
    // Run AFTER every function above is defined and `var __tocObserver` has been
    // initialized. Instant navigation re-executes this whole inline script on
    // each <body> swap (nav.js's page-init hook), so calling initDocPage() here
    // re-highlights code and re-selects the active menu item on every visit —
    // `DOMContentLoaded` only fires once per document and never again after a
    // swap, which was the original breakage.
    // Once-per-body guard: on a nav swap BOTH paths fire — this re-executed
    // inline script AND the persistent `soli:load` listener below — which
    // double-ran initDocPage (double highlight pass = hljs "unescaped HTML"
    // warnings on every navigation). The swap replaces <body>, so stamping the
    // body runs init exactly once per navigation while keeping `soli:load` as
    // a real fallback for any swap path that doesn't re-run scripts.
    function initDocPageOnce() {
        if (document.body.hasAttribute('data-docs-init')) return;
        document.body.setAttribute('data-docs-init', '');
        initDocPage();
    }

    initDocPageOnce();

    // Bind document-level listeners once; the re-run would otherwise stack a new
    // one per visit. `soli:load` is a belt-and-suspenders for any swap path that
    // doesn't re-run scripts; `livereload:update` covers dev hot reloads (the
    // morph keeps the same <body>, so clear the stamp to force a re-init).
    if (!window.__soliDocsListenersBound) {
        window.__soliDocsListenersBound = true;
        document.addEventListener('soli:load', initDocPageOnce);
        document.addEventListener('livereload:update', function () {
            document.body.removeAttribute('data-docs-init');
            initDocPageOnce();
        });
    }
    </script>
</body>
</html>
