<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - Soli</title>
    <meta name="description" content="Soli is a programming language with a complete MVC framework built in. Ruby's expressiveness, Rust's speed, one binary.">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600;9..144,700&family=Instrument+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

    <!-- Fuse.js for search -->
    <script src="https://cdn.jsdelivr.net/npm/fuse.js@7.0.0"></script>

    <script src="<%= public_path("js/theme.js") %>"></script>
    <link rel="stylesheet" href="<%= public_path("css/application.css") %>">
    <link rel="stylesheet" href="<%= public_path("css/theme.css") %>">

    <style>
        :root {
            --paper: #F6F1E7;
            --paper-raised: #FFFDF8;
            --paper-sunk: #EADFC9;
            --ink: #1B1712;
            --ink-soft: #4A4238;
            --ink-faint: #6B6153;
            --line: #D8CFBE;
            --line-soft: #E3DAC8;
            --sun: #E8590C;
            --sun-text: #B4400B;
            --night: #1C1814;
            --night-deep: #14110E;
            --night-line: #2E2822;
            --nav-bg: rgba(246, 241, 231, 0.88);
        }
        html[data-theme="dark"] {
            --paper: #1C1814;
            --paper-raised: #241F1A;
            --paper-sunk: #16130F;
            --ink: #F6F1E7;
            --ink-soft: #C9BFAE;
            --ink-faint: #A69C8C;
            --line: #3A332B;
            --line-soft: #2E2822;
            --sun-text: #F2A365;
            --night: #100D0A;
            --night-deep: #0A0806;
            --nav-bg: rgba(28, 24, 20, 0.88);
        }
        html { scroll-behavior: smooth; }
        body {
            margin: 0;
            background: var(--paper);
            color: var(--ink);
            font-family: 'Instrument Sans', system-ui, sans-serif;
            -webkit-font-smoothing: antialiased;
        }
        code, pre { font-family: 'JetBrains Mono', monospace; }
        a { color: inherit; text-decoration: none; }
        ::selection { background: rgba(232, 89, 12, 0.3); }
        :focus-visible { outline: 2px solid var(--sun); outline-offset: 3px; }

        .lp-serif { font-family: 'Fraunces', Georgia, serif; }
        .lp-wrap { max-width: 1280px; margin: 0 auto; padding: 0 clamp(20px, 5.5vw, 80px); }

        /* Navigation */
        .lp-nav {
            position: sticky; top: 0; z-index: 50;
            background: var(--nav-bg);
            backdrop-filter: blur(14px);
            -webkit-backdrop-filter: blur(14px);
            border-bottom: 1px solid var(--line-soft);
        }
        .lp-nav-inner { display: flex; align-items: center; gap: 40px; height: 80px; }
        .lp-logo { display: flex; align-items: center; gap: 12px; font-family: 'Fraunces', serif; font-weight: 700; font-size: 28px; letter-spacing: -0.02em; }
        .lp-links { display: flex; gap: 32px; flex-grow: 1; font-size: 16px; font-weight: 500; }
        .lp-links a:hover { color: var(--sun-text); }
        .lp-nav-tools { display: flex; align-items: center; gap: 20px; font-size: 16px; font-weight: 500; }
        .lp-icon-btn { display: flex; align-items: center; justify-content: center; width: 44px; height: 44px; border: 0; border-radius: 50%; background: transparent; color: var(--ink); cursor: pointer; }
        .lp-icon-btn:hover { background: var(--paper-sunk); }
        .lp-pill { display: inline-flex; align-items: center; justify-content: center; gap: 8px; height: 44px; padding: 0 20px; border-radius: 999px; background: var(--ink); color: var(--paper); font-size: 15px; font-weight: 600; transition: background .2s; }
        .lp-pill:hover { background: var(--ink-soft); }
        .lp-menu-btn { display: none; }
        .lp-mobile { display: none; padding: 8px 0 20px; border-top: 1px solid var(--line-soft); }
        .lp-mobile.open { display: block; }
        .lp-mobile a, .lp-mobile button { display: flex; align-items: center; width: 100%; min-height: 48px; padding: 0 4px; border: 0; background: transparent; font: inherit; font-size: 17px; font-weight: 500; color: var(--ink); text-align: left; cursor: pointer; }

        /* Footer */
        .lp-footer { border-top: 1px solid var(--line); margin-top: 0; }
        .lp-footer-grid { display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap: 40px; padding: 64px 0 40px; }
        .lp-footer h4 { margin: 0 0 16px; font-family: 'JetBrains Mono', monospace; font-size: 12px; font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-faint); }
        .lp-footer ul { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 10px; font-size: 15px; color: var(--ink-soft); }
        .lp-footer ul a:hover { color: var(--sun-text); }
        .lp-footer-bottom { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 24px 0 32px; border-top: 1px solid var(--line-soft); font-size: 14px; color: var(--ink-faint); }

        @media (max-width: 900px) {
            .lp-links, .lp-nav-tools .lp-hide-sm { display: none; }
            .lp-menu-btn { display: flex; margin-left: auto; }
            .lp-nav-inner { gap: 16px; }
            .lp-footer-grid { grid-template-columns: 1fr 1fr; }
        }
        @media (max-width: 560px) {
            .lp-footer-grid { grid-template-columns: 1fr; }
            .lp-footer-bottom { flex-direction: column; align-items: flex-start; }
        }
        @media (prefers-reduced-motion: reduce) {
            html { scroll-behavior: auto; }
            *, ::before, ::after { animation-duration: 0.01ms !important; animation-iteration-count: 1 !important; transition-duration: 0.01ms !important; }
        }
    </style>
</head>
<body>
    <nav class="lp-nav" aria-label="Main">
        <div class="lp-wrap">
            <div class="lp-nav-inner">
                <a href="/" class="lp-logo" aria-label="Soli home">
                    <svg width="28" height="28" viewBox="0 0 28 28" fill="none" stroke="#E8590C" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="14" cy="14" r="5" fill="#E8590C"/><path d="M14 2v4M14 22v4M2 14h4M22 14h4M5.5 5.5l2.8 2.8M19.7 19.7l2.8 2.8M5.5 22.5l2.8-2.8M19.7 8.3l2.8-2.8"/></svg>
                    Soli
                </a>
                <div class="lp-links">
                    <a href="/docs">Docs</a>
                    <a href="/docs/getting-started/installation">Get started</a>
                    <a href="/ai">AI</a>
                    <a href="/demos/client-interactivity">Demos</a>
                    <a href="/docs/getting-started/changelog">Changelog</a>
                    <a href="/docs/blog">Blog</a>
                </div>
                <div class="lp-nav-tools">
                    <button type="button" class="lp-icon-btn" onclick="openSearchModal()" aria-label="Search the docs">
                        <svg width="20" height="20" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><circle cx="7" cy="7" r="5"/><path d="M11 11l3.5 3.5"/></svg>
                    </button>
                    <button type="button" class="theme-toggle" onclick="toggleTheme()" aria-label="Toggle light and dark theme" style="width: 44px; height: 44px;">
                        <svg class="i-sun" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
                        <svg class="i-moon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1111.2 3a7 7 0 009.8 9.8z"/></svg>
                    </button>
                    <a href="https://github.com/solisoft/soli_lang" target="_blank" rel="noopener" class="lp-hide-sm">GitHub</a>
                    <a href="/docs/getting-started/installation" class="lp-pill lp-hide-sm">Install</a>
                </div>
                <button type="button" class="lp-icon-btn lp-menu-btn" onclick="toggleMobileNav()" aria-label="Open the menu" aria-controls="mobileNav">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
                </button>
            </div>
            <div id="mobileNav" class="lp-mobile">
                <a href="/docs">Docs</a>
                <a href="/docs/getting-started/installation">Get started</a>
                <a href="/ai">AI</a>
                <a href="/demos/client-interactivity">Demos</a>
                <a href="/docs/getting-started/changelog">Changelog</a>
                <a href="/docs/blog">Blog</a>
                <button type="button" onclick="openSearchModal()">Search</button>
                <a href="https://github.com/solisoft/soli_lang" target="_blank" rel="noopener">GitHub</a>
            </div>
        </div>
    </nav>

    <main>
        <%= yield %>
    </main>

    <footer class="lp-footer">
        <div class="lp-wrap">
            <div class="lp-footer-grid">
                <div>
                    <div class="lp-logo" style="font-size: 24px; margin-bottom: 14px;">Soli</div>
                    <p style="margin: 0; max-width: 340px; font-size: 15px; line-height: 1.6; color: var(--ink-soft);">The whole framework in one binary: Ruby's expressiveness, Rust's speed, zero dependencies.</p>
                </div>
                <div>
                    <h4>Documentation</h4>
                    <ul>
                        <li><a href="/docs/getting-started/introduction">Introduction</a></li>
                        <li><a href="/docs/getting-started/installation">Installation</a></li>
                        <li><a href="/docs/core-concepts/routing">Routing</a></li>
                        <li><a href="/docs/core-concepts/controllers">Controllers</a></li>
                    </ul>
                </div>
                <div>
                    <h4>Project</h4>
                    <ul>
                        <li><a href="/docs/getting-started/changelog">Changelog</a></li>
                        <li><a href="/docs/getting-started/comparison">Comparison</a></li>
                        <li><a href="/docs/getting-started/benchmarks">Benchmarks</a></li>
                        <li><a href="/docs/blog">Blog</a></li>
                    </ul>
                </div>
                <div>
                    <h4>Community</h4>
                    <ul>
                        <li><a href="https://github.com/solisoft/soli_lang" target="_blank" rel="noopener">GitHub</a></li>
                    </ul>
                </div>
            </div>
            <div class="lp-footer-bottom">
                <span>&copy; 2026 SoliLang. MIT License.</span>
                <span id="version-badge" class="lp-mono" style="font-family: 'JetBrains Mono', monospace; font-size: 13px;"></span>
            </div>
        </div>
    </footer>

    <%- render_partial("layouts/search_modal") %>

    <script>
    function toggleMobileNav() {
        document.getElementById('mobileNav').classList.toggle('open');
    }

    // Latest release, from GitHub. The badge lives in the footer.
    async function updateVersionBadge() {
        const versionBadge = document.getElementById('version-badge');
        if (!versionBadge) return;

        try {
            const response = await fetch('https://api.github.com/repos/solisoft/soli_lang/releases/latest');
            if (response.ok) {
                const data = await response.json();
                const version = (data.tag_name || '').replace('v', '');
                if (version) versionBadge.textContent = 'v' + version;
            }
        } catch (e) {
            versionBadge.textContent = '';
        }
    }

    // This inline script re-executes on every instant-nav <body> swap, so run
    // directly rather than waiting on an event that may never fire again.
    updateVersionBadge();
    </script>

    <script defer src="<%= public_path("js/htmx.min.js") %>"></script>
    <script defer src="<%= public_path("js/alpine.min.js") %>"></script>
</body>
</html>
