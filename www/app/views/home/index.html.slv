<!-- Hero -->
<section class="lp-hero">
    <span class="lp-ring" style="top: -360px; right: -300px; width: 900px; height: 900px; border: 1px solid var(--sun); opacity: .35;" aria-hidden="true"></span>
    <span class="lp-ring" style="top: -220px; right: -160px; width: 620px; height: 620px; border: 1px solid var(--sun); opacity: .5;" aria-hidden="true"></span>
    <span class="lp-ring" style="top: -100px; right: -40px; width: 380px; height: 380px; background: var(--sun); opacity: .12;" aria-hidden="true"></span>

    <div class="lp-wrap" style="position: relative; padding-top: clamp(24px, 5vh, 72px); padding-bottom: clamp(24px, 6vh, 72px);">
        <div class="lp-hero-grid">
            <div style="display: flex; flex-direction: column; gap: clamp(16px, 3vh, 28px);">
                <div style="display: inline-flex; align-items: center; gap: 10px; align-self: flex-start; min-height: 34px; padding: 0 14px; border-radius: 999px; border: 1px solid var(--ink); font-family: 'JetBrains Mono', monospace; font-size: 13px;">
                    <span style="width: 8px; height: 8px; border-radius: 50%; background: var(--sun);"></span>
                    a language and a framework, written in Rust
                </div>
                <h1 class="lp-h1">Write it like Ruby. <span class="lp-em">Serve it like Rust.</span></h1>
                <p class="lp-lead" style="max-width: 540px;">
                    Soli is a programming language with a complete web framework built in. Models, auth, jobs, mail,
                    PDF, WebSockets, live views and tests all ship in one binary, and
                    <code style="font-size: 0.9em;">soli</code> is the only thing you install.
                </p>
                <div style="display: flex; flex-wrap: wrap; align-items: center; gap: 14px;">
                    <a href="/docs/getting-started/introduction" class="lp-btn lp-btn-solid">Get started</a>
                    <button type="button" onclick="copyNewAppCmd(this)" class="lp-btn lp-btn-line lp-chip-cmd" title="Copy to clipboard">
                        <span style="color: var(--sun-text);" aria-hidden="true">$</span>
                        <span>soli new blog &amp;&amp; soli serve blog</span>
                        <span data-copy-label style="font-family: 'Instrument Sans', sans-serif; font-size: 13px; color: var(--ink-faint);">Copy</span>
                    </button>
                </div>
                <a href="https://github.com/solisoft/soli_lang" target="_blank" rel="noopener" class="lp-link" style="align-self: flex-start;">View on GitHub</a>
            </div>

            <div class="lp-code lp-code-fit">
                <div class="lp-code-bar"><span>app/controllers/posts_controller.sl</span></div>
<pre><code><span class="k">class</span> <span class="n">PostsController &lt; Controller</span>
  <span class="c"># GET /posts — renders with @posts</span>
  <span class="k">def</span> <span class="n">index(req)</span>
    <span class="v">@posts</span> <span class="n">= Post.all</span>
  <span class="k">end</span>

  <span class="c"># POST /posts</span>
  <span class="k">def</span> <span class="n">create(req)</span>
    <span class="n">attrs = permit(params, {</span><span class="s">"title"</span><span class="n">: true})</span>
    <span class="v">@post</span> <span class="n">= Post.create(attrs)</span>
    <span class="k">return</span> <span class="n">render(</span><span class="s">"new"</span><span class="n">)</span> <span class="k">if</span> <span class="v">@post</span><span class="n">._errors</span>

    <span class="n">redirect(post_path(</span><span class="v">@post</span><span class="n">))</span>
  <span class="k">end</span>
<span class="k">end</span></code></pre>
            </div>
        </div>
    </div>
</section>

<!-- Proof strip -->
<div class="lp-wrap">
    <div class="lp-proof">
        <div><strong>1.2M+</strong><span>plaintext requests per second</span></div>
        <div><strong>834k+</strong><span>JSON requests per second</span></div>
        <div><strong>0</strong><span>dependencies to install</span></div>
        <div><strong>1</strong><span>binary: server, tests, linter</span></div>
    </div>
</div>

<!-- Anatomy of a request -->
<section class="lp-section">
    <div class="lp-wrap">
        <div style="display: flex; flex-direction: column; gap: 20px; max-width: 760px;">
            <div style="align-self: flex-start; display: inline-flex; gap: 10px; min-height: 34px; align-items: center; padding: 0 14px; border-radius: 8px; background: var(--paper-sunk); font-family: 'JetBrains Mono', monospace; font-size: 14px;">
                <strong style="color: var(--sun-text);">GET</strong><span>/posts</span>
            </div>
            <h2 class="lp-h2">Anatomy of a request</h2>
            <p class="lp-lead">One route, one controller, one model, one view. The dev bar times every hop, and there is nothing else to wire up.</p>
        </div>

        <div class="lp-trace" style="margin-top: 56px;">
            <span class="lp-pulse" aria-hidden="true"></span>

            <div class="lp-hop">
                <div class="lp-code">
                    <div class="lp-code-bar"><span>config/routes.sl</span><span class="lp-tag">2 &micro;s</span></div>
<pre><code><span class="n">get(</span><span class="s">"/posts"</span><span class="n">, </span><span class="s">"posts#index"</span><span class="n">)</span></code></pre>
                </div>
            </div>

            <div class="lp-hop">
                <div class="lp-code">
                    <div class="lp-code-bar"><span>app/controllers/posts_controller.sl</span><span class="lp-tag">14 &micro;s</span></div>
<pre><code><span class="k">class</span> <span class="n">PostsController &lt; Controller</span>
  <span class="k">def</span> <span class="n">index</span>
    <span class="v">@posts</span> <span class="n">= Post</span>
      <span class="n">.where(</span><span class="s">"doc.status == @s"</span><span class="n">, { </span><span class="s">"s"</span><span class="n">: </span><span class="s">"published"</span><span class="n"> })</span>
      <span class="n">.order(</span><span class="s">"created_at"</span><span class="n">, </span><span class="s">"desc"</span><span class="n">)</span>
      <span class="n">.limit(10).all</span>
  <span class="k">end</span>
<span class="k">end</span></code></pre>
                </div>
            </div>

            <div class="lp-hop">
                <div class="lp-code">
                    <div class="lp-code-bar"><span>app/models/post.sl</span><span class="lp-tag">190 &micro;s</span></div>
<pre><code><span class="k">class</span> <span class="n">Post &lt; Model</span>
  <span class="n">validates(</span><span class="s">"title"</span><span class="n">, { </span><span class="s">"presence"</span><span class="n">: true, </span><span class="s">"min_length"</span><span class="n">: 3 })</span>

  <span class="k">def</span> <span class="n">author</span>
    <span class="n">User.find(</span><span class="v">@author_id</span><span class="n">)</span>
  <span class="k">end</span>
<span class="k">end</span></code></pre>
                    <div class="lp-query">
                        dev_queries() &middot; 1 AQL query &middot; 0.19 ms
                        <pre>FOR doc IN posts FILTER doc.status == @s SORT doc.created_at DESC LIMIT 10 RETURN doc</pre>
                    </div>
                </div>
            </div>

            <div class="lp-hop">
                <div class="lp-code">
                    <div class="lp-code-bar"><span>app/views/posts/index.html.slv</span><span class="lp-tag">34 &micro;s</span></div>
<pre><code><span class="k">&lt;% for post in @posts %&gt;</span>
  <span class="c">&lt;article&gt;</span>
    <span class="c">&lt;h2&gt;</span><span class="n">&lt;%= post["title"] %&gt;</span><span class="c">&lt;/h2&gt;</span>
    <span class="c">&lt;p&gt;</span><span class="n">&lt;%= post["excerpt"] %&gt;</span><span class="c">&lt;/p&gt;</span>
  <span class="c">&lt;/article&gt;</span>
<span class="k">&lt;% end %&gt;</span></code></pre>
                </div>
            </div>

            <div class="lp-hop">
                <div class="lp-code" style="border: 1px solid var(--sun);">
<pre><code><span class="ok">HTTP/1.1 200 OK</span>
<span class="c">X-Soli-Route:</span> <span class="n">posts#index</span>
<span class="c">X-Soli-Render-Us:</span> <span class="k">240</span></code></pre>
                    <div class="lp-query" style="font-family: 'Instrument Sans', sans-serif; font-size: 14px;">240 &micro;s of server time. The dev bar measures every request, every query, on every page you build.</div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Batteries: a Rails Gemfile, struck through by what ships in the binary -->
<section id="batteries" class="lp-section" style="background: var(--paper-sunk);">
    <style>
        #batteries .bt-layout { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); gap: clamp(32px, 5vw, 72px); align-items: start; margin-top: 56px; }
        #batteries .bt-panel { position: sticky; top: 88px; display: flex; flex-direction: column; max-height: calc(100vh - 120px); }
        #batteries .bt-scroll { position: relative; flex: 1 1 auto; min-height: 0; overflow: auto; overscroll-behavior: contain; }
        #batteries .bt-panel pre { font-size: 13.5px; line-height: 1.7; font-variant-ligatures: none; }
        #batteries .ln { display: inline-block; position: relative; padding: 0 2px; border-radius: 4px; transition: opacity .25s ease, background-color .25s ease; }
        #batteries .g::after { content: ""; position: absolute; left: -3px; right: -3px; top: calc(50% - 1px); height: 2px; border-radius: 2px; background: var(--sun); }
        #batteries .bt-armed .g::after { transform: scaleX(0); transform-origin: left center; transition: transform .5s cubic-bezier(.2, .7, .2, 1); transition-delay: calc(var(--i) * 40ms + 200ms); }
        #batteries .bt-armed.bt-struck .g::after { transform: scaleX(1); }
        #batteries .bt-panel.has-active .bt-scroll pre { color: rgba(233, 226, 214, .3); }
        #batteries .bt-panel.has-active .bt-scroll pre span { opacity: .45; }
        #batteries .bt-panel.has-active .ln.is-on, #batteries .bt-panel.has-active .ln.is-on span { opacity: 1; }
        #batteries .bt-panel.has-active .ln.is-on { background: rgba(232, 89, 12, .22); }
        #batteries .bt-list { list-style: none; margin: 0; padding: 0; border-bottom: 1px solid var(--line); }
        #batteries .bt-row { position: relative; display: flex; flex-direction: column; gap: 8px; padding: 22px 0 22px 22px; border-top: 1px solid var(--line); outline: none; cursor: default; }
        #batteries .bt-row::before { content: ""; position: absolute; left: 0; top: 22px; bottom: 22px; width: 3px; border-radius: 3px; background: var(--sun); transform: scaleY(0); transform-origin: top; transition: transform .25s ease; }
        #batteries .bt-row.is-active::before { transform: scaleY(1); }
        #batteries .bt-row:focus-visible { box-shadow: 0 0 0 2px var(--sun); border-radius: 10px; }
        #batteries .bt-title { margin: 0; font-family: 'Fraunces', serif; font-weight: 600; font-size: 22px; letter-spacing: -0.015em; color: var(--ink); }
        #batteries .bt-row p { margin: 0; max-width: 46ch; font-size: 16px; line-height: 1.55; color: var(--ink-soft); }
        #batteries .bt-row p code { padding: 1px 6px; border-radius: 6px; background: var(--paper-raised); font-family: 'JetBrains Mono', monospace; font-size: 0.88em; color: var(--ink); }
        #batteries .bt-snip { align-self: flex-start; max-width: 100%; overflow-wrap: anywhere; font-family: 'JetBrains Mono', monospace; font-size: 13.5px; color: var(--sun-text); }
        #batteries .bt-rest .lp-chips { margin-top: 6px; }
        #batteries .bt-sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
        @media (max-width: 900px) {
            #batteries .bt-layout { grid-template-columns: minmax(0, 1fr); }
            #batteries .bt-panel { position: relative; top: 0; max-height: 440px; }
        }
        @media (prefers-reduced-motion: reduce) {
            #batteries .ln, #batteries .bt-row::before { transition: none; }
        }
    </style>
    <div class="lp-wrap">
        <div style="display: flex; flex-direction: column; gap: 20px; max-width: 760px;">
            <div class="lp-eyebrow">Soli MVC</div>
            <h2 class="lp-h2">Batteries actually included</h2>
            <p class="lp-lead">This is the Gemfile a production Rails app grows to do what Soli does out of the box. Point at a feature, or tap it, to see the gems it replaces.</p>
        </div>

        <div class="bt-layout">
            <div class="lp-code bt-panel">
                <div class="lp-code-bar"><span>Gemfile</span><span class="lp-tag">35 gems you won&rsquo;t add</span></div>
                <div class="bt-scroll">
<pre><code><span class="k">source</span> <span class="s">"https://rubygems.org"</span>
<span class="k">gem</span> <span class="s">"rails"</span>, <span class="s">"~&gt; 8.0"</span>
<span class="ln bt-note" data-cap="mailer"><span class="c"># Mail: Action Mailer ships with Rails</span></span>

<span class="c"># Sign-in and permissions</span>
<span class="ln g" data-cap="auth" style="--i: 0"><span class="k">gem</span> <span class="s">"devise"</span></span>
<span class="ln g" data-cap="auth" style="--i: 1"><span class="k">gem</span> <span class="s">"pundit"</span></span>
<span class="ln g" data-cap="oauth" style="--i: 2"><span class="k">gem</span> <span class="s">"omniauth"</span></span>
<span class="ln g" data-cap="oauth" style="--i: 3"><span class="k">gem</span> <span class="s">"omniauth-github"</span></span>
<span class="ln g" data-cap="oauth" style="--i: 4"><span class="k">gem</span> <span class="s">"doorkeeper"</span></span>

<span class="c"># Work off the request</span>
<span class="ln g" data-cap="jobs" style="--i: 5"><span class="k">gem</span> <span class="s">"sidekiq"</span></span>
<span class="ln g" data-cap="jobs" style="--i: 6"><span class="k">gem</span> <span class="s">"sidekiq-cron"</span></span>

<span class="c"># Documents</span>
<span class="ln g" data-cap="pdf" style="--i: 7"><span class="k">gem</span> <span class="s">"prawn"</span></span>
<span class="ln g" data-cap="pdf" style="--i: 8"><span class="k">gem</span> <span class="s">"prawn-table"</span></span>
<span class="ln g" data-cap="pdf" style="--i: 9"><span class="k">gem</span> <span class="s">"hexapdf"</span></span>

<span class="c"># Search</span>
<span class="ln g" data-cap="search" style="--i: 10"><span class="k">gem</span> <span class="s">"searchkick"</span></span>
<span class="ln g" data-cap="search" style="--i: 11"><span class="k">gem</span> <span class="s">"neighbor"</span></span>
<span class="ln g" data-cap="search" style="--i: 12"><span class="k">gem</span> <span class="s">"geocoder"</span></span>

<span class="c"># Real time</span>
<span class="ln g" data-cap="ws" style="--i: 13"><span class="k">gem</span> <span class="s">"redis"</span></span>
<span class="ln g" data-cap="live" style="--i: 14"><span class="k">gem</span> <span class="s">"turbo-rails"</span></span>
<span class="ln g" data-cap="live" style="--i: 15"><span class="k">gem</span> <span class="s">"stimulus-rails"</span></span>
<span class="ln g" data-cap="push" style="--i: 16"><span class="k">gem</span> <span class="s">"web-push"</span></span>

<span class="c"># API docs</span>
<span class="ln g" data-cap="api" style="--i: 17"><span class="k">gem</span> <span class="s">"rswag-api"</span></span>
<span class="ln g" data-cap="api" style="--i: 18"><span class="k">gem</span> <span class="s">"rswag-ui"</span></span>

<span class="c"># Production signals</span>
<span class="ln g" data-cap="obs" style="--i: 19"><span class="k">gem</span> <span class="s">"prometheus_exporter"</span></span>
<span class="ln g" data-cap="obs" style="--i: 20"><span class="k">gem</span> <span class="s">"lograge"</span></span>
<span class="ln g" data-cap="obs" style="--i: 21"><span class="k">gem</span> <span class="s">"opentelemetry-sdk"</span></span>
<span class="ln g" data-cap="obs" style="--i: 22"><span class="k">gem</span> <span class="s">"opentelemetry-instrumentation-all"</span></span>
<span class="ln g" data-cap="obs" style="--i: 23"><span class="k">gem</span> <span class="s">"sentry-rails"</span></span>

<span class="c"># Everything else</span>
<span class="ln g" data-cap="rest" style="--i: 24"><span class="k">gem</span> <span class="s">"rack-attack"</span></span>
<span class="ln g" data-cap="rest" style="--i: 25"><span class="k">gem</span> <span class="s">"aasm"</span></span>
<span class="ln g" data-cap="rest" style="--i: 26"><span class="k">gem</span> <span class="s">"flipper"</span></span>
<span class="ln g" data-cap="rest" style="--i: 27"><span class="k">gem</span> <span class="s">"aws-sdk-s3"</span></span>
<span class="ln g" data-cap="rest" style="--i: 28"><span class="k">gem</span> <span class="s">"caxlsx"</span></span>
<span class="ln g" data-cap="rest" style="--i: 29"><span class="k">gem</span> <span class="s">"rails-i18n"</span></span>

<span class="k">group :test do</span>
  <span class="ln g" data-cap="tests" style="--i: 30"><span class="k">gem</span> <span class="s">"rspec-rails"</span></span>
  <span class="ln g" data-cap="api" style="--i: 31"><span class="k">gem</span> <span class="s">"rswag-specs"</span></span>
  <span class="ln g" data-cap="tests" style="--i: 32"><span class="k">gem</span> <span class="s">"capybara"</span></span>
  <span class="ln g" data-cap="tests" style="--i: 33"><span class="k">gem</span> <span class="s">"selenium-webdriver"</span></span>
  <span class="ln g" data-cap="tests" style="--i: 34"><span class="k">gem</span> <span class="s">"simplecov"</span></span>
<span class="k">end</span>

<span class="c"># ...plus Redis and Elasticsearch running beside it.</span>
<span class="c"># Rails 8 folds some of this in (Solid Queue, Solid Cable).</span></code></pre>
                </div>
            </div>

            <ul class="bt-list" role="list">
                <li class="bt-row" data-cap="auth" tabindex="0">
                    <h3 class="bt-title">Authentication &amp; policies</h3>
                    <p><code>soli generate auth</code> writes sign-up, login, password reset and a policy layer.</p>
                    <code class="bt-snip">authorize(post)</code>
                    <span class="bt-sr">In a Rails app: devise and pundit.</span>
                </li>
                <li class="bt-row" data-cap="oauth" tabindex="0">
                    <h3 class="bt-title">Sign in with GitHub, or be the provider</h3>
                    <p>OAuth for six providers, and an OpenID Connect provider of your own.</p>
                    <code class="bt-snip">soli generate oauth github</code>
                    <span class="bt-sr">In a Rails app: omniauth, omniauth-github and doorkeeper.</span>
                </li>
                <li class="bt-row" data-cap="jobs" tabindex="0">
                    <h3 class="bt-title">Background jobs</h3>
                    <p>Scheduling, priorities, retries and cron, stored in your database. No Redis to run.</p>
                    <code class="bt-snip">WelcomeEmailJob.perform_later(args)</code>
                    <span class="bt-sr">In a Rails app: sidekiq and sidekiq-cron.</span>
                </li>
                <li class="bt-row" data-cap="mailer" tabindex="0">
                    <h3 class="bt-title">Mailer</h3>
                    <p>Templates, layouts and attachments, sent now or from the job queue. Rails ships this one too.</p>
                    <code class="bt-snip">UserMailer.welcome(user).deliver_later</code>
                    <span class="bt-sr">A Rails app gets this from Action Mailer.</span>
                </li>
                <li class="bt-row" data-cap="pdf" tabindex="0">
                    <h3 class="bt-title">PDF &amp; e-invoices</h3>
                    <p>Invoice-grade PDFs, Factur-X e-invoices and PAdES signatures, returned from an action.</p>
                    <code class="bt-snip">pdf_response(template, data)</code>
                    <span class="bt-sr">In a Rails app: prawn, prawn-table and hexapdf.</span>
                </li>
                <li class="bt-row" data-cap="search" tabindex="0">
                    <h3 class="bt-title">Search</h3>
                    <p>Vector, fulltext and geo indexes declared on the model.</p>
                    <code class="bt-snip">Article.similar("query", "embedding", 5)</code>
                    <span class="bt-sr">In a Rails app: searchkick, neighbor and geocoder.</span>
                </li>
                <li class="bt-row" data-cap="ws" tabindex="0">
                    <h3 class="bt-title">WebSockets</h3>
                    <p>Channels, rooms and broadcast. Hashes serialize themselves.</p>
                    <code class="bt-snip">ws_broadcast_room(room, message)</code>
                    <span class="bt-sr">In a Rails app: redis.</span>
                </li>
                <li class="bt-row" data-cap="live" tabindex="0">
                    <h3 class="bt-title">Live views</h3>
                    <p>Reactive, server-rendered components without writing JavaScript.</p>
                    <code class="bt-snip">&lt;button soli-click="add"&gt;+&lt;/button&gt;</code>
                    <span class="bt-sr">In a Rails app: turbo-rails and stimulus-rails.</span>
                </li>
                <li class="bt-row" data-cap="push" tabindex="0">
                    <h3 class="bt-title">Streaming &amp; Web Push</h3>
                    <p>Server-Sent Events, chunked exports, and Web Push with VAPID keys.</p>
                    <code class="bt-snip">sse(req) do |out| … end</code>
                    <span class="bt-sr">In a Rails app: web-push.</span>
                </li>
                <li class="bt-row" data-cap="api" tabindex="0">
                    <h3 class="bt-title">API reference</h3>
                    <p>An OpenAPI 3 spec built from your routes and the comments above each action.</p>
                    <code class="bt-snip"># @response 200 {"ok": true}</code>
                    <span class="bt-sr">In a Rails app: rswag-api, rswag-ui and rswag-specs.</span>
                </li>
                <li class="bt-row" data-cap="obs" tabindex="0">
                    <h3 class="bt-title">Observability</h3>
                    <p>Prometheus metrics, JSON logs and OpenTelemetry traces, one environment variable each, plus an error inbox.</p>
                    <code class="bt-snip">SOLI_METRICS=1 SOLI_OTEL=1</code>
                    <span class="bt-sr">In a Rails app: prometheus_exporter, lograge, opentelemetry-sdk, opentelemetry-instrumentation-all and sentry-rails.</span>
                </li>
                <li class="bt-row" data-cap="tests" tabindex="0">
                    <h3 class="bt-title">Tests</h3>
                    <p>Request specs, headless-browser specs and coverage, from the same binary.</p>
                    <code class="bt-snip">soli test --coverage</code>
                    <span class="bt-sr">In a Rails app: rspec-rails, capybara, selenium-webdriver and simplecov.</span>
                </li>
                <li class="bt-row bt-rest" data-cap="rest" tabindex="0">
                    <h3 class="bt-title">And the rest, quietly</h3>
                    <div class="lp-chips"><span>Validations</span><span>i18n</span><span>Sessions</span><span>Signed cookies</span><span>CSRF</span><span>Cache &amp; KV</span><span>Rate limiting</span><span>Uploads</span><span>S3</span><span>Spreadsheets</span><span>Migrations</span><span>State machines</span><span>Feature flags</span><span>Analytics</span><span>Linter</span><span>Formatter</span><span>Hot reload</span><span>Dev bar</span></div>
                    <span class="bt-sr">In a Rails app: rack-attack, aasm, flipper, aws-sdk-s3, caxlsx and rails-i18n.</span>
                </li>
            </ul>
        </div>
    </div>
    <script>
        (function () {
            var root = document.getElementById("batteries");
            if (!root) return;
            var panel = root.querySelector(".bt-panel");
            var scroller = root.querySelector(".bt-scroll");
            var list = root.querySelector(".bt-list");
            var rows = root.querySelectorAll(".bt-row");
            var lines = panel.querySelectorAll("[data-cap]");
            var calm = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

            function show(cap) {
                var first = null;
                panel.classList.toggle("has-active", !!cap);
                lines.forEach(function (line) {
                    var on = !!cap && line.dataset.cap === cap;
                    line.classList.toggle("is-on", on);
                    if (on && !first) first = line;
                });
                rows.forEach(function (row) { row.classList.toggle("is-active", row.dataset.cap === cap); });
                if (first) scroller.scrollTo({ top: Math.max(0, first.offsetTop - scroller.clientHeight / 3), behavior: calm ? "auto" : "smooth" });
            }

            rows.forEach(function (row) {
                row.addEventListener("mouseenter", function () { show(row.dataset.cap); });
                row.addEventListener("focus", function () { show(row.dataset.cap); });
            });
            list.addEventListener("mouseleave", function () { if (!list.contains(document.activeElement)) show(null); });
            list.addEventListener("focusout", function (event) { if (!list.contains(event.relatedTarget)) show(null); });

            // The one moment: the strikes draw down the Gemfile the first time it scrolls into view.
            if (calm || !("IntersectionObserver" in window)) return;
            panel.classList.add("bt-armed");
            var seen = new IntersectionObserver(function (entries) {
                if (!entries[0].isIntersecting) return;
                panel.classList.add("bt-struck");
                seen.disconnect();
            }, { threshold: 0.35 });
            seen.observe(panel);
        })();
    </script>
</section>

<!-- Generators -->
