<!-- Hero -->
<section class="lp-hero">
    <span class="lp-ring" style="top: -360px; right: -300px; width: 900px; height: 900px; border: 1px solid var(--sun); opacity: .35;" aria-hidden="true"></span>
    <span class="lp-ring" style="top: -220px; right: -160px; width: 620px; height: 620px; border: 1px solid var(--sun); opacity: .5;" aria-hidden="true"></span>
    <span class="lp-ring" style="top: -100px; right: -40px; width: 380px; height: 380px; background: var(--sun); opacity: .12;" aria-hidden="true"></span>

    <div class="lp-wrap" style="position: relative; padding-top: clamp(24px, 5vh, 72px); padding-bottom: clamp(24px, 6vh, 72px);">
        <div class="lp-hero-grid">
            <div style="display: flex; flex-direction: column; gap: clamp(16px, 3vh, 28px);">
                <div style="display: inline-flex; align-items: center; gap: 10px; align-self: flex-start; min-height: 34px; padding: 0 14px; border-radius: 999px; border: 1px solid var(--ink); font-family: 'JetBrains Mono', monospace; font-size: 13px;">
                    <span style="width: 8px; height: 8px; border-radius: 50%; background: var(--sun);"></span>
                    a language and a framework, written in Rust
                </div>
                <h1 class="lp-h1">Write it like Ruby. <span class="lp-em">Serve it like Rust.</span></h1>
                <p class="lp-lead" style="max-width: 540px;">
                    Soli is a programming language with a complete web framework built in. Models, auth, jobs, mail,
                    PDF, WebSockets, live views and tests all ship in one binary, and
                    <code style="font-size: 0.9em;">soli</code> is the only thing you install.
                </p>
                <div style="display: flex; flex-wrap: wrap; align-items: center; gap: 14px;">
                    <a href="/docs/getting-started/introduction" class="lp-btn lp-btn-solid">Get started</a>
                    <button type="button" onclick="copyNewAppCmd(this)" class="lp-btn lp-btn-line lp-chip-cmd" title="Copy to clipboard">
                        <span style="color: var(--sun-text);" aria-hidden="true">$</span>
                        <span>soli new blog &amp;&amp; soli serve blog</span>
                        <span data-copy-label style="font-family: 'Instrument Sans', sans-serif; font-size: 13px; color: var(--ink-faint);">Copy</span>
                    </button>
                </div>
                <a href="https://github.com/solisoft/soli_lang" target="_blank" rel="noopener" class="lp-link" style="align-self: flex-start;">View on GitHub</a>
            </div>

            <div class="lp-code lp-code-fit">
                <div class="lp-code-bar"><span>app/controllers/posts_controller.sl</span></div>
<pre><code><span class="k">class</span> <span class="n">PostsController &lt; Controller</span>
  <span class="c"># GET /posts — renders with @posts</span>
  <span class="k">def</span> <span class="n">index(req)</span>
    <span class="v">@posts</span> <span class="n">= Post.all</span>
  <span class="k">end</span>

  <span class="c"># POST /posts</span>
  <span class="k">def</span> <span class="n">create(req)</span>
    <span class="n">attrs = permit(params, {</span><span class="s">"title"</span><span class="n">: true})</span>
    <span class="v">@post</span> <span class="n">= Post.create(attrs)</span>
    <span class="k">return</span> <span class="n">render(</span><span class="s">"new"</span><span class="n">)</span> <span class="k">if</span> <span class="v">@post</span><span class="n">._errors</span>

    <span class="n">redirect(post_path(</span><span class="v">@post</span><span class="n">))</span>
  <span class="k">end</span>
<span class="k">end</span></code></pre>
            </div>
        </div>
    </div>
</section>

<!-- Proof strip -->
<div class="lp-wrap">
    <div class="lp-proof">
        <div><strong>1.2M+</strong><span>plaintext requests per second</span></div>
        <div><strong>834k+</strong><span>JSON requests per second</span></div>
        <div><strong>0</strong><span>dependencies to install</span></div>
        <div><strong>1</strong><span>binary: server, tests, linter</span></div>
    </div>
</div>

<!-- Anatomy of a request -->
<section class="lp-section">
    <div class="lp-wrap">
        <div style="display: flex; flex-direction: column; gap: 20px; max-width: 760px;">
            <div style="align-self: flex-start; display: inline-flex; gap: 10px; min-height: 34px; align-items: center; padding: 0 14px; border-radius: 8px; background: var(--paper-sunk); font-family: 'JetBrains Mono', monospace; font-size: 14px;">
                <strong style="color: var(--sun-text);">GET</strong><span>/posts</span>
            </div>
            <h2 class="lp-h2">Anatomy of a request</h2>
            <p class="lp-lead">One route, one controller, one model, one view. The dev bar times every hop, and there is nothing else to wire up.</p>
        </div>

        <div class="lp-trace" style="margin-top: 56px;">
            <span class="lp-pulse" aria-hidden="true"></span>

            <div class="lp-hop">
                <div class="lp-code">
                    <div class="lp-code-bar"><span>config/routes.sl</span><span class="lp-tag">2 &micro;s</span></div>
<pre><code><span class="n">get(</span><span class="s">"/posts"</span><span class="n">, </span><span class="s">"posts#index"</span><span class="n">)</span></code></pre>
                </div>
            </div>

            <div class="lp-hop">
                <div class="lp-code">
                    <div class="lp-code-bar"><span>app/controllers/posts_controller.sl</span><span class="lp-tag">14 &micro;s</span></div>
<pre><code><span class="k">class</span> <span class="n">PostsController &lt; Controller</span>
  <span class="k">def</span> <span class="n">index</span>
    <span class="v">@posts</span> <span class="n">= Post</span>
      <span class="n">.where(</span><span class="s">"doc.status == @s"</span><span class="n">, { </span><span class="s">"s"</span><span class="n">: </span><span class="s">"published"</span><span class="n"> })</span>
      <span class="n">.order(</span><span class="s">"created_at"</span><span class="n">, </span><span class="s">"desc"</span><span class="n">)</span>
      <span class="n">.limit(10).all</span>
  <span class="k">end</span>
<span class="k">end</span></code></pre>
                </div>
            </div>

            <div class="lp-hop">
                <div class="lp-code">
                    <div class="lp-code-bar"><span>app/models/post.sl</span><span class="lp-tag">190 &micro;s</span></div>
<pre><code><span class="k">class</span> <span class="n">Post &lt; Model</span>
  <span class="n">validates(</span><span class="s">"title"</span><span class="n">, { </span><span class="s">"presence"</span><span class="n">: true, </span><span class="s">"min_length"</span><span class="n">: 3 })</span>

  <span class="k">def</span> <span class="n">author</span>
    <span class="n">User.find(</span><span class="v">@author_id</span><span class="n">)</span>
  <span class="k">end</span>
<span class="k">end</span></code></pre>
                    <div class="lp-query">
                        dev_queries() &middot; 1 AQL query &middot; 0.19 ms
                        <pre>FOR doc IN posts FILTER doc.status == @s SORT doc.created_at DESC LIMIT 10 RETURN doc</pre>
                    </div>
                </div>
            </div>

            <div class="lp-hop">
                <div class="lp-code">
                    <div class="lp-code-bar"><span>app/views/posts/index.html.slv</span><span class="lp-tag">34 &micro;s</span></div>
<pre><code><span class="k">&lt;% for post in @posts %&gt;</span>
  <span class="c">&lt;article&gt;</span>
    <span class="c">&lt;h2&gt;</span><span class="n">&lt;%= post["title"] %&gt;</span><span class="c">&lt;/h2&gt;</span>
    <span class="c">&lt;p&gt;</span><span class="n">&lt;%= post["excerpt"] %&gt;</span><span class="c">&lt;/p&gt;</span>
  <span class="c">&lt;/article&gt;</span>
<span class="k">&lt;% end %&gt;</span></code></pre>
                </div>
            </div>

            <div class="lp-hop">
                <div class="lp-code" style="border: 1px solid var(--sun);">
<pre><code><span class="ok">HTTP/1.1 200 OK</span>
<span class="c">X-Soli-Route:</span> <span class="n">posts#index</span>
<span class="c">X-Soli-Render-Us:</span> <span class="k">240</span></code></pre>
                    <div class="lp-query" style="font-family: 'Instrument Sans', sans-serif; font-size: 14px;">240 &micro;s of server time. The dev bar measures every request, every query, on every page you build.</div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Batteries -->
<section class="lp-section" style="background: var(--paper-sunk);">
    <div class="lp-wrap">
        <div style="display: flex; flex-direction: column; gap: 20px; max-width: 760px;">
            <div class="lp-eyebrow">Soli MVC</div>
            <h2 class="lp-h2">Batteries actually included</h2>
            <p class="lp-lead">What every app needs is in the binary, not in a package registry. No Gemfile, no package.json, no supply chain to audit. Each one is a single line of code.</p>
        </div>

        <div class="lp-grid-3" style="margin-top: 56px;">
            <div class="lp-card">
                <h3 class="lp-h3">Authentication &amp; policies</h3>
                <p><code>soli generate auth</code> scaffolds login, sessions, and a Pundit-style policy layer.</p>
<pre><code><span style="color:#E9E2D6">authorize(post)</span>  <span style="color:#A69C8C"># 403 unless PostPolicy allows it</span></code></pre>
            </div>
            <div class="lp-card">
                <h3 class="lp-h3">Validations &amp; callbacks</h3>
                <p>Declared on the model, enforced on every create and update.</p>
<pre><code>validates(<span style="color:#A8C98A">"email"</span>, { <span style="color:#A8C98A">"presence"</span>: true, <span style="color:#A8C98A">"uniqueness"</span>: true })</code></pre>
            </div>
            <div class="lp-card">
                <h3 class="lp-h3">Background jobs</h3>
                <p>In-process queue with scheduling, priorities, retries, and cron, on any adapter.</p>
<pre><code>WelcomeEmailJob.perform_in(<span style="color:#A8C98A">"5 minutes"</span>, { <span style="color:#A8C98A">"user_id"</span>: 42 })</code></pre>
            </div>
            <div class="lp-card">
                <h3 class="lp-h3">Mailer</h3>
                <p>Rails-style mailers with templates, layouts, and attachments.</p>
<pre><code>UserMailer.welcome(user).deliver_later</code></pre>
            </div>
            <div class="lp-card">
                <h3 class="lp-h3">PDF generation</h3>
                <p>JSON templates to invoice-grade PDFs, returned straight from an action.</p>
<pre><code>pdf_response(template, data, { <span style="color:#A8C98A">"filename"</span>: <span style="color:#A8C98A">"invoice.pdf"</span> })</code></pre>
            </div>
            <div class="lp-card">
                <h3 class="lp-h3">WebSockets</h3>
                <p>Channels, rooms, and broadcast. Hashes serialize themselves.</p>
<pre><code>ws_broadcast_room(room, { <span style="color:#A8C98A">"user"</span>: name, <span style="color:#A8C98A">"body"</span>: msg })</code></pre>
            </div>
            <div class="lp-card">
                <h3 class="lp-h3">Live views</h3>
                <p>Server-rendered reactive components without writing JavaScript.</p>
<pre><code>&lt;button <span style="color:#F2A365">soli-click=</span><span style="color:#A8C98A">"increment"</span>&gt;+&lt;/button&gt;</code></pre>
            </div>
            <div class="lp-card">
                <h3 class="lp-h3">i18n</h3>
                <p>Translations with interpolation and pluralization built in.</p>
<pre><code>t(<span style="color:#A8C98A">"welcome.greeting"</span>, { <span style="color:#A8C98A">"name"</span>: user[<span style="color:#A8C98A">"name"</span>] })</code></pre>
            </div>
            <div class="lp-card" style="background: transparent; border-style: dashed; border-color: var(--ink-faint);">
                <h3 class="lp-h3">And the rest, quietly</h3>
                <div class="lp-chips" style="margin-top: 4px;">
                    <span>Sessions</span><span>Cache &amp; KV</span><span>Rate limiting</span><span>Uploads</span><span>S3</span><span>Spreadsheets</span><span>Migrations</span><span>State machines</span><span>Feature flags</span><span>Cron</span><span>Testing &amp; coverage</span><span>Linter</span><span>Formatter</span><span>Hot reload</span><span>Dev bar</span>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Generators -->
<section class="lp-section">
    <div class="lp-wrap">
        <div style="display: flex; flex-direction: column; gap: 20px; max-width: 760px; margin-bottom: 48px;">
            <h2 class="lp-h2">A working CRUD app in one command</h2>
            <p class="lp-lead">A scaffold writes the model, controller, views, tests, migration and routes. The auth generator does the same for login, sessions and policies.</p>
        </div>

        <div class="lp-code">
            <div class="lp-code-bar"><span>Terminal</span></div>
<pre><span class="ok">$</span> <span class="n type-animation invisible">soli generate scaffold blog_posts title:string content:text author:string published:boolean</span>
<span class="ok">Success!</span> <span class="n">Created scaffold for blog_posts</span>

<span class="c"># Generated files:</span>
<span class="k">app/models/blog_posts_model.sl</span>
<span class="k">app/controllers/blog_posts_controller.sl</span>
<span class="k">app/views/blog_posts/index.html.slv</span>
<span class="k">app/views/blog_posts/show.html.slv</span>
<span class="k">app/views/blog_posts/new.html.slv</span>
<span class="k">app/views/blog_posts/edit.html.slv</span>
<span class="k">app/views/blog_posts/_form.html.slv</span>
<span class="k">tests/models/blog_posts_test.sl</span>
<span class="k">tests/controllers/blog_posts_controller_test.sl</span>
<span class="k">db/migrations/*create_blog_posts_*.sl</span>
<span class="ok">&#10003;</span> <span class="n">Routes added to config/routes.sl</span>

<span class="ok">$</span> <span class="n">soli generate auth</span>
<span class="ok">Success!</span> <span class="n">Session authentication generated</span>
<span class="k">app/policies/application_policy.sl</span>
<span class="k">app/policies/user_policy.sl</span>
<span class="k">app/helpers/auth_helper.sl</span>
<span class="c">+ User model, login/signup/logout controllers &amp; views</span></pre>
        </div>

        <div style="display: flex; flex-wrap: wrap; gap: 28px; margin-top: 32px;">
            <a href="/docs/development-tools/scaffold" class="lp-link">Scaffold generator docs &rarr;</a>
            <a href="/docs/security/authorization" class="lp-link">Auth &amp; policies docs &rarr;</a>
        </div>
    </div>
</section>

<!-- Performance -->
<section style="padding: clamp(48px, 7vw, 80px) 0; border-top: 1px solid var(--ink); border-bottom: 1px solid var(--ink);">
    <div class="lp-wrap" style="display: flex; flex-wrap: wrap; align-items: center; gap: 40px 80px;">
        <div style="max-width: 400px;">
            <h2 class="lp-h2" style="font-size: clamp(28px, 3.4vw, 40px);">Fast enough to be your whole stack</h2>
            <p style="margin: 14px 0 0; font-size: 16px; line-height: 1.55; color: var(--ink-soft);">
                Measured by <a href="https://www.techempower.com/" target="_blank" rel="noopener" class="lp-link" style="display: inline;">TechEmpower</a> on 21&times; AWS c7i.2xlarge instances.
            </p>
        </div>
        <div style="display: flex; flex-wrap: wrap; gap: 40px 80px;">
            <a href="https://www.techempower.com/benchmarks/#section=test&runid=1d5bfc8a-5c4a-4fb2-a792-ad967f1eb138&test=plaintext" target="_blank" rel="noopener">
                <div class="lp-serif" style="font-weight: 600; font-size: clamp(36px, 4.4vw, 56px); letter-spacing: -0.02em;">1,206,408</div>
                <div style="margin-top: 4px; font-size: 16px; color: var(--ink-soft);">Plaintext req/s</div>
            </a>
            <a href="https://www.techempower.com/benchmarks/#section=test&runid=1d5bfc8a-5c4a-4fb2-a792-ad967f1eb138&test=json" target="_blank" rel="noopener">
                <div class="lp-serif" style="font-weight: 600; font-size: clamp(36px, 4.4vw, 56px); letter-spacing: -0.02em;">834,109</div>
                <div style="margin-top: 4px; font-size: 16px; color: var(--ink-soft);">JSON req/s</div>
            </a>
        </div>
    </div>
</section>

<!-- SoliDB -->
<section class="lp-section">
    <div class="lp-wrap">
        <div style="display: flex; flex-direction: column; gap: 20px; max-width: 860px; margin-bottom: 48px;">
            <h2 class="lp-h2">Runs on SoliDB, or on the database you already have</h2>
            <p class="lp-lead">
                SoliDB is our own distributed, ACID-compliant database, also written in Rust. Documents, graph, vector search,
                time series, full-text and blobs all sit behind one ORM. The same models also run on
                <strong>PostgreSQL</strong>, <strong>MySQL</strong>, and <strong>SQLite</strong>, including straight onto the
                tables of a database you already have.
            </p>
        </div>

        <div style="display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 12px; margin-bottom: 24px;" class="lp-six">
            <div class="lp-mini"><strong>Documents</strong><span>JSON store</span></div>
            <div class="lp-mini"><strong>Graph</strong><span>Edges &amp; traversal</span></div>
            <div class="lp-mini"><strong>Vector</strong><span>HNSW search</span></div>
            <div class="lp-mini"><strong>Time series</strong><span>Metrics &amp; logs</span></div>
            <div class="lp-mini"><strong>Full-text</strong><span>Search engine</span></div>
            <div class="lp-mini"><strong>Blobs</strong><span>File storage</span></div>
        </div>

        <div class="lp-grid-3" style="margin-bottom: 32px;">
            <div class="lp-card">
                <h3 class="lp-h3" style="font-size: 20px;">SoliDB</h3>
                <p>The full surface: graph, vector, columnar, time series, raw SDBQL, live queries.</p>
            </div>
            <div class="lp-card">
                <h3 class="lp-h3" style="font-size: 20px;">Postgres, MySQL &amp; SQLite</h3>
                <p>Document tables with CRUD, filters, aggregates, eager loads, transactions, migrations, and background jobs. SQLite needs no server, just a file.</p>
            </div>
            <div class="lp-card">
                <h3 class="lp-h3" style="font-size: 20px;">Your existing schema</h3>
                <p>Declare <code>table "orders"</code> and models map to real columns, introspected at boot, no DDL ever issued.</p>
            </div>
        </div>

        <div class="lp-code">
            <div class="lp-code-bar"><span>app/models/user.sl</span></div>
<pre><code><span class="k">class</span> <span class="n">User &lt; Model</span>
  <span class="n">validates(</span><span class="s">"email"</span><span class="n">, { </span><span class="s">"presence"</span><span class="n">: true, </span><span class="s">"uniqueness"</span><span class="n">: true })</span>
  <span class="n">before_save(</span><span class="s">"normalize_email"</span><span class="n">)</span>

  <span class="k">def</span> <span class="n">normalize_email</span>
    <span class="v">@email</span> <span class="n">= </span><span class="v">@email</span><span class="n">.trim.downcase</span> <span class="k">unless</span> <span class="v">@email</span><span class="n">.blank?</span>
  <span class="k">end</span>
<span class="k">end</span>

<span class="c"># Chainable query builder: one query, same code on every adapter</span>
<span class="n">admins = User</span>
  <span class="n">.where({ </span><span class="s">"role"</span><span class="n">: </span><span class="s">"admin"</span><span class="n"> })</span>
  <span class="n">.order(</span><span class="s">"created_at"</span><span class="n">, </span><span class="s">"desc"</span><span class="n">)</span>
  <span class="n">.limit(20).all</span>

<span class="c"># Point a model at a database you already have</span>
<span class="k">class</span> <span class="n">Order &lt; Model</span>
  <span class="n">connection </span><span class="s">"legacy"</span>
  <span class="n">table </span><span class="s">"orders"</span>
<span class="k">end</span></code></pre>
        </div>

        <div style="display: flex; flex-wrap: wrap; gap: 28px; margin-top: 32px;">
            <a href="/docs/database/models" class="lp-link">Soli ORM docs &rarr;</a>
            <a href="/docs/database/multi-database" class="lp-link">Postgres, MySQL, SQLite &amp; multi-DB &rarr;</a>
            <a href="https://solidb.solisoft.net/docs" target="_blank" rel="noopener" class="lp-link">SoliDB documentation &nearr;</a>
        </div>
    </div>
</section>

<!-- Live view -->
<section id="live-view-demo" class="lp-section lp-night">
    <div class="lp-wrap">
        <div style="display: flex; flex-direction: column; gap: 20px; max-width: 800px; margin-bottom: 48px;">
            <div class="lp-eyebrow">LiveView</div>
            <h2 class="lp-h2">This counter is live, right now</h2>
            <p class="lp-lead">
                A reactive component rendered on the server and updated over a WebSocket. You write no JavaScript. The
                ~7&nbsp;KB (gzipped) client is served by the binary and loads only on pages that use it. Type in the field:
                every keystroke goes to the server, and the update lands without moving your focus or caret.
            </p>
        </div>

        <div class="lp-split" style="align-items: start;">
            <div>
                <div class="lp-code">
                    <div class="lp-code-bar"><span>Live demo &middot; /live/socket/counter</span></div>
                    <div style="padding: 32px;" id="live-counter-container" data-live-root data-liveview-manual data-liveview-url="/live/socket/counter">
                        <div style="text-align: center;">
                            <div style="margin-bottom: 24px; font-family: 'Fraunces', serif; font-weight: 700; font-size: 64px; line-height: 1;">...</div>
                            <p style="margin: 0; font-size: 14px; color: #A69C8C;">Connecting...</p>
                        </div>
                    </div>
                </div>
                <div style="display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; margin-top: 20px;">
                    <div class="lp-mini"><strong>0 JS</strong><span>Written</span></div>
                    <div class="lp-mini"><strong>Server</strong><span>State</span></div>
                    <div class="lp-mini"><strong>~7KB</strong><span>Client (gzipped)</span></div>
                </div>
            </div>

            <div>
                <div class="lp-code">
                    <div class="lp-code-bar"><span>app/views/live/counter.html.slv</span></div>
<pre><code><span class="c">&lt;!-- That's the whole component. --&gt;</span>
<span class="c">&lt;div</span> <span class="k">class=</span><span class="s">"counter"</span><span class="c">&gt;</span>
  <span class="c">&lt;h2&gt;</span><span class="v">&lt;%= count %&gt;</span><span class="c">&lt;/h2&gt;</span>
  <span class="c">&lt;button</span> <span class="k">soli-click=</span><span class="s">"decrement"</span><span class="c">&gt;</span>-<span class="c">&lt;/button&gt;</span>
  <span class="c">&lt;button</span> <span class="k">soli-click=</span><span class="s">"increment"</span><span class="c">&gt;</span>+<span class="c">&lt;/button&gt;</span>
<span class="c">&lt;/div&gt;</span></code></pre>
                </div>
                <p style="margin: 24px 0 0; font-size: 15px; line-height: 1.6; color: #C9BFAE;">
                    The server holds the state; the client morphs the DOM in place, so focus and widget state inside the region
                    survive every update. A second live demo, a server clock pushing 20 updates a second, runs in the
                    <a href="/docs/core-concepts/liveview" class="lp-link" style="display: inline;">LiveView docs</a>.
                </p>
            </div>
        </div>
    </div>
</section>

