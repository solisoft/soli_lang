<!-- SoliDB -->
<section class="lp-section">
    <div class="lp-wrap">
        <div style="display: flex; flex-direction: column; gap: 20px; max-width: 860px; margin-bottom: 48px;">
            <h2 class="lp-h2">Runs on SoliDB, or on the database you already have</h2>
            <p class="lp-lead">
                SoliDB is our own distributed, ACID-compliant database, also written in Rust. Documents, graph, vector search,
                time series, full-text and blobs all sit behind one ORM. The same models also run on
                <strong>PostgreSQL</strong>, <strong>MySQL</strong>, and <strong>SQLite</strong>, including straight onto the
                tables of a database you already have.
            </p>
        </div>

        <div style="display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 12px; margin-bottom: 24px;" class="lp-six">
            <div class="lp-mini"><strong>Documents</strong><span>JSON store</span></div>
            <div class="lp-mini"><strong>Graph</strong><span>Edges &amp; traversal</span></div>
            <div class="lp-mini"><strong>Vector</strong><span>HNSW search</span></div>
            <div class="lp-mini"><strong>Time series</strong><span>Metrics &amp; logs</span></div>
            <div class="lp-mini"><strong>Full-text</strong><span>Search engine</span></div>
            <div class="lp-mini"><strong>Blobs</strong><span>File storage</span></div>
        </div>

        <div class="lp-grid-3" style="margin-bottom: 32px;">
            <div class="lp-card">
                <h3 class="lp-h3" style="font-size: 20px;">SoliDB</h3>
                <p>The full surface: graph, vector, columnar, time series, raw SDBQL, live queries.</p>
            </div>
            <div class="lp-card">
                <h3 class="lp-h3" style="font-size: 20px;">Postgres, MySQL &amp; SQLite</h3>
                <p>Document tables with CRUD, filters, aggregates, eager loads, transactions, migrations, and background jobs. SQLite needs no server, just a file.</p>
            </div>
            <div class="lp-card">
                <h3 class="lp-h3" style="font-size: 20px;">Your existing schema</h3>
                <p>Declare <code>table "orders"</code> and models map to real columns, introspected at boot, no DDL ever issued.</p>
            </div>
        </div>

        <div class="lp-code">
            <div class="lp-code-bar"><span>app/models/user.sl</span></div>
<pre><code><span class="k">class</span> <span class="n">User &lt; Model</span>
  <span class="n">validates(</span><span class="s">"email"</span><span class="n">, { </span><span class="s">"presence"</span><span class="n">: true, </span><span class="s">"uniqueness"</span><span class="n">: true })</span>
  <span class="n">before_save(</span><span class="s">"normalize_email"</span><span class="n">)</span>

  <span class="k">def</span> <span class="n">normalize_email</span>
    <span class="v">@email</span> <span class="n">= </span><span class="v">@email</span><span class="n">.trim.downcase</span> <span class="k">unless</span> <span class="v">@email</span><span class="n">.blank?</span>
  <span class="k">end</span>
<span class="k">end</span>

<span class="c"># Chainable query builder: one query, same code on every adapter</span>
<span class="n">admins = User</span>
  <span class="n">.where({ </span><span class="s">"role"</span><span class="n">: </span><span class="s">"admin"</span><span class="n"> })</span>
  <span class="n">.order(</span><span class="s">"created_at"</span><span class="n">, </span><span class="s">"desc"</span><span class="n">)</span>
  <span class="n">.limit(20).all</span>

<span class="c"># Point a model at a database you already have</span>
<span class="k">class</span> <span class="n">Order &lt; Model</span>
  <span class="n">connection </span><span class="s">"legacy"</span>
  <span class="n">table </span><span class="s">"orders"</span>
<span class="k">end</span></code></pre>
        </div>

        <div style="display: flex; flex-wrap: wrap; gap: 28px; margin-top: 32px;">
            <a href="/docs/database/models" class="lp-link">Soli ORM docs &rarr;</a>
            <a href="/docs/database/multi-database" class="lp-link">Postgres, MySQL, SQLite &amp; multi-DB &rarr;</a>
            <a href="https://solidb.solisoft.net/docs" target="_blank" rel="noopener" class="lp-link">SoliDB documentation &nearr;</a>
        </div>
    </div>
</section>

<!-- Live view -->
<section id="live-view-demo" class="lp-section lp-night">
    <div class="lp-wrap">
        <div style="display: flex; flex-direction: column; gap: 20px; max-width: 800px; margin-bottom: 48px;">
            <div class="lp-eyebrow">LiveView</div>
            <h2 class="lp-h2">This counter is live, right now</h2>
            <p class="lp-lead">
                A reactive component rendered on the server and updated over a WebSocket. You write no JavaScript. The
                ~7&nbsp;KB (gzipped) client is served by the binary and loads only on pages that use it. Type in the field:
                every keystroke goes to the server, and the update lands without moving your focus or caret.
            </p>
        </div>

        <div class="lp-split" style="align-items: start;">
            <div>
                <div class="lp-code">
                    <div class="lp-code-bar"><span>Live demo &middot; /live/socket/counter</span></div>
                    <div style="padding: 32px;" id="live-counter-container" data-live-root data-liveview-manual data-liveview-url="/live/socket/counter">
                        <div style="text-align: center;">
                            <div style="margin-bottom: 24px; font-family: 'Fraunces', serif; font-weight: 700; font-size: 64px; line-height: 1;">...</div>
                            <p style="margin: 0; font-size: 14px; color: #A69C8C;">Connecting...</p>
                        </div>
                    </div>
                </div>
                <div style="display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; margin-top: 20px;">
                    <div class="lp-mini"><strong>0 JS</strong><span>Written</span></div>
                    <div class="lp-mini"><strong>Server</strong><span>State</span></div>
                    <div class="lp-mini"><strong>~7KB</strong><span>Client (gzipped)</span></div>
                </div>
            </div>

            <div>
                <div class="lp-code">
                    <div class="lp-code-bar"><span>app/views/live/counter.html.slv</span></div>
<pre><code><span class="c">&lt;!-- That's the whole component. --&gt;</span>
<span class="c">&lt;div</span> <span class="k">class=</span><span class="s">"counter"</span><span class="c">&gt;</span>
  <span class="c">&lt;h2&gt;</span><span class="v">&lt;%= count %&gt;</span><span class="c">&lt;/h2&gt;</span>
  <span class="c">&lt;button</span> <span class="k">soli-click=</span><span class="s">"decrement"</span><span class="c">&gt;</span>-<span class="c">&lt;/button&gt;</span>
  <span class="c">&lt;button</span> <span class="k">soli-click=</span><span class="s">"increment"</span><span class="c">&gt;</span>+<span class="c">&lt;/button&gt;</span>
<span class="c">&lt;/div&gt;</span></code></pre>
                </div>
                <p style="margin: 24px 0 0; font-size: 15px; line-height: 1.6; color: #C9BFAE;">
                    The server holds the state; the client morphs the DOM in place, so focus and widget state inside the region
                    survive every update. A second live demo, a server clock pushing 20 updates a second, runs in the
                    <a href="/docs/core-concepts/liveview" class="lp-link" style="display: inline;">LiveView docs</a>.
                </p>
            </div>
        </div>
    </div>
</section>

