<tr><td class="py-3 px-4"><code class="text-cyan-400">has_key</code></td><td class="py-3 px-4 text-right">1.174</td><td class="py-3 px-4 text-right">1.037</td><td class="py-3 px-4 text-right">1.006</td><td class="py-3 px-4 text-right">1.079</td><td class="py-3 px-4 text-right text-gray-400">1.17&times;</td></tr>
<tr><td class="py-3 px-4"><code class="text-cyan-400">set</code></td><td class="py-3 px-4 text-right">1.279</td><td class="py-3 px-4 text-right">1.086</td><td class="py-3 px-4 text-right">1.032</td><td class="py-3 px-4 text-right">1.048</td><td class="py-3 px-4 text-right text-gray-400">1.24&times;</td></tr>
