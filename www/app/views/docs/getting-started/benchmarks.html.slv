  res.type(&#x27;html&#x27;).send(layout({ title: &#x27;Posts&#x27;, body: list({ items: rows() }) })));</code></pre></div>
<div data-panel="laravel" class="hidden"><pre class="bg-black/40 border border-white/10 rounded-xl p-4 overflow-x-auto"><code class="language-php">public function templateOnly()
{
