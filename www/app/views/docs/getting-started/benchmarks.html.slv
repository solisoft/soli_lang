  Wpost.where(id: rand(1..WPOOL)).update_all(views: 42)
  head :ok
end</code></pre></div>
<div data-panel="express" class="hidden"><pre class="bg-black/40 border border-white/10 rounded-xl p-4 overflow-x-auto"><code class="language-javascript">app.patch(&#x27;/w&#x27;, async (req, res) =&gt; {
