<tr><td class="py-3 px-4">Rails + Puma</td><td class="py-3 px-4 text-right">14,944</td><td class="py-3 px-4 text-right">23.66 ms</td><td class="py-3 px-4 text-right">847 &micro;s</td><td class="py-3 px-4 text-right">1.0&times;</td></tr>
