<tr><td class="py-3 px-4">Laravel + php-fpm</td><td class="py-3 px-4 text-right">3,822</td><td class="py-3 px-4 text-right">83.93 ms</td><td class="py-3 px-4 text-right">3,378 &micro;s</td><td class="py-3 px-4 text-right">0.3&times;</td></tr>
