<tr><td class="py-3 px-4"><code class="text-cyan-400">uniq</code></td><td class="py-3 px-4 text-right">0.507</td><td class="py-3 px-4 text-right">0.347</td><td class="py-3 px-4 text-right">0.353</td><td class="py-3 px-4 text-right">0.338</td><td class="py-3 px-4 text-right text-gray-400">1.50&times;</td></tr>
