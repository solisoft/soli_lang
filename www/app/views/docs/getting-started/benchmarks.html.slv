<tr><td class="py-3 px-4">Django + gunicorn</td><td class="py-3 px-4 text-right">5,438</td><td class="py-3 px-4 text-right">44.85 ms</td><td class="py-3 px-4 text-right">2,545 &micro;s</td><td class="py-3 px-4 text-right">0.7&times;</td></tr>
<tr><td class="py-3 px-4">Laravel + php-fpm</td><td class="py-3 px-4 text-right">3,548</td><td class="py-3 px-4 text-right">63.55 ms</td><td class="py-3 px-4 text-right">3,822 &micro;s</td><td class="py-3 px-4 text-right">0.5&times;</td></tr>
