<tr><td class="py-3 px-4"><code class="text-cyan-400">select</code></td><td class="py-3 px-4 text-right">2.208</td><td class="py-3 px-4 text-right">0.849</td><td class="py-3 px-4 text-right">0.803</td><td class="py-3 px-4 text-right">0.551</td><td class="py-3 px-4 text-right text-gray-400">4.01&times;</td></tr>
