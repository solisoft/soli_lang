<tr><td class="py-3 px-4">Django + gunicorn</td><td class="py-3 px-4 text-right">11,215</td><td class="py-3 px-4 text-right">22.87 ms</td><td class="py-3 px-4 text-right">1,057 &micro;s</td><td class="py-3 px-4 text-right">1.4&times;</td></tr>
<tr class="text-gray-500"><td class="py-3 px-4">Laravel + Octane <span class="text-xs uppercase tracking-wide">reference</span></td><td class="py-3 px-4 text-right">8,102</td><td class="py-3 px-4 text-right">30.06 ms</td><td class="py-3 px-4 text-right">1,654 &micro;s</td><td class="py-3 px-4 text-right">1.0&times;</td></tr>
<tr><td class="py-3 px-4">Rails + Puma</td><td class="py-3 px-4 text-right">8,074</td><td class="py-3 px-4 text-right">42.29 ms</td><td class="py-3 px-4 text-right">1,497 &micro;s</td><td class="py-3 px-4 text-right">1.0&times;</td></tr>
<tr><td class="py-3 px-4">Laravel + php-fpm</td><td class="py-3 px-4 text-right">3,687</td><td class="py-3 px-4 text-right">61.22 ms</td><td class="py-3 px-4 text-right">3,760 &micro;s</td><td class="py-3 px-4 text-right">0.5&times;</td></tr>
</tbody></table></div></div>
<div data-panel="soli" class="hidden"><pre class="bg-black/40 border border-white/10 rounded-xl p-4 overflow-x-auto"><code class="language-soli">def w_create(req: Any) -&gt; Any {
  Wpost.create({ &quot;title&quot;: &quot;Post title 0&quot;, &quot;views&quot;: 7 })
  return { &quot;status&quot;: 201, &quot;body&quot;: &quot;ok&quot; }
}</code></pre></div>
<div data-panel="rails" class="hidden"><pre class="bg-black/40 border border-white/10 rounded-xl p-4 overflow-x-auto"><code class="language-ruby">def w_create
  Wpost.create!(title: &quot;Post title 0&quot;, views: 7)
  head :created
end</code></pre></div>
