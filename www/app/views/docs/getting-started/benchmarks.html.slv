<tr><td class="py-3 px-4"><code class="text-cyan-400">each</code></td><td class="py-3 px-4 text-right">1.112</td><td class="py-3 px-4 text-right">0.515</td><td class="py-3 px-4 text-right">0.466</td><td class="py-3 px-4 text-right">0.491</td><td class="py-3 px-4 text-right text-gray-400">2.39&times;</td></tr>
