<tr><td class="py-3 px-4"><code class="text-cyan-400">filter</code></td><td class="py-3 px-4 text-right">1.356</td><td class="py-3 px-4 text-right">0.674</td><td class="py-3 px-4 text-right">0.592</td><td class="py-3 px-4 text-right">0.621</td><td class="py-3 px-4 text-right text-gray-400">2.29&times;</td></tr>
