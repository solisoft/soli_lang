<tr><td class="py-3 px-4"><code class="text-cyan-400">upcase</code></td><td class="py-3 px-4 text-right">0.004</td><td class="py-3 px-4 text-right">0.030</td><td class="py-3 px-4 text-right">0.030</td><td class="py-3 px-4 text-right">0.030</td><td class="py-3 px-4 text-right text-emerald-400 font-semibold">0.15&times;</td></tr>
<tr><td class="py-3 px-4"><code class="text-cyan-400">contains</code></td><td class="py-3 px-4 text-right">0.003</td><td class="py-3 px-4 text-right">0.014</td><td class="py-3 px-4 text-right">0.014</td><td class="py-3 px-4 text-right">0.014</td><td class="py-3 px-4 text-right text-emerald-400 font-semibold">0.20&times;</td></tr>
<tr><td class="py-3 px-4"><code class="text-cyan-400">concat_plus</code></td><td class="py-3 px-4 text-right">1.365</td><td class="py-3 px-4 text-right">6.648</td><td class="py-3 px-4 text-right">6.576</td><td class="py-3 px-4 text-right">6.348</td><td class="py-3 px-4 text-right text-emerald-400 font-semibold">0.21&times;</td></tr>
<tr><td class="py-3 px-4"><code class="text-cyan-400">chars</code></td><td class="py-3 px-4 text-right">0.938</td><td class="py-3 px-4 text-right">3.179</td><td class="py-3 px-4 text-right">2.894</td><td class="py-3 px-4 text-right">3.152</td><td class="py-3 px-4 text-right text-emerald-400 font-semibold">0.32&times;</td></tr>
<tr><td class="py-3 px-4"><code class="text-cyan-400">bytes</code></td><td class="py-3 px-4 text-right">0.175</td><td class="py-3 px-4 text-right">0.460</td><td class="py-3 px-4 text-right">0.441</td><td class="py-3 px-4 text-right">0.443</td><td class="py-3 px-4 text-right text-emerald-400 font-semibold">0.40&times;</td></tr>
