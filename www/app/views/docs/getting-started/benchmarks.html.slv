<tr><td class="py-3 px-4"><code class="text-cyan-400">build</code></td><td class="py-3 px-4 text-right">1.136</td><td class="py-3 px-4 text-right">0.513</td><td class="py-3 px-4 text-right">0.511</td><td class="py-3 px-4 text-right">0.499</td><td class="py-3 px-4 text-right text-gray-400">2.28&times;</td></tr>
<tr><td class="py-3 px-4"><code class="text-cyan-400">filter</code></td><td class="py-3 px-4 text-right">1.370</td><td class="py-3 px-4 text-right">0.655</td><td class="py-3 px-4 text-right">0.595</td><td class="py-3 px-4 text-right">0.607</td><td class="py-3 px-4 text-right text-gray-400">2.30&times;</td></tr>
