<tr><td class="py-3 px-4"><code class="text-cyan-400">union</code></td><td class="py-3 px-4 text-right">0.686</td><td class="py-3 px-4 text-right">1.365</td><td class="py-3 px-4 text-right">1.389</td><td class="py-3 px-4 text-right">1.399</td><td class="py-3 px-4 text-right text-emerald-400 font-semibold">0.50&times;</td></tr>
<tr><td class="py-3 px-4"><code class="text-cyan-400">sum</code></td><td class="py-3 px-4 text-right">0.007</td><td class="py-3 px-4 text-right">0.013</td><td class="py-3 px-4 text-right">0.013</td><td class="py-3 px-4 text-right">0.013</td><td class="py-3 px-4 text-right text-emerald-400 font-semibold">0.59&times;</td></tr>
