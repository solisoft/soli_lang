<tr><td class="py-3 px-4"><code class="text-cyan-400">downcase</code></td><td class="py-3 px-4 text-right">0.003</td><td class="py-3 px-4 text-right">0.034</td><td class="py-3 px-4 text-right">0.034</td><td class="py-3 px-4 text-right">0.034</td><td class="py-3 px-4 text-right text-emerald-400 font-semibold">0.10&times;</td></tr>
<tr><td class="py-3 px-4"><code class="text-cyan-400">upcase</code></td><td class="py-3 px-4 text-right">0.004</td><td class="py-3 px-4 text-right">0.029</td><td class="py-3 px-4 text-right">0.029</td><td class="py-3 px-4 text-right">0.028</td><td class="py-3 px-4 text-right text-emerald-400 font-semibold">0.14&times;</td></tr>
<tr><td class="py-3 px-4"><code class="text-cyan-400">replace_all</code></td><td class="py-3 px-4 text-right">0.064</td><td class="py-3 px-4 text-right">0.466</td><td class="py-3 px-4 text-right">0.458</td><td class="py-3 px-4 text-right">0.457</td><td class="py-3 px-4 text-right text-emerald-400 font-semibold">0.14&times;</td></tr>
<tr><td class="py-3 px-4"><code class="text-cyan-400">contains</code></td><td class="py-3 px-4 text-right">0.003</td><td class="py-3 px-4 text-right">0.014</td><td class="py-3 px-4 text-right">0.013</td><td class="py-3 px-4 text-right">0.013</td><td class="py-3 px-4 text-right text-emerald-400 font-semibold">0.20&times;</td></tr>
<tr><td class="py-3 px-4"><code class="text-cyan-400">concat_plus</code></td><td class="py-3 px-4 text-right">1.323</td><td class="py-3 px-4 text-right">4.915</td><td class="py-3 px-4 text-right">5.148</td><td class="py-3 px-4 text-right">4.888</td><td class="py-3 px-4 text-right text-emerald-400 font-semibold">0.27&times;</td></tr>
