<tr class="bg-white/5"><td class="py-3 px-4 text-white font-bold">Soli</td><td class="py-3 px-4 text-right text-white">58,591</td><td class="py-3 px-4 text-right text-white">4.33 ms</td><td class="py-3 px-4 text-right text-white">155 &micro;s (206 incl. SoliDB)</td><td class="py-3 px-4 text-right text-white">7.0&times;</td></tr>
