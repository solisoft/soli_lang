<tr><td class="py-3 px-4"><code class="text-cyan-400">build</code></td><td class="py-3 px-4 text-right">1.119</td><td class="py-3 px-4 text-right">0.505</td><td class="py-3 px-4 text-right">0.512</td><td class="py-3 px-4 text-right">0.498</td><td class="py-3 px-4 text-right text-gray-400">2.25&times;</td></tr>
