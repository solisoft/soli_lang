<tr><td class="py-3 px-4"><code class="text-cyan-400">concat_plus</code></td><td class="py-3 px-4 text-right">1.358</td><td class="py-3 px-4 text-right">7.025</td><td class="py-3 px-4 text-right">5.955</td><td class="py-3 px-4 text-right">6.700</td><td class="py-3 px-4 text-right text-emerald-400 font-semibold">0.23&times;</td></tr>
