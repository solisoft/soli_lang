<tr><td class="py-3 px-4"><code class="text-cyan-400">each</code></td><td class="py-3 px-4 text-right">1.155</td><td class="py-3 px-4 text-right">0.544</td><td class="py-3 px-4 text-right">0.624</td><td class="py-3 px-4 text-right">0.511</td><td class="py-3 px-4 text-right text-gray-400">2.26&times;</td></tr>
