<tr><td class="py-3 px-4">FastAPI + SQLAlchemy + Jinja2</td><td class="py-3 px-4 text-right">88,455</td><td class="py-3 px-4 text-right">7.09 ms</td><td class="py-3 px-4 text-right">145 &micro;s</td><td class="py-3 px-4 text-right">5.9&times;</td></tr>
