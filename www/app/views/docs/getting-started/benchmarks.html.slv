<tr><td class="py-3 px-4"><code class="text-cyan-400">chars</code></td><td class="py-3 px-4 text-right">1.139</td><td class="py-3 px-4 text-right">2.895</td><td class="py-3 px-4 text-right">2.650</td><td class="py-3 px-4 text-right">2.750</td><td class="py-3 px-4 text-right text-emerald-400 font-semibold">0.43&times;</td></tr>
