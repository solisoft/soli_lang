<tr><td class="py-3 px-4"><code class="text-cyan-400">from_unix</code></td><td class="py-3 px-4 text-right">4.033</td><td class="py-3 px-4 text-right">0.712</td><td class="py-3 px-4 text-right">0.674</td><td class="py-3 px-4 text-right">0.724</td><td class="py-3 px-4 text-right text-gray-400">5.98&times;</td></tr>
