<tr><td class="py-3 px-4">FastAPI + SQLAlchemy + Jinja2</td><td class="py-3 px-4 text-right">11,662</td><td class="py-3 px-4 text-right">63.28 ms</td><td class="py-3 px-4 text-right">1,128 &micro;s</td><td class="py-3 px-4 text-right">1.3&times;</td></tr>
