<div data-panel="result"><div class="overflow-x-auto rounded-xl border border-white/10 bg-white/5 mb-6"><table class="w-full text-left text-sm"><thead class="bg-white/5 text-gray-300"><tr><th class="py-3 px-4">Stack</th><th class="py-3 px-4 text-right">req/s</th><th class="py-3 px-4 text-right">p99</th><th class="py-3 px-4 text-right">CPU/req</th><th class="py-3 px-4 text-right">vs Rails</th></tr></thead><tbody class="text-gray-400 divide-y divide-white/10">
<tr class="bg-white/5"><td class="py-3 px-4 text-white font-bold">Soli</td><td class="py-3 px-4 text-right text-white">31,693</td><td class="py-3 px-4 text-right text-white">8.73 ms</td><td class="py-3 px-4 text-right text-white">131 &micro;s (359 incl. SoliDB)</td><td class="py-3 px-4 text-right text-white">3.0&times;</td></tr>
<tr><td class="py-3 px-4">Express + EJS + Sequelize</td><td class="py-3 px-4 text-right">21,856</td><td class="py-3 px-4 text-right">18.50 ms</td><td class="py-3 px-4 text-right">503 &micro;s</td><td class="py-3 px-4 text-right">2.1&times;</td></tr>
<tr><td class="py-3 px-4">AdonisJS + Lucid + Edge</td><td class="py-3 px-4 text-right">14,940</td><td class="py-3 px-4 text-right">26.74 ms</td><td class="py-3 px-4 text-right">817 &micro;s</td><td class="py-3 px-4 text-right">1.4&times;</td></tr>
<tr><td class="py-3 px-4">Rails + Puma</td><td class="py-3 px-4 text-right">10,438</td><td class="py-3 px-4 text-right">42.26 ms</td><td class="py-3 px-4 text-right">1,173 &micro;s</td><td class="py-3 px-4 text-right">1.0&times;</td></tr>
<tr><td class="py-3 px-4">Django + gunicorn</td><td class="py-3 px-4 text-right">10,112</td><td class="py-3 px-4 text-right">24.93 ms</td><td class="py-3 px-4 text-right">1,168 &micro;s</td><td class="py-3 px-4 text-right">1.0&times;</td></tr>
<tr><td class="py-3 px-4">Laravel + php-fpm</td><td class="py-3 px-4 text-right">3,811</td><td class="py-3 px-4 text-right">60.21 ms</td><td class="py-3 px-4 text-right">3,570 &micro;s</td><td class="py-3 px-4 text-right">0.4&times;</td></tr>
<tr class="text-gray-500"><td class="py-3 px-4">Laravel + Octane <span class="text-xs uppercase tracking-wide">reference</span></td><td class="py-3 px-4 text-right">8,566</td><td class="py-3 px-4 text-right">28.57 ms</td><td class="py-3 px-4 text-right">1,545 &micro;s</td><td class="py-3 px-4 text-right">0.8&times;</td></tr>
</tbody></table></div></div>
<div data-panel="soli" class="hidden"><pre class="bg-black/40 border border-white/10 rounded-xl p-4 overflow-x-auto"><code class="language-soli"># Random key in 1..800000 — the same range in every stack.
def w_update(req: Any) -&gt; Any {
  Wpost.update(this.w_key(), { &quot;views&quot;: 42 })
  return { &quot;status&quot;: 200, &quot;body&quot;: &quot;ok&quot; }
}</code></pre></div>
<div data-panel="rails" class="hidden"><pre class="bg-black/40 border border-white/10 rounded-xl p-4 overflow-x-auto"><code class="language-ruby"># update_all is the ORM&#x27;s single-statement form, like Soli&#x27;s Model.update.
def w_update
  Wpost.where(id: rand(1..WPOOL)).update_all(views: 42)
  head :ok
end</code></pre></div>
<div data-panel="express" class="hidden"><pre class="bg-black/40 border border-white/10 rounded-xl p-4 overflow-x-auto"><code class="language-javascript">app.patch(&#x27;/w&#x27;, async (req, res) =&gt; {
  await WPost.update({ views: 42 }, { where: { id: wkey() } });
  res.sendStatus(200);
});</code></pre></div>
<div data-panel="adonis" class="hidden"><pre class="bg-black/40 border border-white/10 rounded-xl p-4 overflow-x-auto"><code class="language-typescript">async wUpdate({ response }: HttpContext) {
  const id = Math.floor(Math.random() * WPOOL) + 1
  await Wpost.query().where(&#x27;id&#x27;, id).update({ views: 42 })
  return response.status(200).send(&#x27;&#x27;)
}</code></pre></div>
<div data-panel="laravel" class="hidden"><pre class="bg-black/40 border border-white/10 rounded-xl p-4 overflow-x-auto"><code class="language-php">public function wUpdate()
{
    Wpost::where(&#x27;id&#x27;, random_int(1, self::WPOOL))-&gt;update([&#x27;views&#x27; =&gt; 42]);
    return response(&#x27;&#x27;, 200);
}</code></pre></div>
<div data-panel="django" class="hidden"><pre class="bg-black/40 border border-white/10 rounded-xl p-4 overflow-x-auto"><code class="language-python">if request.method == &quot;PATCH&quot;:
    Wpost.objects.filter(id=random.randint(1, WPOOL)).update(views=42)
    return HttpResponse(status=200)</code></pre></div>
</div>


<h3 class="text-xl font-semibold text-white mb-3">Delete &mdash; one row by primary key</h3>
<div class="mb-6" data-tabs>
<div class="flex flex-wrap gap-1 mb-3" role="tablist"><button type="button" data-tab="result" class="px-3 py-1.5 text-sm rounded-lg bg-white/10 text-white font-medium transition" aria-selected="true">Result</button><button type="button" data-tab="soli" class="px-3 py-1.5 text-sm rounded-lg text-gray-400 hover:text-white hover:bg-white/5 transition" aria-selected="false">Soli</button><button type="button" data-tab="rails" class="px-3 py-1.5 text-sm rounded-lg text-gray-400 hover:text-white hover:bg-white/5 transition" aria-selected="false">Rails</button><button type="button" data-tab="express" class="px-3 py-1.5 text-sm rounded-lg text-gray-400 hover:text-white hover:bg-white/5 transition" aria-selected="false">Express</button><button type="button" data-tab="adonis" class="px-3 py-1.5 text-sm rounded-lg text-gray-400 hover:text-white hover:bg-white/5 transition" aria-selected="false">AdonisJS</button><button type="button" data-tab="laravel" class="px-3 py-1.5 text-sm rounded-lg text-gray-400 hover:text-white hover:bg-white/5 transition" aria-selected="false">Laravel</button><button type="button" data-tab="django" class="px-3 py-1.5 text-sm rounded-lg text-gray-400 hover:text-white hover:bg-white/5 transition" aria-selected="false">Django</button></div>
<div data-panel="result"><div class="overflow-x-auto rounded-xl border border-white/10 bg-white/5 mb-4"><table class="w-full text-left text-sm"><thead class="bg-white/5 text-gray-300"><tr><th class="py-3 px-4">Stack</th><th class="py-3 px-4 text-right">req/s</th><th class="py-3 px-4 text-right">p99</th><th class="py-3 px-4 text-right">CPU/req</th><th class="py-3 px-4 text-right">rows removed</th><th class="py-3 px-4 text-right">vs Rails</th></tr></thead><tbody class="text-gray-400 divide-y divide-white/10">
<tr><td class="py-3 px-4">Express + EJS + Sequelize</td><td class="py-3 px-4 text-right">30,910</td><td class="py-3 px-4 text-right">16.40 ms</td><td class="py-3 px-4 text-right">324 &micro;s</td><td class="py-3 px-4 text-right">2.9&times;</td><td class="py-3 px-4 text-right">59% of requests</td></tr>
<tr class="bg-white/5"><td class="py-3 px-4 text-white font-bold">Soli</td><td class="py-3 px-4 text-right text-white">29,588</td><td class="py-3 px-4 text-right text-white">8.99 ms</td><td class="py-3 px-4 text-right text-white">150 &micro;s (399 incl. SoliDB)</td><td class="py-3 px-4 text-right text-white">2.7&times;</td><td class="py-3 px-4 text-right text-white">60% of requests</td></tr>
<tr><td class="py-3 px-4">AdonisJS + Lucid + Edge</td><td class="py-3 px-4 text-right">14,994</td><td class="py-3 px-4 text-right">27.11 ms</td><td class="py-3 px-4 text-right">832 &micro;s</td><td class="py-3 px-4 text-right">1.4&times;</td><td class="py-3 px-4 text-right">77% of requests</td></tr>
<tr><td class="py-3 px-4">Rails + Puma</td><td class="py-3 px-4 text-right">10,837</td><td class="py-3 px-4 text-right">35.40 ms</td><td class="py-3 px-4 text-right">1,151 &micro;s</td><td class="py-3 px-4 text-right">1.0&times;</td><td class="py-3 px-4 text-right">82% of requests</td></tr>
<tr><td class="py-3 px-4">Django + gunicorn</td><td class="py-3 px-4 text-right">8,843</td><td class="py-3 px-4 text-right">28.81 ms</td><td class="py-3 px-4 text-right">1,316 &micro;s</td><td class="py-3 px-4 text-right">0.8&times;</td><td class="py-3 px-4 text-right">85% of requests</td></tr>
<tr><td class="py-3 px-4">Laravel + php-fpm</td><td class="py-3 px-4 text-right">3,869</td><td class="py-3 px-4 text-right">59.10 ms</td><td class="py-3 px-4 text-right">3,534 &micro;s</td><td class="py-3 px-4 text-right">0.4&times;</td><td class="py-3 px-4 text-right">93% of requests</td></tr>
