<tr><td class="py-3 px-4"><code class="text-cyan-400">index_of</code></td><td class="py-3 px-4 text-right">0.038</td><td class="py-3 px-4 text-right">0.051</td><td class="py-3 px-4 text-right">0.050</td><td class="py-3 px-4 text-right">0.050</td><td class="py-3 px-4 text-right text-emerald-400 font-semibold">0.75&times;</td></tr>
<tr><td class="py-3 px-4"><code class="text-cyan-400">sort</code></td><td class="py-3 px-4 text-right">1.106</td><td class="py-3 px-4 text-right">1.331</td><td class="py-3 px-4 text-right">1.312</td><td class="py-3 px-4 text-right">1.308</td><td class="py-3 px-4 text-right text-emerald-400 font-semibold">0.85&times;</td></tr>
<tr><td class="py-3 px-4"><code class="text-cyan-400">reverse</code></td><td class="py-3 px-4 text-right">0.069</td><td class="py-3 px-4 text-right">0.059</td><td class="py-3 px-4 text-right">0.056</td><td class="py-3 px-4 text-right">0.059</td><td class="py-3 px-4 text-right text-gray-400">1.22&times;</td></tr>
<tr><td class="py-3 px-4"><code class="text-cyan-400">intersection</code></td><td class="py-3 px-4 text-right">1.148</td><td class="py-3 px-4 text-right">0.824</td><td class="py-3 px-4 text-right">0.821</td><td class="py-3 px-4 text-right">0.851</td><td class="py-3 px-4 text-right text-gray-400">1.40&times;</td></tr>
<tr><td class="py-3 px-4"><code class="text-cyan-400">uniq</code></td><td class="py-3 px-4 text-right">0.498</td><td class="py-3 px-4 text-right">0.357</td><td class="py-3 px-4 text-right">0.336</td><td class="py-3 px-4 text-right">0.343</td><td class="py-3 px-4 text-right text-gray-400">1.48&times;</td></tr>
<tr><td class="py-3 px-4"><code class="text-cyan-400">reduce</code></td><td class="py-3 px-4 text-right">1.079</td><td class="py-3 px-4 text-right">0.762</td><td class="py-3 px-4 text-right">0.784</td><td class="py-3 px-4 text-right">0.682</td><td class="py-3 px-4 text-right text-gray-400">1.58&times;</td></tr>
