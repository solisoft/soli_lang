<tr><td class="py-3 px-4"><code class="text-cyan-400">join</code></td><td class="py-3 px-4 text-right">0.179</td><td class="py-3 px-4 text-right">0.434</td><td class="py-3 px-4 text-right">0.433</td><td class="py-3 px-4 text-right">0.354</td><td class="py-3 px-4 text-right text-emerald-400 font-semibold">0.51&times;</td></tr>
<tr><td class="py-3 px-4"><code class="text-cyan-400">union</code></td><td class="py-3 px-4 text-right">0.680</td><td class="py-3 px-4 text-right">1.493</td><td class="py-3 px-4 text-right">1.413</td><td class="py-3 px-4 text-right">1.423</td><td class="py-3 px-4 text-right text-emerald-400 font-semibold">0.48&times;</td></tr>
<tr><td class="py-3 px-4"><code class="text-cyan-400">sum</code></td><td class="py-3 px-4 text-right">0.005</td><td class="py-3 px-4 text-right">0.013</td><td class="py-3 px-4 text-right">0.013</td><td class="py-3 px-4 text-right">0.013</td><td class="py-3 px-4 text-right text-emerald-400 font-semibold">0.39&times;</td></tr>
<tr><td class="py-3 px-4"><code class="text-cyan-400">index_of</code></td><td class="py-3 px-4 text-right">0.037</td><td class="py-3 px-4 text-right">0.050</td><td class="py-3 px-4 text-right">0.050</td><td class="py-3 px-4 text-right">0.050</td><td class="py-3 px-4 text-right text-emerald-400 font-semibold">0.75&times;</td></tr>
<tr><td class="py-3 px-4"><code class="text-cyan-400">includes</code></td><td class="py-3 px-4 text-right">0.047</td><td class="py-3 px-4 text-right">0.052</td><td class="py-3 px-4 text-right">0.052</td><td class="py-3 px-4 text-right">0.051</td><td class="py-3 px-4 text-right text-emerald-400 font-semibold">0.92&times;</td></tr>
<tr><td class="py-3 px-4"><code class="text-cyan-400">sort</code></td><td class="py-3 px-4 text-right">1.129</td><td class="py-3 px-4 text-right">1.346</td><td class="py-3 px-4 text-right">1.348</td><td class="py-3 px-4 text-right">1.331</td><td class="py-3 px-4 text-right text-emerald-400 font-semibold">0.85&times;</td></tr>
<tr><td class="py-3 px-4"><code class="text-cyan-400">intersection</code></td><td class="py-3 px-4 text-right">1.142</td><td class="py-3 px-4 text-right">0.857</td><td class="py-3 px-4 text-right">0.860</td><td class="py-3 px-4 text-right">0.875</td><td class="py-3 px-4 text-right text-gray-400">1.33&times;</td></tr>
<tr><td class="py-3 px-4"><code class="text-cyan-400">reverse</code></td><td class="py-3 px-4 text-right">0.080</td><td class="py-3 px-4 text-right">0.056</td><td class="py-3 px-4 text-right">0.063</td><td class="py-3 px-4 text-right">0.057</td><td class="py-3 px-4 text-right text-gray-400">1.44&times;</td></tr>
<tr><td class="py-3 px-4"><code class="text-cyan-400">uniq</code></td><td class="py-3 px-4 text-right">0.497</td><td class="py-3 px-4 text-right">0.345</td><td class="py-3 px-4 text-right">0.351</td><td class="py-3 px-4 text-right">0.354</td><td class="py-3 px-4 text-right text-gray-400">1.44&times;</td></tr>
