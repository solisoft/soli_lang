<tr class="bg-white/5"><td class="py-3 px-4 text-white font-bold">Soli</td><td class="py-3 px-4 text-right text-white">38,616</td><td class="py-3 px-4 text-right text-white">6.53 ms</td><td class="py-3 px-4 text-right text-white">187 &micro;s (304 incl. SoliDB)</td><td class="py-3 px-4 text-right text-white">4.9&times;</td></tr>
