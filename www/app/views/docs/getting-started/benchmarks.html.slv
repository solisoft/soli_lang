<tr><td class="py-3 px-4"><code class="text-cyan-400">build</code></td><td class="py-3 px-4 text-right">1.037</td><td class="py-3 px-4 text-right">0.502</td><td class="py-3 px-4 text-right">0.471</td><td class="py-3 px-4 text-right">0.509</td><td class="py-3 px-4 text-right text-gray-400">2.20&times;</td></tr>
