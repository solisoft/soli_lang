                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
            </svg>
            Session Functions
        </a>
        <a href="/docs/builtins/testing" class="flex items-center gap-2 text-amber-400 hover:text-amber-300 transition-colors">
