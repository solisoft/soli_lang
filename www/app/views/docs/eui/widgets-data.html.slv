<div class="p-4 bg-[#171412] overflow-x-auto">
<pre><code class="language-soli text-sm">says = "dv_" + id + ".text = " + chart_quoted(reading) + "; dl_" + id + ".text = " + chart_quoted(label)</code></pre>
