<% content_for "head" do %>
  <meta property="og:type" content="article">
  <meta property="og:site_name" content="Soli">
  <meta property="og:title" content="<%= title %>">
  <meta property="og:description" content="<%= og_description %>">
  <meta property="og:url" content="https://soli.solisoft.net/docs/blog/<%= slug %>">
  <link rel="canonical" href="https://soli.solisoft.net/docs/blog/<%= slug %>">
  <% if published_on %>
  <meta property="article:published_time" content="<%= published_on %>">
  <% end %>
  <meta name="twitter:title" content="<%= title %>">
  <meta name="twitter:description" content="<%= og_description %>">
  <% if og_image %>
  <meta property="og:image" content="<%= og_image %>">
  <meta property="og:image:alt" content="<%= title %>">
  <% if og_image_size %>
  <meta property="og:image:type" content="image/png">
  <meta property="og:image:width" content="<%= og_image_size["width"] %>">
  <meta property="og:image:height" content="<%= og_image_size["height"] %>">
  <% end %>
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:image" content="<%= og_image %>">
  <meta name="twitter:image:alt" content="<%= title %>">
  <% end %>
  <% if slug == "liveview-desk" %>
  <%- csrf_meta_tag() %>
  <% end %>
  <% if slug == "pocket-garden-eui" %>
  <style>
    /* The playable Pocket Garden (eui-embed.js drives the classes). Square,
       like the 760 x 760 render the poster is, and never taller than the
       window: the game scrolls its own beds. */
    .pg-play { margin: 2rem 0 2.5rem; }
    .pg-play .demo__stage { position: relative; width: 100%; aspect-ratio: 1 / 1; max-height: 85vh; overflow: hidden; border: 1px solid #30363d; border-radius: 12px; background: #0b0d0f; }
    .pg-play .demo__poster, .pg-play .demo__canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
    .pg-play .demo__poster { object-fit: contain; }
    /* The client writes its own px size inline, a fraction off the box. */
    .pg-play .demo__canvas { width: 100% !important; height: 100% !important; transition: opacity 0.18s ease; outline: none; }
    .pg-play .demo__run { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); display: inline-flex; align-items: baseline; gap: 0.6rem; padding: 0.8rem 1.4rem; border-radius: 999px; border: 0; background: #6366f1; color: #fff; font-weight: 600; font-size: 1.05rem; cursor: pointer; box-shadow: 0 10px 30px rgba(0, 0, 0, 0.45); }
    .pg-play .demo__run:hover { background: #4f46e5; }
    .pg-play .demo__run:focus-visible { outline: 2px solid #fbbf24; outline-offset: 3px; }
    .pg-play .demo__run:disabled { opacity: 0.7; cursor: progress; }
    .pg-play .demo__run small { font-weight: 400; font-size: 0.8rem; opacity: 0.85; }
    .pg-play .demo__note { position: absolute; left: 1rem; right: 1rem; bottom: 1rem; margin: 0; padding: 0.6rem 0.9rem; border-radius: 8px; background: rgba(11, 13, 15, 0.88); color: #d1d5db; font-size: 0.875rem; text-align: center; }
    .pg-play figcaption { text-align: center; color: #8b949e; font-size: 0.875rem; margin-top: 0.6rem; }
  </style>
  <% end %>
<% end %>

<div>
    <div class="mb-8">
        <a href="/docs/blog" class="inline-flex items-center gap-2 text-amber-400 hover:text-amber-300 mb-4">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
            </svg>
            Back to Blog
        </a>
    </div>

    <% if scheduled_on %>
    <p class="mb-6 px-4 py-3 rounded-lg border border-rose-500/30 bg-rose-500/10 text-rose-200 text-sm">Preview &mdash; scheduled for <%= scheduled_on %>. Visible on a local host only.</p>
    <% end %>
    <div class="prose prose-invert prose-lg max-w-none">
        <%- content %>
    </div>
</div>

<% if slug == "pocket-garden-eui" and eui_build != "none" %>
<%# The EUI browser client's bootstrap: five kilobytes that fetch nothing until
    Play is pressed. The version is the manifest's, so a new client is never
    hidden behind the module's year-long cache. %>
<script type="module" src="<%= "/eui/eui-embed.js?v=" + eui_build %>"></script>
<% end %>

<% if slug == "liveview-desk" %>
<script>
(function () {
    function startDesk() {
        const root = document.getElementById('desk-widget');
        if (!root || root.dataset.lvConnected) return;
        root.dataset.lvConnected = '1';

        const hooks = {
            Spark: {
                mounted() { this.paint(); },
                updated() { this.paint(); },
                paint() {
                    const raw = this.el.getAttribute('data-series') || '[]';
                    let series = [];
                    try { series = JSON.parse(raw); } catch (e) { series = []; }
                    this.el.innerHTML = series.map(function (n) {
                        const h = 4 + Number(n || 0);
                        return '<span style="display:block;width:3px;height:' + h + 'px;border-radius:1px;background:#f59e0b;opacity:.85;"></span>';
                    }).join('');
                }
            }
        };
        if (window.SoliLiveView) window.SoliLiveView.hooks = Object.assign({}, window.SoliLiveView.hooks || {}, hooks);

        let url = root.getAttribute('data-liveview-url');
        if (url && url.charAt(0) === '/') {
            const protocol = location.protocol === 'https:' ? 'wss:' : 'ws:';
            url = protocol + '//' + location.host + url;
        }
        window.live(url, { rootElement: root, hooks: hooks });
    }

    if (window.live) {
        startDesk();
        return;
    }
    let loader = document.getElementById('__livejs-loader');
    if (!loader) {
        loader = document.createElement('script');
        loader.id = '__livejs-loader';
        loader.src = '/live/client.js?v=desk-room';
        document.head.appendChild(loader);
    }
    loader.addEventListener('load', startDesk, { once: true });
})();
</script>
<% end %>