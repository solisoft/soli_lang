{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "soli",
      "camelcase": "Soli",
      "scope": "source.soli",
      "path": ".",
      "file-types": ["sl", "Solifile"],
      "highlights": "queries/highlights.scm",
      "injection-regex": "^soli$"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Soli grammar for tree-sitter",
    "links": {
      "repository": "https://github.com/solisoft/soli_lang"
    }
  },
  "bindings": {
    "c": false, "go": false, "node": false, "python": false, "rust": false, "swift": false
  }
}
